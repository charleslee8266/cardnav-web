---
/*
文件说明: 定义 CardNav 公开站点 Astro 页面骨架，统一 SEO、导航、赞助区和页脚。
*/
import { telemetryBlocks } from '../telemetry-blocks.js';
import '../public.css';
import ShopSubmitDialog from '../components/ShopSubmitDialog.astro';
import GatewaySubmitDialog from '../components/GatewaySubmitDialog.astro';
import SupportDialog from '../components/SupportDialog.astro';
import Sponsors from '../components/Sponsors.astro';
import Icon from '../components/Icon.astro';
import announcements from '../data/announcements.json';
import announcementInit from '../scripts/announcement-init.js?raw';
const orderedAnnouncements = [...announcements].sort((a, b) => b.priority - a.priority);
const announcementState = orderedAnnouncements.map(({ id, repeatAfterHours }) => ({ id, repeatAfterHours }));
import { getLocaleHtmlLang, localeLabels, supportedLocales, type Locale } from '../i18n/config.js';
import { switchLocalePath } from '../i18n/paths.js';
import publicTelemetryScriptUrl from '../scripts/public-telemetry.js?url';
import merchantBadgeScriptUrl from '../scripts/merchant-badge.js?url';
import publicShellScriptUrl from '../scripts/public-shell.js?url';
import rowNavigationScriptUrl from '../scripts/row-navigation.js?url';
import { githubRepoUrl, headerAdTagEnabled, telegramGroupUrl, xProfileUrl } from '../site.js';
import type { PageType } from '../page-types.js';

type Props = {
  activeNav?: string;
  pageTitle: string;
  description: string;
  canonicalUrl: string;
  robots: string;
  ogUrl: string;
  ogImageUrl: string;
  ogImageAlt: string;
  ogImageWidth: number;
  ogImageHeight: number;
  ogSiteName: string;
  ogLocale: string;
  ogLocaleAlternates: string[];
  ogType: string;
  jsonLd: Record<string, unknown>;
  htmlLang?: string;
  alternateUrls?: { locale: Locale; hreflang: string; url: string }[];
  xDefaultUrl?: string;
  pageType: PageType;
};

const {
  activeNav = '',
  pageTitle,
  description,
  canonicalUrl,
  robots,
  ogUrl,
  ogImageUrl,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  ogSiteName,
  ogLocale,
  ogLocaleAlternates = [],
  ogType,
  jsonLd,
  htmlLang = getLocaleHtmlLang(Astro.locals.locale),
  alternateUrls = [],
  xDefaultUrl,
  pageType,
} = Astro.props;

const t = Astro.locals.messages;
const submitItems = [
  { href: '?dialog=shop-submit', title: t.shops.submitMerchant, description: t.submit.shopMenuDescription, icon: 'store' },
  { href: '?dialog=gateway-submit', title: t.llmGateway.submitGateway, description: t.submit.gatewayMenuDescription, icon: 'server' },
] as const;
const locale: Locale = Astro.locals.locale;
const linkTo = Astro.locals.localizePath;
const isGuidePage = activeNav === 'guide';
const primaryNavItems = [
  { key: 'home', href: '/', label: t.nav.home },
  { key: 'llm-gateway', href: '/llm-gateway', label: t.nav.llmGateway },
  { key: 'shops', href: '/market', label: t.nav.shops },
  { key: 'official-price', href: '/official-price', label: t.nav.officialPrice },
  { key: 'model-leaderboard', href: '/model-leaderboard', label: t.nav.modelLeaderboard },
  { key: 'guide', href: '/guide', label: t.nav.guide },
  { key: 'tools', href: '/tools', label: t.nav.tools },

];
const secondaryNavItems = [
  { key: 'supporters', href: '/supporters', label: t.support.listTitle },
  { key: 'partnership', href: '/partnership', label: t.nav.partnership },
];
const footerLinks = [
  { href: '/about', label: t.nav.about },
  { href: '/disclaimer', label: t.nav.disclaimer },
  { href: '/privacy', label: t.nav.privacy },
];
const languageItems = supportedLocales.map(itemLocale => ({
  locale: itemLocale,
  label: localeLabels[itemLocale].nativeLabel,
  flag: localeLabels[itemLocale].flag,
  href: switchLocalePath(Astro.locals.originalPathname, itemLocale),
  isCurrent: itemLocale === Astro.locals.locale,
  isAvailable: true,
}));

function navClickAttrs(targetPage: string, name: string) {
  return {
    'data-umami-event': 'internal-link-click',
    'data-umami-event-link-type': 'nav',
    'data-umami-event-target-page': targetPage,
    'data-umami-event-name': name,
    'data-umami-event-url': targetPage,
  };
}

function siteLinkClickAttrs(url: string, name: string) {
  return {
    'data-umami-event': 'external-link-click',
    'data-umami-event-link-type': 'site',
    'data-umami-event-name': name,
    'data-umami-event-url': url,
  };
}

---

<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <script is:inline>
    (() => {
      const url = new URL(window.location.href);
      const token = url.searchParams.get('support-order');
      if (!token) return;
      window.cardnavSupportStatusToken = token;
      url.searchParams.delete('support-order');
      window.history.replaceState(window.history.state, '', url);
    })();
  </script>
  <script is:inline>
    (function () {
      let savedTheme;
      try { savedTheme = localStorage.getItem('theme'); } catch { /* Use the system theme if storage is unavailable. */ }
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : (systemPrefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.style.colorScheme = theme;
    })();
  </script>
  <script is:inline data-announcements={JSON.stringify(announcementState)} set:html={announcementInit} />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="icon" type="image/webp" href="/favicon.webp" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="preconnect" href="https://stats.cardnav.xyz" crossorigin />
  {alternateUrls.map(item => <link rel="alternate" hreflang={item.hreflang} href={item.url} />)}
  {xDefaultUrl && <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />}
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:site_name" content={ogSiteName} />
  <meta property="og:locale" content={ogLocale} />
  {ogLocaleAlternates.map(locale => <meta property="og:locale:alternate" content={locale} />)}
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content={String(ogImageWidth)} />
  <meta property="og:image:height" content={String(ogImageHeight)} />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={ogImageAlt} />
  <title>{pageTitle}</title>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <slot name="head" />
  {headerAdTagEnabled && (
    <>
      <script is:inline src="https://5gvci.com/act/files/tag.min.js?z=11107777" data-cfasync="false" async></script>
      <meta data-header-ad-loader data-zone="11113650" data-src="https://nap5k.com/tag.min.js" />
    </>
  )}
</head>
<body data-list-loading={t.labels.loading} data-list-load-error={t.labels.loadError} data-telemetry-block={telemetryBlocks.shared.page} data-source-page-type={pageType} class:list={[
  'public-body antialiased',
  'min-h-screen',
]}>
{orderedAnnouncements.map((announcement, index) => {
  const external = !announcement.href.startsWith('/');
  const href = external ? announcement.href : linkTo(announcement.href);
  return (
    <div data-announcement-id={announcement.id} data-telemetry-block={telemetryBlocks.shared.announcement} class="public-announcement" style={`display:var(--announcement-${index}-display,${index === 0 ? "block" : "none"})`}>
      <div class="public-announcement-inner">
        <div class="public-announcement-copy">
          <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} class="public-announcement-label" {...(external ? siteLinkClickAttrs(href, `Announcement ${announcement.id}`) : navClickAttrs(href, `Announcement ${announcement.id}`))}>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-4 w-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 11 18-5v12L3 13v-2Z"></path>
              <path d="M11.6 15.2 13 21H9l-1.8-6.7"></path>
            </svg>
            {t.announcement.label}
          </a>
          <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} title={announcement.message[locale]} class="public-announcement-message" {...(external ? siteLinkClickAttrs(href, `Announcement ${announcement.id}`) : navClickAttrs(href, `Announcement ${announcement.id}`))}>
            {announcement.message[locale]}
          </a>
        </div>
        <button type="button" data-dismiss-announcement class="public-announcement-close" aria-label={t.announcement.close} title={t.announcement.close}>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-4 w-4" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M6 6l12 12"></path>
            <path d="M18 6 6 18"></path>
          </svg>
        </button>
      </div>
    </div>
  );
})}
<a class="skip-link" href="#main-content">{t.nav.skipToContent}</a>
<header data-telemetry-block={telemetryBlocks.shared.header} class="site-header">
  <div class="site-header-inner">
    <button type="button" class="shell-icon-button mobile-menu-toggle" data-open-navigation aria-label={t.nav.openMenu} aria-controls="site-navigation-dialog" aria-expanded="false"><Icon name="menu" /></button>
    <a href={linkTo('/')} class="site-brand" aria-label={t.actions.backHome} {...navClickAttrs(linkTo('/'), 'Header Logo')}>
      <img src="/favicon.webp" alt="" width="30" height="30" />
      <span><b>{t.site.name}</b><small>CardNav</small></span>
    </a>
    <nav class="site-primary-nav" aria-label={t.home.quickNavTitle}>
      {primaryNavItems.map(item => <a href={linkTo(item.href)} aria-current={activeNav === item.key ? 'page' : undefined} {...navClickAttrs(linkTo(item.href), item.label)}>{item.label}</a>)}
    </nav>
    <div class="site-header-tools">
      <details class="shell-menu shell-submit-menu">
        <summary class="shell-text-button shell-submit-button"><Icon name="plus" />{t.actions.submit}<Icon name="down" /></summary>
<div class="shell-menu-panel shell-submit-options">{submitItems.map(item => <a href={item.href} {...navClickAttrs(item.href, item.title)}><Icon name={item.icon} /><span><b>{item.title}</b><small>{item.description}</small></span></a>)}</div>
      </details>
      <a class="shell-support-link" href={linkTo('/supporters')} {...navClickAttrs(linkTo('/supporters'), t.support.listTitle)}><Icon name="heart" />{t.support.badgeLabel}</a>
      <a class="shell-partnership-link" href={linkTo('/partnership')} {...navClickAttrs(linkTo('/partnership'), t.nav.partnership)}><Icon name="handshake" />{t.nav.partnership}</a>
      <details class="shell-menu" data-language-menu>
        <summary class="shell-icon-button" aria-label={t.language.switchLanguage}><Icon name="globe" /></summary>
        <div class="shell-menu-panel">
          {languageItems.map(item => <a href={item.href} aria-current={item.isCurrent ? 'true' : undefined}><span>{item.flag}</span>{item.label}</a>)}
        </div>
      </details>
      <button id="themeToggle" type="button" class="shell-icon-button" aria-label={t.theme.toggle} title={t.theme.toggle}>
        <span id="themeMoonIcon"><Icon name="moon" /></span><span id="themeSunIcon" class="hidden"><Icon name="sun" /></span>
      </button>
      <a class="shell-icon-button shell-social" href={telegramGroupUrl} target="_blank" rel="noopener noreferrer" aria-label={t.external.telegramGroup} {...siteLinkClickAttrs(telegramGroupUrl, 'Header Telegram')}><Icon name="send" /></a>
      <a class="shell-icon-button shell-social" href={githubRepoUrl} target="_blank" rel="noopener noreferrer" aria-label={t.external.githubRepo} {...siteLinkClickAttrs(githubRepoUrl, 'Header GitHub')}><Icon name="github" /></a>
    </div>
  </div>
  <nav class="site-mobile-commerce" aria-label={t.nav.partnership}>
    <details class="shell-menu">
      <summary class="shell-text-button shell-submit-button"><Icon name="plus" />{t.actions.submit}</summary>
      <div class="shell-menu-panel shell-submit-options">{submitItems.map(item => <a href={item.href} {...navClickAttrs(item.href, item.title)}><Icon name={item.icon} /><span><b>{item.title}</b><small>{item.description}</small></span></a>)}</div>
    </details>
    <a class="shell-support-link" href={linkTo('/supporters')} {...navClickAttrs(linkTo('/supporters'), t.support.listTitle)}><Icon name="heart" />{t.support.badgeLabel}</a>
    <a class="shell-partnership-link" href={linkTo('/partnership')} {...navClickAttrs(linkTo('/partnership'), t.nav.partnership)}><Icon name="handshake" />{t.nav.partnership}</a>
  </nav>
</header>
<dialog autofocus id="site-navigation-dialog" class="site-navigation-dialog" aria-label={t.nav.openMenu}>
  <div class="drawer-heading"><b>{t.site.name}</b><button type="button" class="shell-icon-button" data-close-navigation aria-label={t.nav.closeMenu}><Icon name="close" /></button></div>
  <nav aria-label={t.home.quickNavTitle}>
    {[...primaryNavItems, ...secondaryNavItems].map(item => <a href={linkTo(item.href)} aria-current={activeNav === item.key ? 'page' : undefined} {...navClickAttrs(linkTo(item.href), item.label)}>{item.label}<Icon name="right" /></a>)}
  </nav>
  <div class="drawer-links">
    <a href="?dialog=shop-submit">{t.shops.submitMerchant}</a>
    <a href="?dialog=gateway-submit">{t.llmGateway.submitGateway}</a>
    <a href={linkTo('/supporters')}>{t.support.listTitle}</a>
    <a href={telegramGroupUrl} target="_blank" rel="noopener noreferrer" {...siteLinkClickAttrs(telegramGroupUrl, 'Drawer Telegram')}>Telegram</a>
    <a href={githubRepoUrl} target="_blank" rel="noopener noreferrer" {...siteLinkClickAttrs(githubRepoUrl, 'Drawer GitHub')}>GitHub</a>
    <a href={xProfileUrl} target="_blank" rel="noopener noreferrer" {...siteLinkClickAttrs(xProfileUrl, 'Drawer X')}>{t.external.xProfile}</a>
  </div>
</dialog>
<main id="main-content" class:list={['public-main site-wide-width', isGuidePage && 'public-main-guide']}>
  <slot />
  {!isGuidePage && <Sponsors placement="page-bottom" pageType={pageType} />}
</main>

  <footer data-telemetry-block={telemetryBlocks.shared.footer} class="site-footer">
    <div class="site-footer-inner">
      <div class="footer-brand"><a class="footer-brand-link" href={linkTo('/')}><img src="/favicon.webp" alt="" width="30" height="30" /><span><b>{t.site.name}</b><small>CardNav</small></span></a><p>{t.site.tagline}</p></div>
      <nav class="footer-link-column" aria-label={t.nav.footerResources}>
        <h2>{t.nav.footerResources}</h2>
        {primaryNavItems.filter(item => !['home', 'guide', 'tools'].includes(item.key)).map(item => <a href={linkTo(item.href)}>{item.label}</a>)}
      </nav>
      <nav class="footer-link-column" aria-label={t.nav.footerHelp}>
        <h2>{t.nav.footerHelp}</h2>
        <a href={linkTo('/guide')}>{t.nav.guide}</a>
        <a href={linkTo('/tools')}>{t.nav.tools}</a>
        {secondaryNavItems.map(item => <a href={linkTo(item.href)}>{item.label}</a>)}
      </nav>
      <nav class="footer-link-column" aria-label={t.nav.footerCommunity}>
        <h2>{t.nav.footerCommunity}</h2>
        <a href={telegramGroupUrl} target="_blank" rel="noopener noreferrer" {...siteLinkClickAttrs(telegramGroupUrl, 'Footer Telegram')}>Telegram</a>
        <a href={githubRepoUrl} target="_blank" rel="noopener noreferrer" {...siteLinkClickAttrs(githubRepoUrl, 'Footer GitHub')}>GitHub</a>
        <a href={xProfileUrl} target="_blank" rel="noopener noreferrer" {...siteLinkClickAttrs(xProfileUrl, 'Footer X')}>X</a>
      </nav>
      <div class="footer-legal">
        <span>© {new Date().getFullYear()} {t.site.name} CardNav</span>
        <nav class="footer-legal-links" aria-label={t.nav.about}>{footerLinks.map(item => <a href={linkTo(item.href)}>{item.label}</a>)}</nav>
      </div>
    </div>
  </footer>

<script is:inline defer src="https://stats.cardnav.xyz/script.js" data-website-id="f708ee4d-be15-48e0-9eb8-344da355f150" data-auto-track="false" data-exclude-search="true" data-exclude-hash="true"></script>
<script is:inline defer src={publicTelemetryScriptUrl}></script>
<script is:inline defer src={publicShellScriptUrl}></script>
<script is:inline defer src={rowNavigationScriptUrl}></script>

<script is:inline src={merchantBadgeScriptUrl}></script>
<script>
  import '../scripts/gateway-engagement.js';
  import { startShopFavoriteSync } from '../scripts/shop-favorites.js';
  startShopFavoriteSync();
</script>
<ShopSubmitDialog />
<GatewaySubmitDialog />
<SupportDialog returnPage={activeNav === 'shops' ? 'shops' : activeNav === 'llm-gateway' ? 'gateways' : 'supporters'} />
<script>
  import '../scripts/submission-dialogs.js';
  import { initDialogNavigation } from '../scripts/dialog-navigation.js';
  initDialogNavigation();
</script>
<slot name="scripts" />
</body>
</html>
