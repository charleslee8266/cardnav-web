---
/*
文件说明: 通用内容卡片，提供可复用的强调色、标题、说明和正文插槽。
*/
type Props = {
  tone?: 'primary' | 'teal' | 'neutral';
  class?: string;
};

const {
  tone = 'neutral',
  class: className,
} = Astro.props;
---

<article class:list={['content-card', `content-card--${tone}`, className]}>
  <div class="content-card-body">
    <slot />
  </div>
</article>
