---
/*
文件说明: 公开页面共用的赞赏弹窗，提供个人、卡网和中转站身份及支付入口。
*/
import './support-flow.css';
import FormField from './FormField.astro';
import Dialog from './Dialog.astro';
import DialogSteps from './DialogSteps.astro';
import OpenShopLink from './OpenShopLink.astro';
import { telemetryBlocks } from '../telemetry-blocks.js';
type Props = { returnPage: 'shops' | 'gateways' | 'supporters' };
const { returnPage } = Astro.props;
const requestedKind = Astro.url.searchParams.get('support-kind');
const defaultKind = requestedKind === 'person' || requestedKind === 'shop' || requestedKind === 'gateway'
  ? requestedKind
  : returnPage === 'gateways' ? 'gateway' : returnPage === 'shops' ? 'shop' : 'person';
const submitPath = defaultKind === 'shop' ? '?dialog=shop-submit' : '?dialog=gateway-submit';
const t = Astro.locals.messages.support;
const hintSpace = Astro.locals.locale === 'zh' ? '' : ' ';
const hintSentenceEnd = Astro.locals.messages.shops.submitTypeSentenceEnd;
---
<Dialog
  id="supportDialog"
  class="support-dialog"
  size="wide"
  titleId="supportTitle"
  title={t.title}
  description={t.description}
  closeLabel={t.close}
  data-return-page={returnPage}
  data-locale={Astro.locals.locale}
  data-messages={JSON.stringify(t)}
  data-telemetry-block={telemetryBlocks.support.dialog}
>
  <DialogSteps steps={[t.stepIdentity, t.stepDetails, t.stepPayment]} label={t.title} tone="support" />
  <form id="supportForm" data-support-form class="submission-form" novalidate>
    <div data-support-step="1" class="submission-form">
    <FormField group label={t.identity} required>
      <div class="support-identities">
        <label><input type="radio" name="kind" value="person" class="radio radio-sm" checked={defaultKind === 'person'} /><span>{t.personChoice}</span></label>
        <label><input type="radio" name="kind" value="gateway" class="radio radio-sm" checked={defaultKind === 'gateway'} /><span>{t.gatewayChoice}</span></label>
        <label><input type="radio" name="kind" value="shop" class="radio radio-sm" checked={defaultKind === 'shop'} /><span>{t.shopChoice}</span></label>
      </div>
      <div slot="hint" data-identity-benefit role="status">
        {(['person', 'gateway', 'shop'] as const).map(kind => <p data-benefit-kind={kind} hidden={kind !== defaultKind}>
          {t[`${kind}Benefit`].split(/(\{list\}|\{rules\})/).map((part: string) => part === '{list}'
            ? <a target="_blank" rel="noopener noreferrer" href={Astro.locals.localizePath('/supporters')} class="link support-rule-link">{t.benefitListLabel}</a>
            : part === '{rules}' ? <a target="_blank" rel="noopener noreferrer" href={Astro.locals.localizePath('/partnership#sponsor-example')} class="link support-rule-link">{t.benefitRulesLabel}</a> : part)}
        </p>)}
      </div>
    </FormField>
    <fieldset data-person-fields class="submission-form" hidden={defaultKind !== 'person'} disabled={defaultKind !== 'person'}>
      <FormField label={t.nickname} for="supportNickname" hint={t.nicknameHint} hintId="supportNicknameHint"><input id="supportNickname" name="nickname" placeholder={t.anonymous} aria-describedby="supportNicknameHint" maxlength="40" autocomplete="nickname" class="form-input" /></FormField>
    </fieldset>
    <FormField group label={t.gateway} required data-site-fields hidden={defaultKind === 'person'} disabled={defaultKind === 'person'} hintId="supportSiteHint">
      <span slot="label" data-site-label>{defaultKind === 'shop' ? t.shop : t.gateway}</span>
      <div data-site-combobox class="support-site-combobox">
        <input data-site-search type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="supportSiteOptions" aria-describedby="supportSiteHint supportSiteStatus" class="form-input" placeholder={t.search} aria-label={defaultKind === 'shop' ? t.shop : t.gateway} autocomplete="off" />
        <span class="support-site-chevron" aria-hidden="true">▾</span>
        <input data-site-value type="hidden" name="siteId" />
        <div id="supportSiteOptions" data-site-options role="listbox" aria-label={t.select} class="support-site-options" hidden></div>
      </div>
      <p slot="hint"><span data-site-submit-hint>{defaultKind === 'shop' ? t.submitShopHint : t.submitGatewayHint}</span>{hintSpace}<a data-site-submit data-shop-submit="?dialog=shop-submit" data-gateway-submit="?dialog=gateway-submit" href={submitPath} data-umami-event="internal-link-click" data-umami-event-link-type="support-submit-site" data-umami-event-url={submitPath} class="link support-rule-link">{t.submitSite}</a>{hintSentenceEnd}<span data-shop-onboarding hidden={defaultKind !== 'shop'}>{hintSpace}{Astro.locals.messages.shops.openShopPrompt}{hintSpace}<OpenShopLink class="link support-rule-link" label={Astro.locals.messages.shops.openShopLink} />{hintSentenceEnd}</span></p>
      <p slot="error" id="supportSiteStatus" data-site-status role="status" class="form-field-hint"></p>
    </FormField>
    </div>
    <div data-support-step="2" class="submission-form" hidden>
    <div class="support-review"><span data-review-identity></span></div>
    <FormField label={t.email} for="supportEmail" required hint={t.emailHint} hintId="supportEmailHint"><input id="supportEmail" name="email" type="email" required aria-describedby="supportEmailHint" maxlength="254" autocomplete="email" placeholder={t.emailPlaceholder} class="form-input" /></FormField>
    <FormField label={t.message} for="supportMessage" hint={t.messageHint} hintId="supportMessageHint"><input id="supportMessage" name="message" maxlength="120" aria-describedby="supportMessageHint" placeholder={t.messagePlaceholder} class="form-input" /></FormField>
    <FormField label={t.amount} for="supportAmount" required hint={t.limit} hintId="supportAmountHint">
      <input id="supportAmount" name="amount" type="number" aria-describedby="supportAmountHint" min="5" max="5000" step="0.01" value="18.88" required inputmode="decimal" class="form-input" />
      <div class="support-amount-presets">{[8.88, 18.88, 38.88, 68.88, 88.88].map(amount => <button type="button" class="btn btn-sm" data-support-amount={amount} aria-pressed={amount === 18.88 ? 'true' : 'false'}>¥{amount}</button>)}</div>
    </FormField>

    <FormField group label={t.paymentMethod} required>
      <div class="support-payment-options">
        <label><input type="radio" name="paymentType" value="wxpay" class="radio radio-sm" checked /><img src="/assets/payment-icons/wechat.svg" width="24" height="24" alt="" /><span>{t.wxpay}</span></label>
        <label><input type="radio" name="paymentType" value="alipay" class="radio radio-sm" /><img src="/assets/payment-icons/alipay.svg" width="24" height="24" alt="" /><span>{t.alipay}</span></label>
      </div>
    </FormField>
    </div>
  </form>
  <section data-support-step="3" data-return-status-panel hidden class="support-return-status" aria-live="polite">
    <div class="support-payment-hero">
      <span data-payment-loading class="loading loading-spinner" aria-hidden="true" hidden></span>
      <div class="support-payment-heading">
        <h3 data-payment-state-title tabindex="-1" class="support-payment-state-title"></h3>
        <button data-check-payment type="button" class="link support-rule-link" hidden>{t.checkStatus}</button>
      </div>
      <p data-return-status role="status"></p>
      <p data-payment-window-hint hidden>{t.paymentWindowHint.split('{reopenPayment}').map((part: string, index: number) => <Fragment>{index > 0 && <a data-reopen-payment-link target="_blank" rel="noopener noreferrer" class="link support-rule-link">{t.paymentReopenLabel}</a>}{part}</Fragment>)}</p>
    </div>
    <dl data-order-summary class="support-order-summary" hidden>
      <div><dt>{t.identityColumn}</dt><dd data-summary-kind></dd></div>
      <div><dt data-summary-identity-label>{t.summaryIdentity}</dt><dd data-success-identity></dd></div>
      <div><dt>{t.email}</dt><dd data-summary-email></dd></div>
      <div><dt>{t.summaryAmount}</dt><dd data-success-amount></dd></div>

      <div><dt>{t.paymentMethod}</dt><dd data-summary-payment></dd></div>
      <div data-success-message-row hidden><dt>{t.message}</dt><dd data-success-message></dd></div>
    </dl>
    <p data-support-returned class="form-field-hint">{t.returned}</p>

  </section>
<div slot="footer" class="support-footer-actions">
    <div data-support-step="1">
    <button data-support-next type="button" class="btn support-button w-full">{t.continue} <span aria-hidden="true">→</span></button>
    </div>
    <div data-support-step="2" hidden class="submission-step-actions" data-active-step="2">
      <button data-support-back type="button" class="btn back-button"><span aria-hidden="true">←</span> {t.back}</button>
      <button data-pay-button type="submit" form="supportForm" class="btn support-button">{t.proceedPayment} <span aria-hidden="true">→</span></button>
    </div>
    <div data-support-step="3" hidden class="support-payment-actions">
      <button data-edit-details type="button" class="btn btn-outline btn-sm" hidden><span aria-hidden="true">←</span> {t.editDetails}</button>
      <button data-cancel-payment type="button" class="btn btn-outline btn-sm" hidden>{t.cancelPayment}</button>
      <button data-restart-support type="button" class="btn support-button btn-sm" hidden>{t.restart}</button>
      <button data-open-payment type="button" class="btn btn-outline btn-sm" hidden>{t.openPayment}</button>
      <button data-support-close type="button" class="btn btn-outline btn-sm" hidden>{t.close}</button>
      <a target="_blank" rel="noopener noreferrer" data-support-list href={Astro.locals.localizePath('/supporters')} class="btn support-button btn-sm" hidden>{t.viewList}</a>
    </div>
  </div>
</Dialog>
<script>
  import '../scripts/SupportDialog.js';
</script>
