---
/*
文件说明: 提供弹窗的公共外壳、标题、介绍、关闭入口与内容插槽。
*/
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'dialog'> & {
  id: string;
  title: string;
  titleId?: string;
  description?: string;
  closeLabel: string;
  backdropLabel?: string;
  size?: 'compact' | 'wide';
};
const {
  id, title, titleId = `${id}Title`, description, closeLabel,
  backdropLabel = closeLabel, size = 'compact', class: className, ...attributes
} = Astro.props;
---
<dialog {...attributes} id={id} class:list={['modal', className]} aria-labelledby={titleId}>
  <div class:list={['modal-box form-dialog-body', size === 'wide' ? 'form-dialog-wide' : 'form-dialog-compact']}>
    <form method="dialog" class="form-dialog-close">
      <button type="submit" class="btn btn-ghost btn-circle btn-sm" aria-label={closeLabel} data-umami-event="button-click" data-umami-event-scope="dialog" data-umami-event-action="close">✕</button>
    </form>
    <header class="form-dialog-header">
    <h2 id={titleId} class="form-dialog-title">{title}</h2>
    {description && <p class="form-dialog-description">{description}</p>}
    </header>
    <div class="form-dialog-content"><slot /></div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button type="submit" aria-label={backdropLabel}>{closeLabel}</button>
  </form>
</dialog>
