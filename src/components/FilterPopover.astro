---
import './data-workspace.css';
type Props = { id: string; label: string; doneLabel: string; clearLabel: string };
const { id, label, doneLabel, clearLabel } = Astro.props;
---
<div class="data-filter" data-filter-popover>
  <button type="button" class="btn btn-sm data-filter-trigger" aria-controls={id} aria-expanded="false" data-filter-trigger>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 7h16M7 12h10M10 17h4" /></svg>
    {label}<span class="data-filter-count" data-filter-count hidden></span>
  </button>
  <div id={id} class="data-filter-panel" popover="auto" aria-label={label}>
    <div class="data-filter-heading">{label}</div>
    <div class="data-filter-fields"><slot /></div>
    <div class="data-filter-footer"><button type="button" class="btn btn-sm btn-ghost" data-filter-clear>{clearLabel}</button><button type="button" class="btn btn-sm btn-primary" data-filter-close>{doneLabel}</button></div>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-filter-popover]').forEach(root => {
    const trigger = root.querySelector<HTMLButtonElement>('[data-filter-trigger]')!;
    const panel = root.querySelector<HTMLElement>('[popover]')!;
    const position = () => {
      if (window.matchMedia('(max-width: 720px)').matches) return;
      const rect = trigger.getBoundingClientRect();
      const viewport = window.visualViewport;
      const leftEdge = (viewport?.offsetLeft ?? 0) + 16;
      const topEdge = (viewport?.offsetTop ?? 0) + 16;
      const width = viewport?.width ?? document.documentElement.clientWidth;
      const height = viewport?.height ?? document.documentElement.clientHeight;
      panel.style.setProperty('--filter-max-width', `${Math.max(0, width - 32)}px`);
      panel.style.setProperty('--filter-max-height', `${Math.max(0, height - 32)}px`);
      const rightLimit = leftEdge + width - 32 - panel.offsetWidth;
      const bottomLimit = topEdge + height - 32 - panel.offsetHeight;
      const below = rect.bottom + 8;
      const above = rect.top - panel.offsetHeight - 8;
      const preferredTop = below > bottomLimit && above >= topEdge ? above : below;
      panel.style.setProperty('--filter-left', `${Math.max(leftEdge, Math.min(rect.right - panel.offsetWidth, rightLimit))}px`);
      panel.style.setProperty('--filter-top', `${Math.max(topEdge, Math.min(preferredTop, bottomLimit))}px`);
    };
    let closeTimer: ReturnType<typeof setTimeout> | undefined;
    let pinned = false;
    const cancelClose = () => { clearTimeout(closeTimer); };
    const open = () => { cancelClose(); if (!panel.matches(':popover-open')) panel.showPopover(); position(); };
    const hoverEnter = (event: PointerEvent) => { if (event.pointerType === 'mouse') open(); };
    const hoverLeave = (event: PointerEvent) => {
      if (event.pointerType !== 'mouse' || pinned) return;
      cancelClose();
      closeTimer = setTimeout(() => { if (!pinned && !panel.matches(':hover') && !trigger.matches(':hover')) panel.hidePopover(); }, 180);
    };
    trigger.addEventListener('pointerenter', hoverEnter);
    panel.addEventListener('pointerenter', cancelClose);
    trigger.addEventListener('pointerleave', hoverLeave);
    panel.addEventListener('pointerleave', hoverLeave);
    panel.addEventListener('pointerdown', () => { pinned = true; cancelClose(); });
    trigger.addEventListener('click', () => {
      cancelClose();
      if (pinned && panel.matches(':popover-open')) panel.hidePopover();
      else { pinned = true; open(); }
    });
    panel.addEventListener('keydown', event => { if (event.key === 'Escape') { panel.hidePopover(); trigger.focus(); } });
    panel.addEventListener('toggle', () => {
      const open = panel.matches(':popover-open');
      trigger.setAttribute('aria-expanded', String(open));
      if (open) position();
      else { pinned = false; cancelClose(); }
    });
    panel.querySelector('[data-filter-clear]')?.addEventListener('click', () => { panel.dispatchEvent(new CustomEvent('filter-clear', { bubbles: true })); });
    panel.querySelector('[data-filter-close]')?.addEventListener('click', () => { panel.hidePopover(); trigger.focus(); });
    const reposition = () => { if (panel.matches(':popover-open')) position(); };
    window.addEventListener('resize', reposition);
    window.addEventListener('scroll', reposition, { passive: true, capture: true });
    window.visualViewport?.addEventListener('resize', reposition);
    window.visualViewport?.addEventListener('scroll', reposition);
    new ResizeObserver(reposition).observe(panel);
  });
</script>
