---
/*
文件说明: 渲染向导文档树、文章与本页目录，并在窄屏提供可展开的文档导航。
*/
import { telemetryBlocks } from '../telemetry-blocks.js';
import Sponsors from './Sponsors.astro';
import GuideTree from './GuideTree.astro';
import ArticleToc from './ArticleToc.astro';
import './content.css';
import pageWidgetsScriptUrl from '../scripts/page-widgets.js?url';
import type { GuideArticle, GuideNavItem, RenderedGuideArticle } from '../guide.js';
import type { PageType } from '../page-types.js';

type Props = {
  articles: GuideArticle[];
  navItems: GuideNavItem[];
  currentArticle: RenderedGuideArticle;
  sourcePage: string;
  pageType: Extract<PageType, 'guide' | 'guide-detail'>;
};

const {
  navItems,
  currentArticle,
  sourcePage,
  pageType,
} = Astro.props;

const t = Astro.locals.messages;
const linkTo = Astro.locals.localizePath;

function guideUrlClickAttrs(targetPage: string) {
  const localizedTargetPage = linkTo(targetPage);
  return {
    'data-umami-event': 'internal-link-click',
    'data-umami-event-link-type': 'guide',
    'data-umami-event-source-page': linkTo(sourcePage),
    'data-umami-event-target-page': localizedTargetPage,
    'data-umami-event-url': localizedTargetPage,
  };
}

function localizeRenderedGuideLinks(html: string) {
  return html.replace(/href="(\/guide[^"]*)"/gu, (_match, href: string) => `href="${linkTo(href)}"`);
}

const localizedArticleHtml = localizeRenderedGuideLinks(currentArticle.html);
---

<section class="reading-guide" data-reading-layout>
  <aside class="reading-tree">
    <details class="reading-tree-disclosure" open>
      <summary class="reading-tree-summary"><span>{t.guide.allDocs}</span><span class="reading-tree-current">{currentArticle.title}</span><span aria-hidden="true">⌄</span></summary>
    <nav data-telemetry-block={telemetryBlocks.guide.navigation} aria-label={t.guide.docListLabel} class="reading-tree-nav">
      <GuideTree items={navItems} currentSlug={currentArticle.slug} sourcePage={sourcePage} />
    </nav>
    </details>
  </aside>

  <section class="reading-content">
    <section data-telemetry-block={telemetryBlocks.guide.content} class="reading-article">
      <div class="guide-hero">
        <h1 class="reading-title">{currentArticle.title}</h1>
        <p class="reading-description">{(t.guide.heroDescriptions as Record<string, string>)[currentArticle.slug] || currentArticle.description}</p>
      </div>
      <div id="guide-article" class="guide-article reading-prose" set:html={localizedArticleHtml} />
    </section>

    {currentArticle.nextLink && (
      <a
        data-telemetry-block={telemetryBlocks.guide.next}
        href={linkTo(`/guide/${currentArticle.nextLink.slug}`)}
        {...guideUrlClickAttrs(`/guide/${currentArticle.nextLink.slug}`)}
        class="guide-next-step"
      >
        <p class="guide-next-step-label">{t.guide.nextStep}</p>
        <span class="guide-next-step-link">
          {currentArticle.nextLink.title || currentArticle.nextLink.slug}
        </span>
      </a>
    )}

  </section>
  <ArticleToc target="guide-article" />
</section>
<Sponsors placement="content-bottom" pageType={pageType} />
<script is:inline slot="scripts" defer src={pageWidgetsScriptUrl}></script>
