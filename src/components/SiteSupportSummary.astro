---
/** Current site's partnership and confirmed cumulative support, shared by both details. */
import Icon from './Icon.astro';
type Props = { partner: boolean; totalCents: number; points: number };
const { partner, totalCents, points } = Astro.props;
const pointsLabel = Math.max(0, points || 0).toLocaleString(Astro.locals.locale, { maximumFractionDigits: 2 });
const linkTo = Astro.locals.localizePath;
const amount = `¥${(Math.max(0, totalCents || 0) / 100).toLocaleString(Astro.locals.locale, { maximumFractionDigits: 2 })}`;
const t = Astro.locals.messages;
---
{(partner || totalCents > 0) && <div class="detail-commercial-summary">
  {partner && <div class="detail-commercial-item detail-partner-summary">
    <span class="detail-commercial-icon"><Icon name="handshake" /></span>
    <div class="detail-commercial-content"><p class="detail-commercial-title">{t.sponsors.sponsorLabel}</p><p class="detail-commercial-copy">{t.sponsors.sponsorDescription}{' '}<a class="detail-commercial-link" href={linkTo('/partnership')}>{t.sponsors.partnershipLinkLabel}</a>{t.shops.submitTypeSentenceEnd}</p></div>
  </div>}
  {totalCents > 0 && <div class="detail-commercial-item detail-support-summary">
    <span class="detail-commercial-icon"><Icon name="heart" /></span>
    <div class="detail-commercial-content"><p class="detail-commercial-title">{t.support.badgeLabel}</p><p class="detail-commercial-copy">{t.support.detailThanks.replace('{amount}', amount).replace('{points}', pointsLabel)}{' '}<a class="detail-commercial-link" href={linkTo('/supporters')}>{t.sponsors.partnershipLinkLabel}</a>{t.shops.submitTypeSentenceEnd}</p></div>
  </div>}
</div>}
<style>
  .detail-commercial-summary { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; margin-top:16px; width:100%; }
  .detail-commercial-item { display:flex; align-items:flex-start; gap:10px; padding:12px; border:1px solid var(--detail-commercial-line); border-radius:8px; background:var(--detail-commercial-bg); min-width:0; }
  .detail-commercial-item p { margin:0; }
  .detail-commercial-icon { display:flex; align-items:center; justify-content:center; flex:none; width:28px; height:28px; border-radius:7px; background:color-mix(in srgb,currentColor 10%,transparent); }
  .detail-commercial-title { font-size:13px; font-weight:600; line-height:1.5; font-variant-numeric:tabular-nums; }
  .detail-commercial-content { min-width:0; }
  .detail-commercial-link { color:var(--detail-commercial-color); text-decoration:none; text-underline-offset:3px; }
  .detail-commercial-link:hover { text-decoration:underline; }
  .detail-commercial-item .detail-commercial-copy { margin-top:3px; font-size:12px; line-height:1.6; color:var(--color-ink-secondary); }
  .detail-partner-summary { color:var(--merchant-partner-text); --detail-commercial-color:var(--merchant-partner-text); --detail-commercial-line:var(--color-partner-line); --detail-commercial-bg:var(--color-partner-soft); }
  .detail-support-summary { color:var(--color-support); --detail-commercial-color:var(--color-support); --detail-commercial-line:var(--color-support-line); --detail-commercial-bg:var(--color-support-soft); }
  @media(max-width:1100px) { .detail-commercial-summary { grid-template-columns:minmax(0,1fr); } }
</style>
