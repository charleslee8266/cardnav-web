---
/** Daily inventory observations, with missing days kept distinct from zero. */
type Props = { days: { date: string; decrease: number | null }[]; total: number | null };
const { days, total } = Astro.props;
const t = Astro.locals.messages.shops;
const locale = Astro.locals.locale === 'zh' ? 'zh-CN' : Astro.locals.locale;
const number = (value: number) => value.toLocaleString(locale);
const date = (value: string) => new Date(`${value}T00:00:00+08:00`).toLocaleDateString(locale, { month: 'short', day: 'numeric', timeZone: 'Asia/Shanghai' });
const observed = days.filter(day => day.decrease !== null);
const maximum = Math.max(1, ...observed.map(day => day.decrease!));
const valueLabel = (value: number | null) => value === null ? t.detailInventoryMissing : `${number(value)} ${t.detailInventoryUnit}`;
---
<section class="card border border-base-300 bg-base-100 stock-history" data-stock-history>
  <div class="stock-history-header">
    <div>
      <h2 class="data-section-title">{t.detailInventoryDaily} <button type="button" class="inline-help-button" aria-label={t.detailInventoryDaily} data-inline-help data-tip={t.detailInventoryHint}>i</button></h2>
    </div>
    <div class="stock-history-total">
      <span class="text-xs text-base-content/60">{t.detailInventoryTotal}</span>
      <strong>{total === null ? '—' : number(total)}<small>{total === null ? '' : t.detailInventoryUnit}</small></strong>
    </div>
  </div>
  <div class="card-body">
    {days.length ? <>
      <div class="stock-history-plot">
        <div class="stock-history-axis" aria-hidden="true"><span>{number(maximum)}</span><span>{number(Math.round(maximum / 2))}</span><span>0</span></div>
        <div class="stock-history-days" style={`--days:${days.length}`}>
          {days.map((day, index) => <button type="button" class:list={['stock-history-day', { 'is-missing': day.decrease === null }]}
            data-stock-day
            aria-label={`${date(day.date)} · ${valueLabel(day.decrease)}`}
            style={`--bar-height:${day.decrease === null ? 0 : Math.max(1, day.decrease / maximum * 100)}%`}>
            <span class="stock-history-bar-area"><span class="stock-history-bar"></span><span class="stock-history-tooltip" aria-hidden="true"><span>{date(day.date)}</span><strong>{valueLabel(day.decrease)}</strong></span></span>
            <span class="stock-history-date" aria-hidden="true">{index === 0 || index === days.length - 1 || (index % 7 === 0 && index < days.length - 4) ? date(day.date) : ''}</span>
          </button>)}
        </div>
      </div>
      <div class="stock-history-legend text-xs text-base-content/60"><span><i></i>{t.detailInventoryLegend}</span><span><i class="missing"></i>{t.detailInventoryMissing}</span></div>
    </> : <p class="text-sm text-base-content/60">{t.detailInventoryMissing}</p>}
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-stock-history]').forEach(chart => {
    const show = (button: HTMLElement) => {
      chart.querySelector('[data-stock-day][aria-pressed="true"]')?.removeAttribute('aria-pressed');
      button.setAttribute('aria-pressed', 'true');
    };
    chart.querySelectorAll<HTMLElement>('[data-stock-day]').forEach(button => {
      button.addEventListener('pointerenter', () => show(button));
      button.addEventListener('pointerleave', () => button.removeAttribute('aria-pressed'));
      button.addEventListener('blur', () => button.removeAttribute('aria-pressed'));
      button.addEventListener('focus', () => show(button));
      button.addEventListener('click', () => show(button));
    });
  });
</script>
<style>
  .stock-history { min-width:0; }
  .stock-history-header { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8px 12px; padding:18px 24px; border-bottom:1px solid var(--color-base-300); }
  .stock-history-total { display:flex; align-items:baseline; flex-shrink:0; gap:8px; margin-left:auto; white-space:nowrap; }
  .stock-history-total strong { font-size:22px; line-height:1.2; font-variant-numeric:tabular-nums; }
  .stock-history-total small { font-size:12px; font-weight:400; margin-left:6px; color:var(--color-muted); }
  .stock-history-plot { display:flex; gap:10px; min-width:0; padding-top:44px; }
  .stock-history-axis { display:flex; flex-direction:column; justify-content:space-between; align-items:flex-end; padding-bottom:28px; min-width:26px; font-size:10px; color:var(--color-muted); }
  .stock-history-days { display:grid; grid-template-columns:repeat(var(--days),minmax(0,1fr)); flex:1; min-width:0; background:repeating-linear-gradient(to top,transparent 0,transparent calc(50% - 1px),var(--color-base-300) calc(50% - 1px),var(--color-base-300) 50%); background-size:100% calc(100% - 28px); background-repeat:no-repeat; }
  .stock-history-day { min-width:0; border:0; padding:0 2px; background:transparent; cursor:pointer; color:inherit; }
  .stock-history-bar-area { position:relative; height:190px; display:flex; align-items:flex-end; border-bottom:1px solid var(--color-base-300); }
  .stock-history-bar { display:block; width:100%; height:var(--bar-height); min-height:2px; background:var(--color-primary); border-radius:3px 3px 0 0; opacity:.7; }
  .is-missing .stock-history-bar { height:4px; min-height:0; background:transparent; border-top:2px dotted var(--color-muted); border-radius:0; }
  .stock-history-day:hover .stock-history-bar,.stock-history-day[aria-pressed="true"] .stock-history-bar { opacity:1; }
  .stock-history-tooltip { display:none; position:absolute; bottom:calc(var(--bar-height) + 8px); left:50%; transform:translateX(-50%); z-index:2; width:max-content; max-width:210px; padding:6px 9px; border:1px solid var(--color-base-300); border-radius:6px; background:var(--color-base-100); color:var(--color-base-content); box-shadow:0 2px 8px color-mix(in srgb,var(--color-base-content) 10%,transparent); font-size:12px; line-height:1.5; text-align:left; pointer-events:none; }
  .stock-history-tooltip > span { display:block; color:var(--color-muted); font-size:11px; }
  .stock-history-day[aria-pressed="true"] .stock-history-tooltip { display:block; }
  .stock-history-day:nth-child(-n+5) .stock-history-tooltip { left:0; transform:none; }
  .stock-history-day:nth-last-child(-n+5) .stock-history-tooltip { left:auto; right:0; transform:none; }
  .stock-history-day:focus-visible { outline:2px solid var(--color-primary); outline-offset:2px; border-radius:3px; }
  .stock-history-date { display:block; position:relative; padding-top:8px; height:28px; white-space:nowrap; font-size:10px; color:var(--color-muted); }
  .stock-history-day:last-child .stock-history-date { text-align:right; direction:rtl; }
  .stock-history-legend { display:flex; flex-wrap:wrap; gap:8px 20px; margin-top:14px; }
  .stock-history-legend > span { display:flex; gap:6px; align-items:center; }
  .stock-history-legend i { width:10px; height:8px; border-radius:2px; background:var(--color-primary); opacity:.7; }
  .stock-history-legend i.missing { height:0; background:transparent; border-top:2px dotted var(--color-muted); }
  @media(max-width:720px) { .stock-history-header { padding:14px 16px; } .stock-history-total strong { font-size:20px; } .stock-history-day { padding:0 1px; } .stock-history-date { font-size:9px; } }
</style>
