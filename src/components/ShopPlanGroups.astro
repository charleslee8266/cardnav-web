---
import { type QuickPlanSearchTerm, quickPlanProducts, quickProductDefaultPlan, quickProductSearchTerm, quickProductSearchQuery, quickPlanShortLabel, quickPlanDisplayName, quickPlanHeroName, quickPlanSearchSeoPath, quickPlanGatewayPath, quickPlanGatewayFamilyName } from '../models/product-catalog.js';
import { productIconPath } from '../models/product-icons.js';
import { officialPricePathname } from '../models/routes.js';
import { autoCategoryLabel } from '../shop-auto-category.js';
type Props = { mode?: 'filter' | 'navigate'; productLimit?: number; initialSearchQuery: string; officialPriceUrlSlugs: Set<string> };
const { initialSearchQuery, officialPriceUrlSlugs, mode = 'filter', productLimit } = Astro.props;
const linkTo = Astro.locals.localizePath;
const language = Astro.locals.locale;
const visibleProducts = quickPlanProducts.filter(product => !product.hiddenFromQuickFilters).slice(0, productLimit);
const groups = mode === 'filter' ? visibleProducts.filter(product => product.terms.length > 1) : [];
const initialProduct = quickPlanProducts.find(product => (product.terms.some(term => term.query === initialSearchQuery) || quickProductSearchQuery(product.id) === initialSearchQuery));
function navigationProps(term: QuickPlanSearchTerm) {
  const href = linkTo(quickPlanSearchSeoPath(term));
  return { href, 'data-umami-event': 'internal-link-click', 'data-umami-event-link-type': 'home-quick-filter', 'data-umami-event-name': term.label, 'data-umami-event-target-page': href, 'data-umami-event-url': href };
}
function buttonProps(term: QuickPlanSearchTerm) {
  return {
    'data-quick-plan-query': term.query,
    'data-auto-category-id': term.slug,
    'data-quick-plan-label': term.label,
    'data-quick-plan-display-name': quickPlanDisplayName(term),
    'data-quick-plan-hero-name': quickPlanHeroName(term),
    'data-quick-plan-path': linkTo(quickPlanSearchSeoPath(term)),
    'data-official-price-path': term.officialPriceSlug && officialPriceUrlSlugs.has(term.officialPriceSlug) ? linkTo(officialPricePathname(term.officialPriceSlug)) : undefined,
    'data-gateway-path': quickPlanGatewayPath(term) ? linkTo(quickPlanGatewayPath(term)) : undefined,
    'data-gateway-family': term.gatewayFamily,
    'data-gateway-product-name': quickPlanGatewayFamilyName(term),
    'aria-label': term.label,
    'aria-pressed': initialSearchQuery === term.query,
  };
}
---
<div id="quickPlanRow" class="plan-picker" data-mode={mode} aria-label={Astro.locals.messages.shops.quickPlanSearch}>
  <div class="plan-tabs">
  <div id="quickPlanGroups" class="plan-groups">
      <span class="plan-picker-label text-sm font-normal text-base-content/65 uppercase tracking-wider">{Astro.locals.messages.shops.quickPlanSearch}</span>
    {mode === 'filter' && <button type="button" class="plan-option plan-product" data-clear-plan aria-pressed={!initialSearchQuery}>{Astro.locals.messages.shops.allPlans}</button>}
    {visibleProducts.map(product => {
      const singleton = product.terms.length === 1;
      const ProductTag = mode === 'navigate' ? 'a' : 'button';
      return <ProductTag type={ProductTag === 'button' ? 'button' : undefined} {...(mode === 'navigate' ? navigationProps(quickProductSearchTerm(product)) : {})} class="plan-option plan-product" data-product-id={product.id}
        {...{ ...buttonProps(quickProductDefaultPlan(product)),
          'aria-controls': mode === 'navigate' || singleton ? undefined : `plan-options-${product.id}`,
          'aria-pressed': initialProduct?.id === product.id && Boolean(initialSearchQuery) }}>
        {product.icon ? <img src={productIconPath(product.icon)} alt="" width="18" height="18" class:list={['plan-brand-icon', product.monochrome && 'plan-icon-mono']} /> : <span class="plan-letter" aria-hidden="true">{product.symbol}</span>}
        {singleton ? autoCategoryLabel(product.terms[0].slug, language) : product.label}
      </ProductTag>;
    })}
  </div>
  {groups.map(group => <div id={`plan-options-${group.id}`} class="plan-group-options" data-product-options={group.id} hidden={initialProduct?.id !== group.id} aria-label={group.label}>
    <span class="plan-panel-label">{Astro.locals.messages.shops.productPlans.replace('{product}', group.label)}</span>
    <div class="plan-package-scroll">
    <a role="button" class="plan-option" {...navigationProps(quickProductSearchTerm(group))} {...{ ...buttonProps(quickProductSearchTerm(group)), 'aria-label': `${group.label} ${Astro.locals.messages.shops.allPlans}` }}>{Astro.locals.messages.shops.allPlans}</a>
    {group.terms.map(term => <a role="button" class="plan-option" {...navigationProps(term)} {...buttonProps(term)}>{quickPlanShortLabel(term, group.id)}</a>)}
    </div>
  </div>)}
  </div>
</div>
<script>
  const picker = document.querySelector<HTMLElement>('#quickPlanRow');
  const groups = picker?.querySelector<HTMLElement>('.plan-groups');
  if (picker && groups) {
    picker.addEventListener('keydown', event => {
      if (event.key !== ' ') return;
      const target = event.target;
      if (!(target instanceof HTMLAnchorElement) || target.getAttribute('role') !== 'button') return;
      event.preventDefault();
      target.click();
    });
    const brands = Array.from(groups.querySelectorAll<HTMLButtonElement>('[data-product-id]'));
    const panels = Array.from(picker.querySelectorAll<HTMLElement>('[data-product-options]'));
    const showProduct = (id: string) => {
      picker.querySelector('[data-clear-plan]')?.setAttribute('aria-pressed', String(!id));
      for (const brand of brands) brand.setAttribute('aria-pressed', String(brand.dataset.productId === id));
      for (const panel of panels) panel.hidden = panel.dataset.productOptions !== id;
    };
    picker.addEventListener('quick-plan-query-change', event => {
      const query = (event as CustomEvent<string>).detail;
      const match = Array.from(picker.querySelectorAll<HTMLElement>('[data-quick-plan-query]')).find(button => button.dataset.quickPlanQuery === query);
      const id = match?.closest<HTMLElement>('[data-product-options]')?.dataset.productOptions ?? match?.dataset.productId;
      showProduct(id ?? '');
    });

  }
</script>
