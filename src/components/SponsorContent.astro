---
/*
文件说明: 渲染 CardNav 公开站点赞助商展示区，供首页和内容页复用。
*/
import SponsorGrid from './SponsorGrid.astro';
import { telemetryBlocks } from '../telemetry-blocks.js';
import { getSponsors } from '../sponsor-provider.js';
import type { PageType } from '../page-types.js';

const t = Astro.locals.messages;
type Props = {
  placement: 'page-bottom' | 'after-hero' | 'content-bottom';
  pageType?: PageType;
};

const { placement, pageType } = Astro.props as Props;
const sponsors = pageType
  ? await getSponsors({ placement, pageType, locale: Astro.locals.locale })
  : [];
const partnershipUrl = Astro.locals.localizePath('/partnership');
const sectionId = pageType ? `sponsors-${placement}-${pageType}` : `sponsors-${placement}`;
---

{sponsors.length > 0 && <section class="sponsor-section" data-placement={placement} data-telemetry-block={telemetryBlocks.sponsors[placement]} aria-labelledby={sectionId}>
  <div class="sponsor-header">
    <h2 id={sectionId} class="sponsor-title">{t.sponsors.title}</h2>
    <a href={partnershipUrl} data-umami-event="internal-link-click" data-umami-event-link-type="sponsor-lead" data-umami-event-url={partnershipUrl} data-umami-event-name={t.sponsors.becomeSponsor} class="sponsor-join-link">{t.sponsors.becomeSponsor}</a>
  </div>
  <SponsorGrid sponsors={sponsors} placement={placement} />
</section>}
