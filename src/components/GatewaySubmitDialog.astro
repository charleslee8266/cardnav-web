---
/* Gateway submission uses the shared dialog shell and confirms all fields before sending. */
import { telemetryBlocks } from '../telemetry-blocks.js';
import { paymentIcon } from '../gateway-display.js';
import FormField from './FormField.astro';
import Dialog from './Dialog.astro';
import DialogSteps from './DialogSteps.astro';
const t = Astro.locals.messages;
const linkTo = Astro.locals.localizePath;
const payments = Object.entries(t.llmGateway.paymentMethodLabels).map(([value, label]) => ({ value, label: String(label) }));
---
<Dialog id="gatewaySubmitDialog" title={t.llmGateway.submitGateway} closeLabel={t.llmGateway.closeSubmitDialog} backdropLabel={t.llmGateway.closeSubmitBackdrop} data-telemetry-block={telemetryBlocks.gateways.submit} size="wide">
  <p slot="description" class="form-dialog-description">{t.llmGateway.submitTypeDescription}<br />{t.llmGateway.submitShopPrompt}{Astro.locals.locale === 'zh' ? '' : ' '}<a href={`${linkTo('/shops')}?submit-dialog`} class="gateway-submit-link" data-umami-event="internal-link-click" data-umami-event-link-type="gateway-submit-shop" data-umami-event-url={`${linkTo('/shops')}?submit-dialog`}>{t.llmGateway.submitShopLink}</a>{t.llmGateway.submitTypeSentenceEnd}</p>
  <DialogSteps steps={[t.support.stepDetails, t.submit.confirm, t.submit.result]} label={t.llmGateway.submitGateway} />
  <form id="gatewaySubmitForm" class="submission-form" novalidate method="post" action="/api/gateway-submit">
    <div data-gateway-step="1" class="gateway-submit-fields">
      <FormField label={t.llmGateway.submitName} for="gatewayNameInput" required>
        <input id="gatewayNameInput" aria-describedby="gatewaySubmitError" name="name" required maxlength="20" class="form-input" placeholder={t.llmGateway.submitNamePlaceholder} />
      </FormField>
      <FormField label={t.llmGateway.submitSummary} for="gatewaySummaryInput">
        <textarea id="gatewaySummaryInput" aria-describedby="gatewaySubmitError" name="summary" maxlength="150" rows="3" class="form-input" placeholder={t.llmGateway.submitSummaryPlaceholder}></textarea>
      </FormField>
      <FormField label={t.llmGateway.submitUrl} for="gatewayUrlInput" required>
        <input id="gatewayUrlInput" aria-describedby="gatewaySubmitError" name="url" type="url" required class="form-input" placeholder="https://www.example.com" autocomplete="url" />
      </FormField>
      <FormField label={t.llmGateway.submitApiEndpoint} for="gatewayApiEndpointInput" hint={t.llmGateway.submitApiEndpointDescription} hintId="gatewayApiEndpointInputHint">
        <input id="gatewayApiEndpointInput" aria-describedby="gatewayApiEndpointInputHint gatewaySubmitError" name="apiEndpoint" type="url" class="form-input" placeholder="https://api.example.com" autocomplete="url" />
      </FormField>
      <FormField label={t.llmGateway.submitPaymentMethods} group>
        <div id="gatewayPaymentSelect" class="gateway-payment-tags">
          {payments.map(({value, label}) => <label class="plan-option plan-product">
            <input type="checkbox" value={value} class="sr-only" />
            <img class="plan-brand-icon" src={paymentIcon(value).src} alt="" width="14" height="14" />{label}
          </label>)}
        </div>
      </FormField>
    </div>
    <section data-gateway-step="2" hidden>
      <dl class="gateway-submit-review">
        {[["name", t.llmGateway.submitName], ["summary", t.llmGateway.submitSummary], ["url", t.llmGateway.submitUrl], ["apiEndpoint", t.llmGateway.submitApiEndpoint], ["paymentMethods", t.llmGateway.submitPaymentMethods]].map(([field, label]) => <div><dt>{label}</dt><dd data-gateway-review={field}></dd></div>)}
      </dl>
    </section>
    <section data-gateway-step="3" hidden>
      <p id="gatewaySubmitSuccess" role="status" tabindex="-1" class="text-sm text-primary font-medium"></p>
      <dl class="gateway-submit-review">
        {[["name", t.llmGateway.submitName], ["summary", t.llmGateway.submitSummary], ["url", t.llmGateway.submitUrl], ["apiEndpoint", t.llmGateway.submitApiEndpoint], ["paymentMethods", t.llmGateway.submitPaymentMethods]].map(([field, label]) => <div><dt>{label}</dt><dd data-gateway-review={field}></dd></div>)}
      </dl>
      <div class="gateway-submit-notice">{t.submit.gatewayResultDescription}</div>
      <div class="gateway-submit-notice gateway-submit-cooperation"><strong>{t.shops.cooperationTitle}</strong><p>{t.shops.cooperationDescription}<a href={linkTo('/partnership')} target="_blank" rel="noopener noreferrer" data-umami-event="internal-link-click" data-umami-event-link-type="gateway-submit-partnership" data-umami-event-url={linkTo('/partnership')} class="gateway-submit-link">{t.shops.cooperationDetails}</a>{t.shops.cooperationSentenceEnd}</p></div>
    </section>
    <p id="gatewaySubmitError" role="alert" tabindex="-1" hidden class="form-field-error"></p>
  </form>
  <div slot="footer" class="submission-step-actions" data-active-step="1">
    <button type="submit" form="gatewaySubmitForm" data-gateway-next class="btn submit-button">{t.submit.continue} <span aria-hidden="true">→</span></button>
    <button type="button" data-gateway-back hidden class="btn back-button"><span aria-hidden="true">←</span> {t.submit.back}</button>
    <button type="submit" form="gatewaySubmitForm" data-gateway-submit hidden class="btn submit-button">{t.actions.submit} <span aria-hidden="true">→</span></button>
    <button type="button" data-gateway-done hidden class="btn submit-button">{t.submit.done} <span aria-hidden="true">→</span></button>
  </div>
</Dialog>
<script is:inline type="application/json" id="gateway-submit-messages" set:html={JSON.stringify({ locale: Astro.locals.locale, submit: t.submit, gateway: { paymentMethodSeparator: t.llmGateway.paymentMethodSeparator } })}></script>
