---
/** 指南共用侧栏：向导与文章是同级入口，两者各有子级目录。 */
import GuideTree from './GuideTree.astro';
import GuideSearch from './GuideSearch.astro';
import { loadPublicArticleNavigation } from '../articles.js';
import { getGuideCollection } from '../guide.js';
import './content.css';
type Props = { section: 'getting-started' | 'articles'; currentSlug?: string };
const { section, currentSlug = '' } = Astro.props;
const t = Astro.locals.messages;
const { guideNavItems, defaultGuideArticle } = getGuideCollection(Astro.locals.locale);
const tutorialItems = guideNavItems.filter(item => item.article.slug !== defaultGuideArticle?.slug && item.article.slug !== 'articles');
const linkTo = Astro.locals.localizePath;
const articleItems = await loadPublicArticleNavigation();
---
<aside class="reading-tree guide-sidebar">
  <details class="reading-tree-disclosure" open>
    <summary class="reading-tree-summary"><span>{t.nav.guide}</span><span class="reading-tree-current">{section === 'articles' ? t.guide.articles : t.guide.gettingStarted}</span><span class="reading-tree-indicator" aria-hidden="true"><span class="reading-tree-symbol"></span></span></summary>
    <nav class="reading-tree-nav" aria-label={t.guide.sectionNavigation}>
      <GuideSearch />
      <details class="guide-section-group" open={section === 'getting-started'}>
        <summary><span class="reading-tree-indicator" aria-hidden="true"><span class="reading-tree-symbol"></span></span><a class="guide-section-link" href={linkTo(`/guide/${defaultGuideArticle?.slug || 'start-here'}`)} aria-current={section === 'getting-started' ? (currentSlug === defaultGuideArticle?.slug ? 'page' : 'location') : undefined}>{t.guide.gettingStarted}</a></summary>
        <GuideTree items={tutorialItems} currentSlug={section === 'getting-started' ? currentSlug : ''} sourcePage={Astro.locals.routePathname} />
      </details>
      <details class="guide-section-group" id="guide-articles" open={section === 'articles'}>
        <summary><span class="reading-tree-indicator" aria-hidden="true"><span class="reading-tree-symbol"></span></span><a class="guide-section-link" href="/guide/articles" aria-current={section === 'articles' ? (currentSlug === 'articles' ? 'page' : 'location') : undefined}>{t.guide.articles}</a></summary>
        <ul class="reading-tree-list" data-article-links>
          {articleItems.map(item => <li><div class="reading-tree-row"><span class="reading-tree-indicator reading-tree-placeholder" aria-hidden="true"><span class="reading-tree-symbol"></span></span><a class="reading-tree-link" href={`/guide/${item.slug}`} aria-current={item.slug === currentSlug && section === 'articles' ? 'page' : undefined}>{item.title}</a></div></li>)}
        </ul>
        <p class="article-directory-status reading-tree-link" role="status" hidden={articleItems.length > 0}>{t.guide.articleDirectoryEmpty}</p>
      </details>
    </nav>
  </details>
</aside>
<style>
.guide-section-group>summary{display:flex;align-items:center;list-style:none;cursor:pointer}
.guide-section-group>summary::-webkit-details-marker{display:none}
.guide-section-link{display:block;flex:1;padding:9px 8px;color:var(--color-base-content);font-size:14px;font-weight:650;border-radius:7px;text-decoration:none;cursor:pointer}
.guide-section-link:hover{background:var(--color-base-200)}
.guide-section-link[aria-current]{background:var(--color-brand-soft);color:var(--color-primary)}
.guide-section-group+.guide-section-group{margin-top:8px}
.article-directory-status{margin:6px 0 12px 24px}
.guide-section-group :global(>.reading-tree-list){margin:6px 0 12px 16px;padding-left:8px;border-left:1px solid var(--color-base-300)}
.guide-section-link:focus-visible{outline:2px solid var(--color-primary);outline-offset:2px}
</style>
