---
/*
文件说明: 统一公开站内页的紧凑页头、标题层级、操作区和可选返回链接。
*/
import { telemetryBlocks } from '../telemetry-blocks.js';
import PageBackLink from './PageBackLink.astro';

type Props = {
  title: string;
  description?: string;
  backHref?: string;
  backLabel?: string;
  titleId?: string;
  descriptionId?: string;
  heading?: 'h1' | 'h2';
  titleClass?: string;
  copyClass?: string;
};

const {
  title,
  description = '',
  backHref,
  backLabel = '',
  titleId,
  descriptionId,
  heading = 'h1',
  titleClass = '',
  copyClass = '',
} = Astro.props;

const HeadingTag = heading;
const hasAside = Astro.slots.has('aside');
const hasMeta = Astro.slots.has('meta');
const linkTo = Astro.locals.localizePath;
const backLinkHref = backHref ? linkTo(backHref) : '';

const titleClassName = ['page-hero-title', titleClass].filter(Boolean);
const copyClassName = ['page-hero-copy', copyClass].filter(Boolean);
---
<header data-telemetry-block={telemetryBlocks.shared.hero} class="page-heading">
  <div class:list={["page-hero-shell", hasMeta && "page-hero-with-metrics", hasAside && "page-hero-with-aside"]}>
    <div class="page-hero-main">
      {backLinkHref && backLabel && <PageBackLink href={backLinkHref} label={backLabel} />}
      <slot name="title"><HeadingTag id={titleId} class:list={titleClassName}>{title}</HeadingTag></slot>
      {description && <p id={descriptionId} class:list={copyClassName}>{description}</p>}
      <slot name="note" />
      <slot name="actions" />
    </div>
    {(hasAside || hasMeta) && <div class="page-hero-side"><slot name="aside" /><slot name="meta" /></div>}
  </div>
  <slot name="footer" />
</header>
