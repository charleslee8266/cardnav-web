---
/*
文件说明: 渲染公开站点 Markdown 内容页正文，供默认语言和带语言前缀的静态页面复用。
*/
import { telemetryBlocks } from '../telemetry-blocks.js';
import type { RenderedPageContent } from '../page-content.js';
import ArticleToc from './ArticleToc.astro';
import './content.css';

type Props = {
  content: RenderedPageContent;
};

const { content } = Astro.props;
---

<div class="reading-page" data-reading-layout>
<article id="page-article" data-telemetry-block={telemetryBlocks.content.article} class:list={[
  'content-page reading-article text-base-content/90',
  content.slug === 'partnership' && 'content-page--partnership',
]}>
  <Fragment set:html={content.html} />
</article>
<ArticleToc target="page-article" />
</div>
