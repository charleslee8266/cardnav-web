---
import { leaderboardFamilyPath } from '../models/routes.js';
import RelatedLink from './RelatedLink.astro';
import RefreshTime from './RefreshTime.astro';
import HeroMetric from './HeroMetric.astro';
/*
文件说明: 渲染官方订阅比价页的服务端 HTML 内容，包括套餐导航和当前套餐价格表。
*/
import { telemetryBlocks } from '../telemetry-blocks.js';
import './data-workspace.css';
import PageHero from './PageHero.astro';
import { officialPriceBaseline, officialPriceDifference } from '../official-price.js';
import OfficialPriceComparison from './OfficialPriceComparison.astro';
import './official-price.css';
import DataTable from './DataTable.astro';
import DataTableCell from './DataTableCell.astro';
import DataTableHeader from './DataTableHeader.astro';
import type { LocalizedOfficialPriceGroup } from '../localized-display.js';
import { defaultOfficialPricePlan, productForOfficialPrice, quickPlanProducts, quickPlanShortLabel, quickPlanHeroName, quickPlanGatewayFamilyName, quickPlanGatewayPath, quickPlanSearchSeoPath, quickPlanSearchTermForOfficialPriceSlug } from '../models/product-catalog.js';
import { productIconPath } from '../models/product-icons.js';
import Sponsors from './Sponsors.astro';
import type { PageType } from '../page-types.js';

type Props = {
  pageType: Extract<PageType, 'official-price' | 'official-price-detail'>;
  groups: LocalizedOfficialPriceGroup[];
  currentGroup: LocalizedOfficialPriceGroup | null;
  updatedAt: string | null;
};

const { pageType, groups, currentGroup, updatedAt } = Astro.props;
const t = Astro.locals.messages;
const linkTo = Astro.locals.localizePath;
const relatedShopSearchTerm = quickPlanSearchTermForOfficialPriceSlug(currentGroup?.urlSlug);
const relatedShopSearchPath = relatedShopSearchTerm ? linkTo(quickPlanSearchSeoPath(relatedShopSearchTerm)) : '';
const relatedGatewayPath = relatedShopSearchTerm ? quickPlanGatewayPath(relatedShopSearchTerm) : '';
const relatedGatewayTipPath = relatedGatewayPath ? linkTo(relatedGatewayPath) : '';
const relatedGatewayFamilyName = relatedShopSearchTerm ? quickPlanGatewayFamilyName(relatedShopSearchTerm) : '';

const productGroups = Array.from(new Set(groups.map(group => group.appSlug)), app => {
  const plans = groups.filter(group => group.appSlug === app);
  const product = productForOfficialPrice(app, plans[0].urlSlug);
  return { id: app, name: product?.label ?? plans[0].appName, product, plans, defaultPath: defaultOfficialPricePlan(plans)!.pathname };
}).sort((a, b) => {
  const order = (id: string) => { const i = quickPlanProducts.findIndex(p => p.id === id); return i < 0 ? 999 : i; };
  return order(a.product?.id ?? a.id) - order(b.product?.id ?? b.id);
});

const baseline = officialPriceBaseline(currentGroup?.prices ?? []);
const maximumPrice = Math.max(1, ...(currentGroup?.prices ?? []).map(price => price.cnyPrice));
const currentProduct = productGroups.find(product => product.id === currentGroup?.appSlug) || productGroups[0];

type CountryFlag = {
  emoji: string;
};

function countryFlag(countryCode: string): CountryFlag {
  const normalized = countryCode.trim().toUpperCase();
  const regionFlags: Record<string, string> = {
    HK: '🇭🇰',
    MO: '🇲🇴',
    TW: '🇨🇳',
  };
  if (regionFlags[normalized]) return { emoji: regionFlags[normalized] };
  if (!/^[A-Z]{2}$/.test(normalized)) return { emoji: '' };
  const emoji = [...normalized]
    .map(char => String.fromCodePoint(0x1F1E6 + char.charCodeAt(0) - 65))
    .join('');
  return { emoji };
}
---

<PageHero
  title={currentGroup ? `${quickPlanHeroName(relatedShopSearchTerm, currentGroup.displayName)} ${t.officialPrice.titleSuffix}` : t.officialPrice.title}
  description={t.officialPrice.heroDescription}
>
  {updatedAt && (
    <div slot="meta" class="hero-metrics"><HeroMetric label={t.labels.latestRefresh}><RefreshTime timestamp={updatedAt} fallback={t.labels.notRecorded} /></HeroMetric></div>
  )}
</PageHero>

<Sponsors placement="after-hero" pageType={pageType} />

{(groups.length > 0 || relatedShopSearchTerm || currentGroup) && (
  <section data-telemetry-block={telemetryBlocks.officialPrices.table} class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden data-workspace">
    {(groups.length > 0 || relatedShopSearchTerm) && (
      <div class="data-workspace-controls">
        <div class="data-workspace-control-stack">
          {groups.length > 0 && (
            <nav class="official-plan-groups" aria-label={t.officialPrice.navLabel}>
              <div class="official-brand-row">
                <a href={linkTo('/official-price')} class="plan-option plan-product">{t.shops.allPlans}</a>
                {productGroups.map(product => <a href={linkTo(product.defaultPath)} class="plan-option plan-product" aria-current={currentProduct?.id === product.id ? 'true' : undefined}>
                  {product.product?.icon ? <img src={productIconPath(product.product.icon)} alt="" width="18" height="18" class:list={['plan-brand-icon', product.product.monochrome && 'plan-icon-mono']} /> : <span class="plan-letter" aria-hidden="true">{product.product?.symbol || product.name.slice(0, 1)}</span>}
                  {product.name}
                </a>)}
              </div>
              {currentProduct && <div class="plan-group-options">
                <span class="plan-panel-label">{t.shops.productPlans.replace('{product}', currentProduct.name)}</span>
                <div class="plan-package-scroll">
                  {currentProduct.plans.map(group => {
                    const term = quickPlanSearchTermForOfficialPriceSlug(group.urlSlug);
                    return <a href={linkTo(group.pathname)} class="plan-option" aria-current={currentGroup?.key === group.key ? 'page' : undefined} aria-label={group.displayName}>
                      {term?.slug === group.urlSlug ? quickPlanShortLabel(term, currentProduct.product?.id ?? currentProduct.id) : group.planName}
                    </a>;
                  })}
                </div>
              </div>}
            </nav>
          )}
          {relatedShopSearchTerm && (
            <div class="data-workspace-related">
              {relatedGatewayTipPath && <RelatedLink href={relatedGatewayTipPath} label={t.officialPrice.gatewayTip.replace('{term}', relatedGatewayFamilyName)} target="_blank" data-umami-event="internal-link-click" data-umami-event-link-type="official-price-gateway-tip" data-umami-event-url={relatedGatewayTipPath} data-umami-event-name={relatedGatewayFamilyName} />}
              <RelatedLink href={relatedShopSearchPath} label={t.officialPrice.shopProductsTip.replace('{term}', relatedShopSearchTerm.label)} target="_blank" data-umami-event="internal-link-click" data-umami-event-link-type="official-price-shop-tip" data-umami-event-url={relatedShopSearchPath} data-umami-event-name={relatedShopSearchTerm.label} />
              {relatedShopSearchTerm.gatewayFamily && <RelatedLink href={linkTo(leaderboardFamilyPath(relatedShopSearchTerm.gatewayFamily))} label={t.shops.leaderboardTip.replace('{term}', relatedGatewayFamilyName)} />}

            </div>
          )}
        </div>
      </div>
    )}
    {currentGroup && (
      <>
        <div class="official-baseline-summary"><span>{t.officialPrice.baseline}</span>{baseline ? <><strong>{baseline.localizedCountryLabel} {baseline.priceText} {baseline.currencyCode}</strong><span>≈ {baseline.equivalentPriceText}</span></> : <span>{t.officialPrice.baselineUnavailable}</span>}</div>
        <DataTable
          variant="compact"
          emptyText={t.officialPrice.empty}
          emptyHidden={currentGroup.prices.length > 0}
        >
          <Fragment slot="head">
            <DataTableHeader label={t.labels.sequence} sortKey="sequence" sortType="number" align="center" />
            <DataTableHeader label={t.officialPrice.countryRegion} sortKey="country" sortType="text" />
            <DataTableHeader label={t.officialPrice.localPrice} helpTip={t.officialPrice.note} sortKey="price" sortType="number" />
            <DataTableHeader label={t.officialPrice.currency} sortKey="currency" sortType="text" />
            <DataTableHeader label={t.officialPrice.cnyPrice} helpTip={t.officialPrice.description} sortKey="equivalentPrice" sortType="number" />
            <DataTableHeader label={t.officialPrice.comparedToBaseline} sortKey="difference" sortType="number" align="right" />
          </Fragment>
          {currentGroup.prices.map((item, idx) => {
            const flag = countryFlag(item.countryCode);
            const difference = officialPriceDifference(item, baseline);
            return (
              <tr data-sort-difference={difference ?? ""} class:list={{ 'official-price-baseline': item === baseline }} data-sort-sequence={String(idx + 1)} data-sort-country={item.localizedCountryLabel} data-sort-price={item.priceValue} data-sort-currency={item.currencyCode} data-sort-equivalent-price={item.equivalentPrice}>
                <DataTableCell label={t.labels.sequence} align="center" sequence>{idx + 1}</DataTableCell>
                <DataTableCell label={t.officialPrice.countryRegion}>
                  <span class="official-region"><span class="official-region-flag" aria-hidden="true">{flag.emoji}</span><span><strong class="official-region-name">{item.localizedCountryLabel}{item === baseline && <span class="official-baseline-badge">{t.officialPrice.baseline}</span>}</strong><small class="official-price-secondary">{item.countryCode}</small></span></span>
                </DataTableCell>
                <DataTableCell label={t.officialPrice.localPrice} align="right">{item.priceText}</DataTableCell>
                <DataTableCell label={t.officialPrice.currency}><span class="official-price-secondary">{item.currencyCode}</span></DataTableCell>
                <DataTableCell label={t.officialPrice.cnyPrice} align="right"><span class="official-price-value">{item.equivalentPriceText}</span>{baseline && <span class:list={['official-price-meter', difference !== null && difference < -.05 && 'is-lower', difference !== null && difference > .05 && 'is-higher']} aria-hidden="true"><i style={`width:${item.cnyPrice / maximumPrice * 100}%`}></i><b style={`left:${baseline.cnyPrice / maximumPrice * 100}%`}></b></span>}</DataTableCell>
                <DataTableCell label={t.officialPrice.comparedToBaseline} align="right"><OfficialPriceComparison percent={difference} baseline={item === baseline} /></DataTableCell>
              </tr>
            );
          })}
        </DataTable>
      </>
    )}
  </section>
)}

{groups.length === 0 && (
  <section class="alert alert-info alert-soft max-w-md mx-auto my-6 justify-center">
    <span>{t.officialPrice.empty}</span>
  </section>
)}

<style>
  .official-plan-groups { display: grid; gap: 12px; min-width: 0; }
  .official-brand-row { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 2px; }
</style>
