---
/*
文件说明: 渲染公开页面共用的合作与赞赏商家 badge 和说明。
对应文档: docs/promo/cardnav-partner-offer.md
*/
import { randomUUID } from 'node:crypto';

type Props = {
  kind?: 'sponsor' | 'support';
  label: string;
  description: string;
  href: string;
  linkLabel: string;
};

const { kind = 'sponsor', label, description, href, linkLabel } = Astro.props;
const sentenceEnd = Astro.locals.messages.shops.submitTypeSentenceEnd;
const tooltipId = `merchant-disclosure-${randomUUID()}`;
---

<span class="merchant-badge-group">
  <span class="merchant-badge" data-kind={kind}>
    <span class="min-w-0 truncate">{label}</span>
    <button type="button" class="merchant-badge-info" popovertarget={tooltipId} aria-label={`${label} · ${description}`} aria-haspopup="dialog">i</button>
    <span id={tooltipId} class="merchant-badge-tooltip public-floating-layer" popover="auto" role="dialog" aria-label={label}>
      {description} <a href={href} class="merchant-badge-link" data-umami-event="internal-link-click" data-umami-event-link-type={kind === 'support' ? 'support-list' : 'sponsor-lead'} data-umami-event-url={href}>{linkLabel}</a>{sentenceEnd}
    </span>
  </span>
</span>
