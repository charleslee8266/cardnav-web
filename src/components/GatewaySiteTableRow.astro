---
/*
文件说明: 渲染中转站列表与模型详情页共用的中转站表格行，统一站点信息、赞助标签、评分列和操作入口。
*/
import ScoreDisplay from './ScoreDisplay.astro';
import DataTableCell from './DataTableCell.astro';
import MerchantBadge from './MerchantBadge.astro';

type DataAttrs = Record<string, string | number | boolean | undefined>;

type GatewaySite = {
  name: string;
  slug: string;
  url: string;
  outboundUrl: string;
  displayFamily?: string;
  summary?: string;
  modelCount?: number;
  priceCount?: number;
  siteScore?: number | null;
  sponsor?: boolean;
  supportTotalCents?: number;
  supportPoints?: number;
};

type Props = {
  site: GatewaySite;
  sequence: number;
  sequenceLabel: string;
  basicInfoLabel: string;
  sponsorLabel: string;
  sponsorDescription: string;
  sponsorHref: string;
  sponsorLinkLabel: string;
  detailLabel: string;
  openLabel: string;
  detailHref: string;
  clickAttrs?: DataAttrs;
  openAttrs?: DataAttrs;
  rowAttrs?: DataAttrs;
  sticky?: boolean;
  showScore?: boolean;
  scoreLabel?: string;
  scoreClass?: string;
  scoreAlign?: 'left' | 'center' | 'right';
};

const {
  site,
  sequence,
  sequenceLabel,
  basicInfoLabel,
  sponsorLabel,
  sponsorDescription,
  sponsorHref,
  sponsorLinkLabel,
  detailLabel,
  openLabel,
  detailHref,
  clickAttrs = {},
  openAttrs = {},
  rowAttrs = {},
  sticky = false,
  showScore = true,
  scoreLabel = '',
  scoreClass = 'font-mono',
  scoreAlign = 'right',
} = Astro.props;

const mergedRowAttrs = {
  ...rowAttrs,
  'data-gateway-site-key': site.slug,
  'data-sort-sequence': String(sequence),
  'data-sort-sticky': sticky ? '1' : '0',
  'data-sort-support': String(site.supportPoints || 0),
};
---

<tr {...mergedRowAttrs}>
  <DataTableCell label={sequenceLabel} align="center" sequence>{sequence}</DataTableCell>
  <DataTableCell label={basicInfoLabel}>
    <div class="data-entity-cell">
      <button type="button" class="favorite-toggle" data-gateway-favorite={site.slug} data-site-name={site.name} aria-label={`${Astro.locals.messages.shops.merchantFavorite} ${site.name}`} aria-pressed="false"><span aria-hidden="true">♡</span></button>
      <div class="data-entity-content">
        <div class="data-entity-copy">
          <div class="merchant-header">

            <div class="merchant-header-content">
              <div class="merchant-title-row gap-2">
                <a data-row-primary href={detailHref} class="merchant-link" {...clickAttrs}>{site.name}</a>
              {(site.sponsor || (site.supportPoints || 0) > 0) ? <>
                {site.sponsor ? <MerchantBadge label={sponsorLabel} description={sponsorDescription} href={sponsorHref} linkLabel={sponsorLinkLabel} /> : null}
                {(site.supportPoints || 0) > 0 ? <MerchantBadge kind="support" label={Astro.locals.messages.support.badgeLabel} description={Astro.locals.messages.support.badgeDescription} href={Astro.locals.localizePath('/supporters')} linkLabel={Astro.locals.messages.support.amountLinkLabel} /> : null}
              </> : null}
              </div>
            </div>
          </div>
          {site.summary ? <p class="data-entity-description">{site.summary}</p> : null}
          <div class="text-xs text-base-content/55"><span class="break-all">{site.url}</span></div>
          {site.priceCount === 0 && <p class="text-xs text-base-content/45">{site.modelCount ? Astro.locals.messages.llmGateway.dataStatusLabels.noPrice : Astro.locals.messages.llmGateway.dataStatusLabels.noData}</p>}
          {(site.supportPoints || 0) > 0 && <div class="data-support-inline">{Astro.locals.messages.support.amountColumn} <strong>{site.supportPoints?.toLocaleString(Astro.locals.locale, { maximumFractionDigits: 2 })}</strong></div>}
        </div>
        <div class="data-entity-actions">
          <a href={detailHref} class="data-entity-action" {...clickAttrs}>{detailLabel}</a>
          <a href={site.outboundUrl} target="_blank" rel={site.sponsor || (site.supportPoints || 0) > 0 ? "noopener noreferrer sponsored" : "noopener noreferrer"} class="data-entity-action" {...openAttrs}>{openLabel}<svg class="gateway-external-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M14 3h7v7M21 3l-10 10M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5" /></svg></a>
        </div>
      </div>
    </div>
  </DataTableCell>
  {showScore ? <DataTableCell label={scoreLabel} align={scoreAlign} class={scoreClass}><ScoreDisplay value={site.siteScore} /></DataTableCell> : null}
  <slot />
</tr>
