---
/** 文件说明: 渲染合作商家主入口与附加链接，并标注独立点击采集身份。 */
import type { Sponsor, SponsorPlacement } from '../sponsor-provider.js';
type Props = { sponsors: Sponsor[]; placement?: SponsorPlacement; example?: boolean };
const { sponsors, placement = 'page-bottom', example = false } = Astro.props;
const t = Astro.locals.messages;
const MainTag = example ? 'div' : 'a';
---
  <ul class="sponsor-grid">
    {sponsors.map(sponsor => (
      <li class="sponsor-grid-item">
        <article class="sponsor-card">
          <MainTag {...(!example ? { href: sponsor.url, target: "_blank", rel: "nofollow sponsored noopener noreferrer", "data-sponsor-click-id": sponsor.id, "data-sponsor-link-kind": "main", "data-umami-event": "external-link-click", "data-umami-event-link-type": "sponsor", "data-umami-event-name": sponsor.id, "data-umami-event-link-id": sponsor.id, "data-umami-event-url": sponsor.url } : {})} class:list={[sponsor.template === 'grid' ? 'sponsor-plan-main-link' : 'sponsor-main-link', 'group']}>
            {sponsor.image.src && <span
              class="sponsor-logo-frame"
              style={sponsor.image.padding || sponsor.image.backgroundColor
                ? `--sponsor-padding: ${sponsor.image.padding ?? '0'}; --sponsor-background-color: ${sponsor.image.backgroundColor ?? 'white'};`
                : undefined}
            >
              {sponsor.image.src && <img src={sponsor.image.src} alt={sponsor.image.alt} loading={placement === 'after-hero' ? 'eager' : 'lazy'} class="sponsor-logo" data-sponsor-image data-scale-mode={sponsor.image.scaleMode} />}
              <span class="sponsor-image-fallback" aria-hidden="true">{sponsor.title}</span>
            </span>}
            <span class="sponsor-text">
            {sponsor.template === 'grid'
              ? (
                <span class="sponsor-plan-title">
                  <span class="sponsor-plan-name">{sponsor.title}</span>
                  <span class="sponsor-plan-price">{sponsor.description}</span>
                </span>
              )
              : (
                <>
                  <span class="sponsor-name">{sponsor.title}</span>
                  <span class="sponsor-copy">{sponsor.description}</span>
                </>
              )}
            </span>
          </MainTag>
          {placement === 'after-hero' && sponsor.description && <details class="sponsor-mobile-details"><summary>{t.sponsors.details}</summary><p>{sponsor.description}</p></details>}
          {sponsor.template === 'grid' && sponsor.links.length > 0 && (
            <div class="sponsor-plan-grid">
              {sponsor.links.map(link => (
                <a href={link.url} data-sponsor-click-id={!example ? sponsor.id : undefined} data-sponsor-link-kind={!example ? "extra" : undefined} target="_blank" rel="nofollow sponsored noopener noreferrer" data-umami-event="external-link-click" data-umami-event-link-type="sponsor" data-umami-event-name={sponsor.id} data-umami-event-link-id={sponsor.id} data-umami-event-url={link.url} class="sponsor-plan-link">{link.text}</a>
              ))}
            </div>
          )}
        </article>
      </li>
    ))}
  </ul>
