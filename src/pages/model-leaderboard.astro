---
/*
文件说明: 渲染 CardNav 模型排行榜默认入口，服务端优先展示编程榜。
*/
import ModelLeaderboardContent from '../components/ModelLeaderboardContent.astro';
import { localizeModelLeaderboardGroups } from '../localized-display.js';
import PublicPage from '../layouts/PublicPage.astro';
import { buildModelLeaderboardGroupsForActiveTask } from '../model-leaderboard.js';
import { buildSeoContext } from '../seo.js';
import { publicSiteUrl } from '../site.js';
import { loadModelLeaderboardStats, loadModelLeaderboardRowsForTaskPage, loadModelLeaderboardTaskSlugs } from '../store.js';

const activeTaskSlug = 'coding';
const family = Astro.url.searchParams.getAll('family');
const initialRowCount = 30;
const [taskSlugs, stats] = await Promise.all([loadModelLeaderboardTaskSlugs(), loadModelLeaderboardStats()]);
const activePage = await loadModelLeaderboardRowsForTaskPage(activeTaskSlug, { limit: initialRowCount });
const activeRows = activePage.rows;
const groups = localizeModelLeaderboardGroups(
  buildModelLeaderboardGroupsForActiveTask(taskSlugs, activeRows, activeTaskSlug),
  Astro.locals.messages,
);
const currentGroup = groups.find(group => group.taskSlug === activeTaskSlug) || groups[0] || null;
const latestFetchedAt = activePage.latestFetchedAt;

const seo = buildSeoContext({
  baseUrl: publicSiteUrl,
  pathname: '/model-leaderboard',
  title: Astro.locals.messages.leaderboard.seoTitle,
  description: Astro.locals.messages.leaderboard.seoDescription,
  imagePath: '/og-cardnav.webp',
  type: 'webpage',
  locale: Astro.locals.locale,
});
---

<PublicPage activeNav="model-leaderboard" pageType="model-leaderboard" {...seo}>
  <ModelLeaderboardContent providers={Astro.url.searchParams.getAll('provider')} query={Astro.url.searchParams.get('q') || ''} family={family} stats={stats} pageType="model-leaderboard" groups={groups} currentGroup={currentGroup} currentGroupTotalCount={activePage.totalCount} updatedAt={latestFetchedAt} />
  <script>
    import '../scripts/data-table.js';
    import '../scripts/deferred-table-core.js';
    import '../scripts/page-widgets.js';
  </script>
</PublicPage>
