---
import { gatewayModelPath } from '../models/routes.js';
/*
文件说明: 渲染 CardNav 公开首页，按卡片模块展示模型、订阅价格、热门产品和卡网商家入口。
*/
import { telemetryBlocks } from '../telemetry-blocks.js';
import PublicPage from '../layouts/PublicPage.astro';
import ShopPlanGroups from '../components/ShopPlanGroups.astro';
import Sponsors from '../components/Sponsors.astro';
import { localizeModelLeaderboardGroups, localizeOfficialPriceGroups } from '../localized-display.js';
import { buildModelLeaderboardGroups } from '../model-leaderboard.js';
import { buildOfficialPriceGroups, matchOfficialPriceCatalogEntries } from '../official-price.js';
import Icon from '../components/Icon.astro';
import ModelFamilyLabel from '../components/ModelFamilyLabel.astro';
import RefreshTime from '../components/RefreshTime.astro';
import { productForOfficialPrice } from '../models/product-catalog.js';
import { productIconPath } from '../models/product-icons.js';
import { buildSeoContext } from '../seo.js';
import { publicSiteUrl } from '../site.js';
import {
  loadShopProductsData,
  loadOfficialPriceStats,
  loadModelLeaderboardStats,
  loadModelLeaderboardRowsForTask,
  loadModelLeaderboardTaskSlugs,
  loadOfficialPriceCatalog,
  loadOfficialPricesByUrlSlug,
  loadGatewayModels,
  loadGatewaySites,
  type PublicModelLeaderboardRow,
  type PublicOfficialPriceRow,
} from '../store.js';

const t = Astro.locals.messages;
const linkTo = Astro.locals.localizePath;
const preferredOfficialPlans = [
  { app: 'chatgpt', plan: 'plus' },
  { app: 'gpt', plan: 'pro-200' },
  { app: 'gpt', plan: 'pro-500' },
  { app: 'claude', plan: 'pro' },
  { app: 'claude', plan: '20x' },
];
const [shopProductsData, officialPriceCatalog, leaderboardTaskSlugs, gatewayData, gatewayModelData, officialPriceStats, leaderboardStats] = await Promise.all([
  loadShopProductsData({ productLimit: 5 }),
  loadOfficialPriceCatalog(),
  loadModelLeaderboardTaskSlugs(),
  loadGatewaySites(),
  loadGatewayModels({ sort: 'popular' }),
  loadOfficialPriceStats(),
  loadModelLeaderboardStats(),
]);
const matchedOfficialEntries = matchOfficialPriceCatalogEntries(officialPriceCatalog, preferredOfficialPlans);
const officialPrices: PublicOfficialPriceRow[] = [];
for (const entry of matchedOfficialEntries) {
  officialPrices.push(...await loadOfficialPricesByUrlSlug(entry.urlSlug));
}
const leaderboardRows: PublicModelLeaderboardRow[] = [];
for (const taskSlug of leaderboardTaskSlugs) {
  leaderboardRows.push(...await loadModelLeaderboardRowsForTask(taskSlug));
}

const seo = buildSeoContext({
  baseUrl: publicSiteUrl,
  pathname: '/',
  title: t.home.seoTitle,
  description: t.home.seoDescription,
  imagePath: '/og-cardnav.webp',
  type: 'website',
  enableSiteSearch: true,
  locale: Astro.locals.locale,
});

const guideSourcePage = '/';

const pathCards = [
  { title: t.home.gatewayPathTitle, feature: t.nav.llmGateway, description: t.home.gatewayPathShortDescription, href: '/llm-gateway', icon: 'server' },
  { title: t.home.shopPathTitle, feature: t.nav.shops, description: t.home.shopPathShortDescription, href: '/market', icon: 'store' },
  { title: t.home.officialPathTitle, feature: t.nav.officialPrice, description: t.home.officialPathShortDescription, href: '/official-price', icon: 'tag' },
  { title: t.home.leaderboardPathTitle, feature: t.nav.modelLeaderboard, description: t.home.leaderboardPathShortDescription, href: '/model-leaderboard', icon: 'trophy' },
  { title: t.home.guidePathTitle, feature: t.nav.guide, description: t.home.guidePathShortDescription, href: '/guide', icon: 'book' },
] as const;

const toolCards = [
  {
    title: t.tools.ipPurity.title,
    description: t.tools.ipPurity.description,
    href: '/tools/ip-purity',
  },
  {
    title: t.tools.sessionConverter.title,
    description: t.tools.sessionConverter.description,
    href: '/tools/session-converter',
  },
];

const guideHighlightSteps: Array<{ title: string; href: string }> = t.home.guideSteps;

const officialPriceGroups = localizeOfficialPriceGroups(
  buildOfficialPriceGroups(officialPrices),
  Astro.locals.locale,
);
const officialPriceGroupByKey = new Map(officialPriceGroups.map(group => [group.key, group]));
const officialPriceHighlights = matchedOfficialEntries
  .map(entry => officialPriceGroupByKey.get(`${entry.appSlug}:${entry.planSlug}`))
  .filter((group): group is (typeof officialPriceGroups)[number] => Boolean(group && group.prices.length > 0))
  .map(group => ({
    title: group.displayName,
    href: group.pathname,
    product: productForOfficialPrice(group.appSlug, group.urlSlug),
    prices: group.prices.slice(0, 3).map(price => ({
      country: price.localizedCountryLabel,
      localPrice: price.priceText,
      equivalentPrice: price.equivalentPriceText,
    })),
  }));

const modelHighlightGroups = localizeModelLeaderboardGroups(
  buildModelLeaderboardGroups(leaderboardRows),
  t,
)
  .map(group => ({
    title: group.displayName,
    href: group.pathname,
    rows: group.rows.slice(0, 5).map(row => ({
      rank: row.rank,
      modelName: row.modelName,
      score: row.score,
    })),
  }));

const gatewayHighlights = gatewayData.sites.slice(0, 5).map(site => ({
  title: site.name,
  providers: site.displayModelFamilies.slice(0, 3),
  meta: site.host,
  value: site.modelCount > 0 ? t.home.gatewayModelCountLabel.replace('{count}', String(site.modelCount)) : t.home.noGatewayModelData,
  href: `/llm-gateway/${site.slug}`,
}));

const gatewayModelHighlights = gatewayModelData.models.slice(0, 5).map(model => ({
  title: model.modelId,
  providers: model.modelFamily ? [model.modelFamily] : [],
  meta: '',
  value: t.home.gatewaySupportCountLabel.replace('{count}', String(model.supportSiteCount)),
  href: gatewayModelPath(model.modelId),
}));

const productHighlights = shopProductsData.products.slice(0, 5).map(product => ({
  title: product.name,
  meta: `${product.siteName} · ${product.categoryName}`,
  value: typeof product.priceNumber === 'number' && product.priceUnit
    ? `${product.priceUnit}${String(product.priceNumber)}`
    : product.price,
  href: `/market?q=${encodeURIComponent(product.name)}`,
}));

function guideUrlClickAttrs(targetPage: string) {
  const localizedTargetPage = linkTo(targetPage);
  return {
    'data-umami-event': 'internal-link-click',
    'data-umami-event-link-type': 'guide',
    'data-umami-event-source-page': linkTo(guideSourcePage),
    'data-umami-event-target-page': localizedTargetPage,
    'data-umami-event-url': localizedTargetPage,
  };
}

function homeCtaClickAttrs(targetPage: string, name: string) {
  const localizedTargetPage = linkTo(targetPage);
  return {
    'data-umami-event': 'internal-link-click',
    'data-umami-event-link-type': 'home-cta',
    'data-umami-event-name': name,
    'data-umami-event-target-page': localizedTargetPage,
    'data-umami-event-url': localizedTargetPage,
  };
}

---

<PublicPage activeNav="home" pageType="home" {...seo}>
  <section class="home-hero" data-telemetry-block={telemetryBlocks.shared.hero}>
    <h1><span class="home-brand"><img src="/favicon.webp" alt="" width="56" height="56" /><span class="home-brand-name">{t.site.name}</span><span class="home-brand-domain">cardnav.xyz</span></span><span class="home-tagline">{t.site.tagline}</span></h1>
    <p class="home-lead">{Astro.locals.locale === 'zh' ? t.site.heroDescription.split(/(?=还有)/).map((line: string, index: number) => <>{index > 0 && <br />}{line}</>) : t.site.heroDescription}</p>
    {Astro.locals.locale === 'zh' && <p class="home-search-tip">小知识：卡网是什么？通常是销售卡密、账号等虚拟商品的网站。</p>}
    <form action={linkTo('/market')} method="get" class="home-search" data-home-search-form data-telemetry-block={telemetryBlocks.home.search}>
      <Icon name="search" />
      <input name="q" type="search" placeholder={t.home.searchPlaceholder} aria-label={t.home.searchPlaceholder} autocomplete="off" data-home-search-input />
      <button type="submit" class="btn btn-primary">{t.actions.search}</button>
    </form>
    <div class="home-hot-terms"><ShopPlanGroups mode="navigate" productLimit={8} initialSearchQuery="" officialPriceUrlSlugs={new Set<string>()} /></div>
    <div class="home-stat-line">
      <a href={linkTo('/market?tab=shops')}>{t.labels.collectedSites}<b>{shopProductsData.totalSiteCount.toLocaleString(Astro.locals.locale)}</b></a>
      <a href={linkTo('/market')}>{t.labels.products}<b>{shopProductsData.totalProductCount.toLocaleString(Astro.locals.locale)}</b></a>
      <a href={linkTo('/llm-gateway')}>{t.nav.mobileLlmGateway}<b>{gatewayData.totalSiteCount.toLocaleString(Astro.locals.locale)}</b></a>
      <a href={linkTo('/official-price')}>{t.home.subscriptionPlans}<b>{officialPriceStats.productCount.toLocaleString(Astro.locals.locale)}</b></a>
      <a href={linkTo('/model-leaderboard')}>{t.home.modelLeaderboard}<b>{leaderboardStats.modelCount.toLocaleString(Astro.locals.locale)}</b></a>
      {shopProductsData.latestRefreshedAt && <span>{t.labels.latestRefresh}<b><RefreshTime timestamp={shopProductsData.latestRefreshedAt} /></b></span>}
    </div>
  </section>
  <Sponsors placement="after-hero" pageType="home" />
  <nav class="home-paths" aria-label={t.home.quickNavTitle} data-telemetry-block={telemetryBlocks.home.quickNavigation}>
    {pathCards.map(card => <a href={linkTo(card.href)} class="home-path" {...homeCtaClickAttrs(card.href, card.title)}>
      <div class="home-path-feature"><span class="home-path-icon"><Icon name={card.icon} /></span><span>{card.feature}</span></div><div class="home-path-copy"><b>{card.title}</b><span>{card.description}</span></div>
    </a>)}
  </nav>
  <section class="home-highlights" aria-labelledby="home-highlights-title" data-telemetry-block={telemetryBlocks.home.highlights}>
    <h2 id="home-highlights-title">{t.home.highlightsTitle}</h2>
    <div class="home-highlight-grid">
      <article class="home-panel" data-telemetry-block={telemetryBlocks.home.shops}>
        <header class="home-panel-header"><h3>{t.home.productHighlightsTitle}</h3><a class="home-more" href={linkTo('/market')} {...homeCtaClickAttrs('/market', t.actions.openShops)}>{t.actions.openShops}<Icon name="right" /></a></header>
        <ul class="home-highlight-list">{productHighlights.map(item => <li><a href={linkTo(item.href)} {...homeCtaClickAttrs(item.href, item.title)}><span class="home-row-title">{item.title}<small>{item.meta}</small></span><span class="home-row-price">{item.value}</span></a></li>)}</ul>
        {!productHighlights.length && <p class="home-empty">{t.shops.script.noData}</p>}
      </article>
      <article class="home-panel" data-telemetry-block={telemetryBlocks.home.officialPrices}>
        <header class="home-panel-header"><h3>{t.home.officialHighlightsTitle}</h3><a class="home-more" href={linkTo('/official-price')} {...homeCtaClickAttrs('/official-price', t.actions.openPricePage)}>{t.actions.openPricePage}<Icon name="right" /></a></header>
        <ul class="home-highlight-list">{officialPriceHighlights.map(group => <li><a href={linkTo(group.href)} {...homeCtaClickAttrs(group.href, group.title)}>{group.product?.icon && <img src={productIconPath(group.product.icon)} width="20" height="20" alt="" class:list={['home-product-icon', group.product.monochrome && 'home-product-icon-mono']} />}<span class="home-row-title">{group.title}<small>{group.prices[0].country}</small></span><span class="home-price-pair"><span class="home-row-price">{group.prices[0].equivalentPrice}</span><span class="home-original-price">{group.prices[0].localPrice}</span></span></a></li>)}</ul>
        {!officialPriceHighlights.length && <p class="home-empty">{t.officialPrice.empty}</p>}
      </article>
      <article class="home-panel" data-home-tabs data-telemetry-block={telemetryBlocks.home.gateways}>
        <header class="home-panel-header"><h3>{t.home.gatewayHighlightsTitle}</h3><div class="home-segment" role="group" aria-label={t.home.gatewayHighlightsTitle}>
          <button type="button" data-home-tab="gateway-sites" aria-controls="gateway-sites" aria-pressed="true">{t.llmGateway.siteView}</button>
          <button type="button" data-home-tab="gateway-models" aria-controls="gateway-models" aria-pressed="false">{t.llmGateway.modelView}</button>
        </div><a class="home-more" href={linkTo('/llm-gateway')} {...homeCtaClickAttrs('/llm-gateway', t.home.openGateway)}>{t.home.openGateway}<Icon name="right" /></a></header>
        {[{id:'gateway-sites', rows:gatewayHighlights}, {id:'gateway-models', rows:gatewayModelHighlights}].map((group, index) => <div id={group.id} data-home-panel hidden={index !== 0}>
          <ul class="home-highlight-list">{group.rows.map(item => <li><a href={linkTo(item.href)} {...homeCtaClickAttrs(item.href, item.title)}><span class="home-row-title">{item.title}</span><span class="home-gateway-detail"><span class="home-row-value">{item.value}</span><span class="home-row-providers">{item.providers.map(provider => <ModelFamilyLabel name={provider} />)}</span></span></a></li>)}</ul>
          {!group.rows.length && <p class="home-empty">{t.llmGateway.empty}</p>}
        </div>)}
      </article>
      <article class="home-panel" data-home-tabs data-telemetry-block={telemetryBlocks.home.models}>
        <header class="home-panel-header"><h3>{t.home.modelHighlightsTitle}</h3><div class="home-segment" role="group" aria-label={t.home.modelHighlightsTitle}>{modelHighlightGroups.map((group,index) => <button type="button" data-home-tab={`home-ranking-${index}`} aria-controls={`home-ranking-${index}`} aria-pressed={index === 0}>{group.title}</button>)}</div><a class="home-more" href={linkTo('/model-leaderboard')} {...homeCtaClickAttrs('/model-leaderboard', t.actions.viewFullLeaderboard)}>{t.actions.viewFullLeaderboard}<Icon name="right" /></a></header>
        {modelHighlightGroups.map((group,index) => <div id={`home-ranking-${index}`} data-home-panel hidden={index !== 0}><ul class="home-highlight-list">{group.rows.map(row => <li><a href={linkTo(group.href)} {...homeCtaClickAttrs(group.href, group.title)}><span class="home-rank" data-first={row.rank === 1}>{row.rank}</span><span class="home-row-title">{row.modelName}</span><span class="home-row-value">{row.score.toLocaleString(Astro.locals.locale, { maximumFractionDigits: 1 })}</span></a></li>)}</ul></div>)}
        {!modelHighlightGroups.length && <p class="home-empty">{t.leaderboard.empty}</p>}
      </article>
    </div>
    <div class="home-help-strip">
      <section data-telemetry-block={telemetryBlocks.home.guide}>
        <header><Icon name="book" /><h3>{t.home.buyingGuideTitle}</h3><a class="home-more" href={linkTo('/guide')} {...guideUrlClickAttrs('/guide')}>{t.actions.openGuide}<Icon name="right" /></a></header>
        <div class="home-guide-steps">{guideHighlightSteps.map((step,index) => <a href={linkTo(step.href)} {...guideUrlClickAttrs(step.href)}><span>{index+1}</span>{step.title}</a>)}</div>
      </section>
      <section data-telemetry-block={telemetryBlocks.home.tools}>
        <header><Icon name="tool" /><h3>{t.home.toolsTitle}</h3><a class="home-more" href={linkTo('/tools')} {...homeCtaClickAttrs('/tools',t.actions.openTools)}>{t.actions.openTools}<Icon name="right" /></a></header>
        <div class="home-tools">{toolCards.map(tool => <a href={linkTo(tool.href)} {...homeCtaClickAttrs(tool.href,tool.title)}><b>{tool.title}</b><span>{tool.description}</span></a>)}</div>
      </section>
    </div>
  </section>
  <script is:inline slot="scripts" type="application/json" id="home-search-config" set:html={JSON.stringify({ shopsPath: linkTo('/market') })}></script>
  <script>import '../scripts/page-widgets.js';</script>
</PublicPage>
<script>
  document.querySelectorAll('[data-home-tabs]').forEach(group => {
    group.querySelectorAll<HTMLButtonElement>('[data-home-tab]').forEach(button => {
      button.addEventListener('click', () => {
        group.querySelectorAll<HTMLButtonElement>('[data-home-tab]').forEach(tab => tab.setAttribute('aria-pressed', String(tab === button)));
        group.querySelectorAll<HTMLElement>('[data-home-panel]').forEach(panel => { panel.hidden = panel.id !== button.dataset.homeTab; });
      });
    });
  });
</script>
