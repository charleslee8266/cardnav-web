---
import Icon from '../components/Icon.astro';
/*
文件说明: 渲染 CardNav 卡网商家页，提供第三方商家和商品的搜索、筛选与排序能力。
*/
import { telemetryBlocks } from '../telemetry-blocks.js';
import ShopPlanGroups from '../components/ShopPlanGroups.astro';
import ShopSubmitDialog from '../components/ShopSubmitDialog.astro';
import OpenShopLink from '../components/OpenShopLink.astro';
import SupportDialog from '../components/SupportDialog.astro';
import FilterPopover from '../components/FilterPopover.astro';
import PageHero from '../components/PageHero.astro';
import RefreshTime from '../components/RefreshTime.astro';
import HeroMetric from '../components/HeroMetric.astro';
import PublicPage from '../layouts/PublicPage.astro';
import DataTable from '../components/DataTable.astro';
import DataTableHeaderControl from '../components/DataTableHeaderControl.astro';
import DataTableHeader from '../components/DataTableHeader.astro';
import { officialPricePathname } from '../official-price.js';
import { buildSeoContext } from '../seo.js';
import { quickPlanHeroName, quickPlanDisplayName, quickPlanGatewayFamilyName, quickPlanGatewayPath, quickPlanSearchSeoPath, type QuickPlanSearchTerm } from '../shop-plan-search.js';
import { buildShopSearchPageMeta } from '../shop-search-page-meta.js';
import pageWidgetsScriptUrl from '../scripts/page-widgets.js?url';
import { publicSiteUrl } from '../site.js';
import shopsMerchantViewScriptUrl from '../scripts/shops-merchant-view.js?url';
import Sponsors from '../components/Sponsors.astro';
import type { PageType } from '../page-types.js';
import { packShopProductsData } from '../shop-products-data.js';
import { loadOfficialPriceCatalog, loadShopProductsData } from '../store.js';

type Props = {
  seoSearchTerm?: QuickPlanSearchTerm | null;
  pageType?: PageType;
};

const initialProductLimitValue = 100;
const t = Astro.locals.messages;
const linkTo = Astro.locals.localizePath;
const requestUrl = new URL(Astro.request.url);
const seoSearchTerm = Astro.props.seoSearchTerm ?? null;
const pageType = Astro.props.pageType ?? (seoSearchTerm ? 'shop-keyword' : 'shops');
const initialSearchQuery = seoSearchTerm?.query ?? requestUrl.searchParams.get('q')?.trim() ?? '';
const initialFuzzySearch = requestUrl.searchParams.get('fuzzy') === '1';
const seoSearchPageMeta = seoSearchTerm
  ? buildShopSearchPageMeta(quickPlanDisplayName(seoSearchTerm), {
      searchResultsTitle: t.shops.searchResultsTitle,
      searchResultsDescription: t.shops.searchResultsDescription,
    }, quickPlanHeroName(seoSearchTerm))
  : null;
const pageTitle = seoSearchPageMeta?.pageTitle ?? t.shops.seoTitle;
const pageDescription = seoSearchPageMeta?.pageDescription ?? t.shops.seoDescription;
const heroTitle = seoSearchPageMeta?.heroTitle ?? t.shops.title;
const heroDescription = seoSearchTerm ? t.shops.searchResultsHeroDescription.replace('{term}', quickPlanHeroName(seoSearchTerm)) : t.shops.heroDescription;
const seoPathname = seoSearchTerm ? quickPlanSearchSeoPath(seoSearchTerm) : '/shops';
const hasNonCanonicalQuery = !seoSearchTerm && requestUrl.search.length > 0;
const data = await loadShopProductsData({ productLimit: initialProductLimitValue, inStockOnly: true });
const officialPriceCatalog = await loadOfficialPriceCatalog();
const officialPriceUrlSlugs = new Set(officialPriceCatalog.map(entry => entry.urlSlug.trim()).filter(Boolean));
const initialOfficialPricePath = seoSearchTerm?.officialPriceSlug && officialPriceUrlSlugs.has(seoSearchTerm.officialPriceSlug)
  ? linkTo(officialPricePathname(seoSearchTerm.officialPriceSlug))
  : '';
const initialOfficialPriceTipLabel = initialOfficialPricePath
  ? t.shops.officialPriceTip.replace('{term}', seoSearchTerm?.label ?? '')
  : '';
const initialGatewayPath = seoSearchTerm ? quickPlanGatewayPath(seoSearchTerm) : '';
const initialGatewayTipPath = initialGatewayPath ? linkTo(initialGatewayPath) : '';
const initialGatewayTipLabel = initialGatewayTipPath
  ? t.shops.gatewayTip.replace('{term}', seoSearchTerm ? quickPlanGatewayFamilyName(seoSearchTerm) : '')
  : '';
const hasInitialQuickPlanTip = Boolean(initialOfficialPricePath || initialGatewayTipPath);
const renderedProducts = data.products.map(product => ({
  id: product.id,
  categoryName: product.categoryName,
  name: product.name,
  priceNumber: typeof product.priceNumber === 'number' ? product.priceNumber : null,
  priceUnit: typeof product.priceUnit === 'string' ? product.priceUnit : null,
  productUrl: product.productUrl,
  stock: product.stock,
  inStock: product.inStock,
  refreshedAt: product.refreshedAt || null,
  refreshTime: product.refreshTime || '',
  siteId: product.siteId || '',
  siteName: product.siteName || '',
  siteUrl: product.siteUrl || '',
  siteProductRefreshSuccessAt: product.siteProductRefreshSuccessAt || null,
  siteProductRefreshSuccessTime: product.siteProductRefreshSuccessTime || '',
  siteScore: product.siteScore || 0,
  score: product.score || 0,
}));
const shopBreadcrumbs = seoSearchTerm
  ? [
      { name: t.shops.title, pathname: '/shops' },
      { name: seoSearchTerm.label, pathname: seoPathname },
    ]
  : [{ name: t.shops.title, pathname: '/shops' }];
const shopListItems = renderedProducts.slice(0, 20).map((product, index) => ({
  name: `${product.categoryName} - ${product.name}`,
  url: product.productUrl,
  position: index + 1,
}));
const seo = buildSeoContext({
  baseUrl: publicSiteUrl,
  pathname: seoPathname,
  title: pageTitle,
  description: pageDescription,
  imagePath: '/og-cardnav.webp',
  type: 'webpage',
  noindex: hasNonCanonicalQuery,
  breadcrumbs: shopBreadcrumbs,
  listItems: shopListItems,
  locale: Astro.locals.locale,
});
const normalSeo = buildSeoContext({
  baseUrl: publicSiteUrl,
  pathname: '/shops',
  title: t.shops.seoTitle,
  description: t.shops.seoDescription,
  imagePath: '/og-cardnav.webp',
  type: 'website',
  locale: Astro.locals.locale,
});

const shopsScriptMessages = {
  selfHosted: t.shops.selfHosted,
  loading: t.labels.loading,
  clearFilters: t.shops.clearFilters,
  autoCategoryTip: t.shops.autoCategoryTip,
  displaySummary: t.shops.script.displaySummary,
  merchantDisplaySummary: t.shops.script.merchantDisplaySummary,
  stockPrefix: t.shops.script.stockPrefix,
  latestRefreshPrefix: t.shops.script.latestRefreshPrefix,
  noData: t.shops.script.noData,
  officialPriceTip: t.shops.officialPriceTip,
  gatewayTip: t.shops.gatewayTip,
  hotProductsTitle: t.shops.hotProductsTitle,
  searchResultsTitle: t.shops.searchResultsTitle,
  searchResultsDescription: t.shops.searchResultsDescription,
  searchResultsHeroDescription: t.shops.searchResultsHeroDescription,
  titleSuffix: t.seo.titleSuffix,
  ascending: t.shops.script.ascending,
  descending: t.shops.script.descending,
  currentSort: t.shops.script.currentSort,
  clickSort: t.shops.script.clickSort,
  merchantViewScriptUrl: shopsMerchantViewScriptUrl,
  productFavorite: t.shops.productFavorite,
  merchantFavorite: t.shops.merchantFavorite,
  cancelProductFavorite: t.shops.cancelProductFavorite,
  cancelMerchantFavorite: t.shops.cancelMerchantFavorite,
  supportTotalLabel: t.support.amountColumn,
  supportLabel: t.support.badgeLabel,
  supportDescription: t.support.badgeDescription,
  supportersUrl: linkTo('/supporters?support-dialog'),
  supportLinkLabel: t.support.amountLinkLabel,
  sponsorLabel: t.sponsors.sponsorLabel,
  sponsorDescription: t.sponsors.sponsorDescription,
  partnershipUrl: linkTo('/partnership'),
  partnershipLinkLabel: t.sponsors.partnershipLinkLabel,
  inStock: t.labels.inStock,
  soldOut: t.labels.soldOut,
  defaultPageTitle: normalSeo.pageTitle,
  defaultHeroTitle: t.shops.title,
  defaultHeroDescription: t.shops.heroDescription,
  shopsPath: linkTo('/shops'),
  seoSearchQuery: seoSearchTerm?.query ?? '',
  seoSearchPath: seoSearchTerm ? linkTo(quickPlanSearchSeoPath(seoSearchTerm)) : '',
  searchPlaceholder: t.shops.searchPlaceholder,
  tableLabels: {
    sequence: t.labels.sequence,
    product: t.labels.product,
    platform: t.shops.platform,
    price: t.labels.price,
    stock: t.labels.stock,
    category: t.labels.category,
    autoCategory: t.labels.autoCategory,
    merchant: t.labels.merchant,
    merchantScore: t.labels.merchantScore,
    productScore: t.labels.productScore,
    productCount: t.labels.productCount,
    latestRefresh: t.labels.latestRefresh,
  },
};
type SortColumn = {
  key: string;
  type: 'text' | 'number';
  label: string;
  tip?: string;
  tipLabel?: string;
  helpHref?: string;
  helpLinkLabel?: string;
};
const flatSortColumns: SortColumn[] = [
  { key: 'productName', type: 'text', label: t.labels.product },
  { key: 'priceValue', type: 'number', label: t.labels.price },
  { key: 'stockValue', type: 'number', label: t.labels.stock },
  { key: 'score', type: 'number', label: t.labels.productScore, tip: t.shops.productScoreTip, tipLabel: t.shops.productScoreHelpLabel },
  { key: 'platformName', type: 'text', label: t.shops.platform, tip: t.shops.platformHint, helpHref: linkTo('/guide/choose-reliable-merchant'), helpLinkLabel: t.shops.guideTitle },
  { key: 'siteName', type: 'text', label: t.labels.merchant },
  { key: 'productRefreshedAt', type: 'number', label: t.labels.latestRefresh },
] satisfies SortColumn[];
const rightAlignedProductColumns = new Set(['priceValue', 'stockValue']);
const merchantTabLabel = t.labels.merchant;
const merchantSortColumns: SortColumn[] = [
  { key: 'siteName', type: 'text', label: t.labels.merchant },
  { key: 'productCount', type: 'number', label: t.labels.productCount },
  { key: 'hotProducts', type: 'number', label: t.shops.hotProductsTitle },
  { key: 'siteScore', type: 'number', label: t.labels.merchantScore, tip: t.shops.merchantScoreTip, tipLabel: t.shops.merchantScoreHelpLabel },
  { key: 'lastProductRefreshSuccessAt', type: 'number', label: t.labels.latestRefresh },
] satisfies SortColumn[];
const rightAlignedMerchantColumns = new Set(['productCount']);
const shopProductsJsonValue = JSON.stringify(packShopProductsData({
  ...data,
  initialProductLimit: initialProductLimitValue,
})).replace(/[<>&\u2028\u2029]/g, character => ({
  '<': '\\u003c',
  '>': '\\u003e',
  '&': '\\u0026',
  '\u2028': '\\u2028',
  '\u2029': '\\u2029',
})[character] || character);
---

<PublicPage activeNav="shops" pageType={pageType} {...seo}>
  <PageHero
    title={heroTitle}
    description={heroDescription}
    titleId="shopPageHeroTitle"
    descriptionId="shopPageHeroDescription"
  >
    <div slot="meta" class="hero-metrics">
      <HeroMetric label={t.shops.listedMerchants} value={data.totalSiteCount.toLocaleString(Astro.locals.locale)} />
      <HeroMetric label={t.shops.listedProducts} value={data.totalProductCount.toLocaleString(Astro.locals.locale)} />
      <HeroMetric label={t.labels.latestRefresh}><RefreshTime timestamp={data.latestRefreshedAt} fallback={t.labels.notRecorded} /></HeroMetric>
    </div>
    <div slot="aside" class="data-page-actions">
      <button id="openShopSubmitModal" type="button" class="btn btn-primary btn-sm"
        data-umami-event="button-click" data-umami-event-action="open-submit" data-umami-event-scope="shops" data-umami-event-name={t.shops.submitMerchant}>
        {t.shops.submitMerchant}
      </button>
      <a href="?support-dialog" data-open-support data-telemetry-block={telemetryBlocks.support.entry} class="btn support-button btn-sm"><span aria-hidden="true">♥</span> {t.support.button}</a>
      <OpenShopLink class="btn open-shop-button btn-sm" />
    </div>
  </PageHero>

  <Sponsors placement="after-hero" pageType={pageType} />

  <aside class="data-workspace-guide" data-telemetry-block={telemetryBlocks.shops.guide}>
    <a class="purchase-guide-link" href={linkTo('/guide/choose-reliable-merchant')}><Icon name="circle-alert" class="purchase-guide-icon" /><strong>{t.shops.guideTitle}</strong><span aria-hidden="true">→</span></a>
    <span class="purchase-guide-description">{t.shops.guideDescription}</span>
  </aside>

  <section id="shopsExplorer" class="card bg-base-100 border border-base-300 shadow-sm data-workspace" data-shop-tabs>
      <form id="filters" class="data-workspace-controls" method="get" action={linkTo('/shops')}>
        <div class="data-workspace-toolbar">
        <div class="data-segmented" role="tablist" aria-label={t.shops.title}>
          <button type="button" class="tab tab-active" role="tab" aria-selected="true" aria-controls="flatProductView" id="shopProductsTab" data-shop-tab="products">
            {t.labels.products}
            <span class="tool-tab-badge">{data.totalProductCount}</span>
          </button>
          <button type="button" class="tab" role="tab" aria-selected="false" aria-controls="merchantGroupedView" id="shopMerchantsTab" data-shop-tab="merchants">
            {merchantTabLabel}
            <span class="tool-tab-badge">{data.totalSiteCount}</span>
          </button>
        </div>
          <div class="relative data-workspace-search" data-shop-control="products">
            <input id="searchFilter" name="q" value={initialSearchQuery} class="input input-bordered w-full pr-11" placeholder={t.shops.searchPlaceholder} aria-label={t.shops.searchPlaceholder} autocomplete="off" />
            <button id="advancedSearchHelp" type="button" class="inline-help-button absolute right-3 top-1/2 -translate-y-1/2" aria-label={t.shops.advancedSearchLabel} data-inline-help data-tip-wide data-tip={t.shops.advancedSearchTip}>i</button>
          </div>
          <div class="data-workspace-search" data-shop-control="merchants" hidden><input id="merchantSearchFilter" name="merchantQ" value="" class="input input-bordered w-full" placeholder={t.shops.merchantSearchPlaceholder} aria-label={t.shops.merchantSearchPlaceholder} autocomplete="off" /></div>
          <div data-shop-control="products"><FilterPopover id="searchOptions" label={t.shops.filterOptions} doneLabel={t.shops.done}>
            <fieldset class="data-filter-group">
              <legend>{t.labels.price} <button id="priceFilterHelp" type="button" class="inline-help-button" aria-label={t.shops.priceFilterHint} data-inline-help data-tip={t.shops.priceFilterHint}>i</button></legend>
              <div class="data-filter-price">
                <input id="priceMin" name="priceMin" type="number" min="0" step="0.01" inputmode="decimal" class="input input-bordered input-sm" placeholder={t.shops.minPrice} aria-label={`${t.labels.price} · ${t.shops.minPrice}`} autocomplete="off" />
                <span>–</span>
                <input id="priceMax" name="priceMax" type="number" min="0" step="0.01" inputmode="decimal" class="input input-bordered input-sm" placeholder={t.shops.maxPrice} aria-label={`${t.labels.price} · ${t.shops.maxPrice}`} autocomplete="off" />
              </div>
            </fieldset>
            <fieldset class="data-filter-group">
              <legend>{t.shops.searchScope}</legend>
              <label><input id="matchCategoryFilter" name="matchCategory" value="1" type="checkbox" class="checkbox checkbox-primary checkbox-xs" /><span>{t.shops.matchCategory}</span></label>
              <label><input id="fuzzySearchFilter" name="fuzzy" value="1" type="checkbox" class="checkbox checkbox-primary checkbox-xs" checked={initialFuzzySearch} /><span>{t.shops.fuzzySearch}</span></label>
            </fieldset>
            <fieldset class="data-filter-group">
              <legend>{t.shops.displayOptions}</legend>
              <label><input id="showSoldOutFilter" name="showSoldOut" value="1" type="checkbox" class="checkbox checkbox-primary checkbox-xs" /><span>{t.shops.showSoldOut}</span></label>
              <label><input id="onlyPlatformFilter" type="checkbox" class="checkbox checkbox-primary checkbox-xs" /><span>{t.shops.onlyPlatform}</span></label>
              <label><input id="onlyFavoritesFilter" type="checkbox" class="checkbox checkbox-primary checkbox-xs" /><span>{t.shops.onlyFavorites}</span></label>
            </fieldset>
            <button slot="footer" id="resetShopFilters" type="button" class="btn btn-sm btn-ghost">{t.shops.clearFilters}</button>
          </FilterPopover></div>
          <div data-shop-control="merchants" hidden><FilterPopover id="merchantOptions" label={t.shops.filterOptions} doneLabel={t.shops.done}><label><input id="merchantPlatformFilter" type="checkbox" class="checkbox checkbox-primary checkbox-xs" /><span>{t.shops.onlyPlatform}</span></label>
              <label class="data-filter-switch"><input id="merchantFavoritesFilter" type="checkbox" class="checkbox checkbox-primary checkbox-xs" /><span>{t.shops.onlyFavorites}</span></label></FilterPopover></div>
          <select id="shopSortSelect" data-shop-control="products" class="select select-bordered data-workspace-sort" aria-label={t.shops.sort}>
            <option value="">{t.shops.defaultSort}</option>
            <option value="priceValue:asc">{t.shops.priceAsc}</option>
            <option value="stockValue:desc">{t.shops.stockDesc}</option>
            <option value="productRefreshedAt:desc">{t.shops.refreshDesc}</option>
            <option value="custom" hidden>{t.shops.headerSort}</option>
          </select>
        </div>
        <div data-shop-control="products" id="shopActiveFilters" class="data-active-filters" aria-live="polite" hidden></div>
        <div data-shop-control="products"><ShopPlanGroups initialSearchQuery={initialSearchQuery} officialPriceUrlSlugs={officialPriceUrlSlugs} /></div>
        <div data-shop-control="products" id="quickPlanTips" class:list={['flex flex-wrap items-center gap-2', !hasInitialQuickPlanTip && 'hidden']}>
          <a
            id="gatewayTip"
            href={initialGatewayTipPath || '#'}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              initialGatewayTipPath ? 'inline-flex' : 'hidden',
              'data-crosslink',
            ]}
            data-umami-event="internal-link-click" data-umami-event-link-type="quick-plan-gateway-tip"
            data-umami-event-url={initialGatewayTipPath || undefined}
            data-umami-event-name={initialGatewayTipPath && seoSearchTerm ? quickPlanGatewayFamilyName(seoSearchTerm) : undefined}
          >
            <span data-gateway-tip-label>{initialGatewayTipLabel}</span>
            <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
          <a
            id="officialPriceTip"
            href={initialOfficialPricePath || '#'}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              initialOfficialPricePath ? 'inline-flex' : 'hidden',
              'data-crosslink',
            ]}
            data-umami-event="internal-link-click" data-umami-event-link-type="quick-plan-official-price-tip"
            data-umami-event-url={initialOfficialPricePath || undefined}
            data-umami-event-name={initialOfficialPricePath ? seoSearchTerm?.label : undefined}
          >
            <span data-official-price-tip-label>{initialOfficialPriceTipLabel}</span>
            <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
        </div>
        <div id="merchantActiveFilters" data-shop-control="merchants" class="data-active-filters" hidden></div>
      </form>
    <div id="flatProductView" role="tabpanel" aria-labelledby="shopProductsTab" data-shop-panel="products" data-telemetry-block={telemetryBlocks.shops.products}>

      <DataTable
        variant="shopProducts"
        tbodyId="flatProductRows"
        emptyId="productEmptyState"
        emptyText={t.shops.productEmptyState}
        loadMoreId="flatProductProgressiveLoad"
        loadingId="flatProductLoadSummary"
        loadingText={t.labels.loading}
        loadMoreButtonId="flatProductLoadMoreButton"
        loadMoreText={t.labels.loadMore}
        loadMoreButtonHidden
      >
        <Fragment slot="head">
          <DataTableHeader label={t.labels.sequence} sortKey="sequence" sortType="number" sortScope="products" align="center" />
          {flatSortColumns.map(column => (
            <DataTableHeader
              label={column.label}
              sortKey={column.key}
              sortType={column.type}
              sortScope="products"
              title={`${column.label}${t.shops.sortTitleSuffix}`}
              statusText={t.shops.clickSort}
              align={rightAlignedProductColumns.has(column.key) ? 'right' : 'left'}
              helpTip={column.tip}
              helpLabel={column.tipLabel}
              helpHref={column.helpHref}
              helpLinkLabel={column.helpLinkLabel}
            />
          ))}
        </Fragment>
      </DataTable>
    </div>

    <div id="merchantGroupedView" role="tabpanel" aria-labelledby="shopMerchantsTab" data-shop-panel="merchants" data-telemetry-block={telemetryBlocks.shops.merchants} hidden>

      <div class="product-table-scroll merchant-table-scroll">
        <div class="merchant-table">
          <div class="merchant-table-head">
            <div class="merchant-table-head-cell merchant-table-head-index data-table-head-cell data-table-head-cell-static data-table-head-align-center" data-column-key="sequence">
              <div class="data-table-head-content"><span class="data-table-head-label">{t.labels.sequence}</span></div>
            </div>
            {merchantSortColumns.map(column => (
              <div class:list={['merchant-table-head-cell', 'data-table-head-cell', 'data-table-head-cell-sortable', rightAlignedMerchantColumns.has(column.key) && 'data-table-head-align-right', column.tip && 'data-table-head-with-help']} aria-sort="none">
                <DataTableHeaderControl
                  label={column.label}
                  sortKey={column.key}
                  sortType={column.type}
                  sortScope="merchants"
                  title={`${column.label}${t.shops.sortTitleSuffix}`}
                  statusText={t.shops.clickSort}
                  helpTip={column.tip}
                  helpLabel={column.tipLabel}
              helpHref={column.helpHref}
              helpLinkLabel={column.helpLinkLabel}
                  helpClass="merchant-score-help"
                />
              </div>
            ))}
          </div>
          <div id="merchantRows"></div>
          <section id="merchantEmptyState" class="data-table-empty-state hidden" aria-live="polite">
            <p>{t.shops.merchantEmptyState}</p>
          </section>
        </div>
      </div>
      <section id="merchantProgressiveLoad" class="data-table-footer hidden">
        <p id="merchantLoadSummary" class="data-table-loading hidden"></p>
        <button id="merchantLoadMoreButton" type="button" class="btn btn-outline btn-sm hidden">{t.labels.loadMore}</button>
      </section>
    </div>
  </section>

  <SupportDialog returnPage="shops" />
  <ShopSubmitDialog />

  <script is:inline type="application/json" id="shop-products-data" set:html={shopProductsJsonValue}></script>
  <script is:inline type="application/json" id="shops-messages" set:html={JSON.stringify(shopsScriptMessages)}></script>
  <script is:inline slot="scripts" defer src={pageWidgetsScriptUrl}></script>
  <script>
    import '../scripts/index.js';
  </script>
</PublicPage>
