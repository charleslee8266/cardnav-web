---
/*
文件说明: 渲染单个模型排行榜任务的独立 SSR URL。
*/
import ModelLeaderboardContent from '../../components/ModelLeaderboardContent.astro';
import { localizeModelLeaderboardGroups } from '../../localized-display.js';
import PublicPage from '../../layouts/PublicPage.astro';
import { buildModelLeaderboardGroupsForActiveTask } from '../../model-leaderboard.js';
import { buildSeoContext } from '../../seo.js';
import { publicSiteUrl } from '../../site.js';
import { formatBeijingRefreshTime, loadModelLeaderboardRowsForTaskPage, loadModelLeaderboardTaskSlugs } from '../../store.js';

const taskSlug = Astro.params.slug || '';
const initialRowCount = 30;
const taskSlugs = await loadModelLeaderboardTaskSlugs();
const activePage = await loadModelLeaderboardRowsForTaskPage(taskSlug, { limit: initialRowCount });
const activeRows = activePage.rows;
const groups = localizeModelLeaderboardGroups(
  buildModelLeaderboardGroupsForActiveTask(taskSlugs, activeRows, taskSlug),
  Astro.locals.messages,
);
const currentGroup = groups.find(group => group.taskSlug === taskSlug) || null;

if (!currentGroup) return Astro.redirect(Astro.locals.localizePath('/model-leaderboard'), 302);

const latestFetchedAt = activePage.latestFetchedAt;
const updateTime = latestFetchedAt ? formatBeijingRefreshTime(latestFetchedAt) : Astro.locals.messages.labels.notRecorded;

const seo = buildSeoContext({
  baseUrl: publicSiteUrl,
  pathname: currentGroup.pathname,
  title: `${currentGroup.displayName}${Astro.locals.messages.leaderboard.titleSuffix}`,
  description: Astro.locals.messages.leaderboard.dynamicDescription.replace('{taskLabel}', currentGroup.displayName),
  imagePath: '/og-cardnav.webp',
  type: 'webpage',
  breadcrumbs: [
    { name: Astro.locals.messages.nav.modelLeaderboard, pathname: '/model-leaderboard' },
    { name: currentGroup.displayName, pathname: currentGroup.pathname },
  ],
  locale: Astro.locals.locale,
});
---

<PublicPage activeNav="model-leaderboard" pageType="model-leaderboard-detail" {...seo}>
  <ModelLeaderboardContent pageType="model-leaderboard-detail" groups={groups} currentGroup={currentGroup} currentGroupTotalCount={activePage.totalCount} updateTime={updateTime} />
  <script>
    import '../../scripts/data-table.js';
    import '../../scripts/deferred-table-core.js';
    import '../../scripts/page-widgets.js';
  </script>
</PublicPage>
