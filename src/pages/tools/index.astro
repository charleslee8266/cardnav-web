---
/*
文件说明: 渲染 CardNav 公开工具集合页，作为多个小工具的统一入口。
*/
import { telemetryBlocks } from '../../telemetry-blocks.js';
import '../../components/tools.css';
import PageHero from '../../components/PageHero.astro';
import Sponsors from '../../components/Sponsors.astro';
import PublicPage from '../../layouts/PublicPage.astro';
import { buildSeoContext } from '../../seo.js';
import { publicSiteUrl } from '../../site.js';

const linkTo = Astro.locals.localizePath;
const t = Astro.locals.messages;
const tools = [
  { title: t.tools.sessionConverter.title, description: t.tools.sessionConverter.description, href: '/tools/session-converter', badge: t.labels.localConvert, icon: 'M4 7h16m-4-4 4 4-4 4M20 17H4m4-4-4 4 4 4', external: false },
  { title: t.tools.ipPurity.title, description: t.tools.ipPurity.description, href: '/tools/ip-purity', badge: t.labels.onlineCheck, icon: 'M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Z M8 12l3 3 5-6', external: false },
  { title: t.tools.outlookMail.title, description: t.tools.outlookMail.description, href: 'https://mail.chatai.codes/', badge: t.labels.externalSite, icon: 'M3 5h18v14H3V5Zm0 1 9 7 9-7', external: true },
];
const seo = buildSeoContext({
  baseUrl: publicSiteUrl,
  pathname: '/tools',
  title: t.tools.seoTitle,
  description: t.tools.seoDescription,
  imagePath: '/og-cardnav.webp',
  type: 'webpage',
  locale: Astro.locals.locale,
});
---

<PublicPage activeNav="tools" pageType="tools" {...seo}>
  <PageHero title={t.tools.title} description={t.tools.heroDescription} />
  <Sponsors placement="after-hero" pageType="tools" />

  <section data-telemetry-block={telemetryBlocks.tools.list} class="tools-catalog">
    {tools.map(tool => <article class="tool-entry card">
      <div class="tool-entry-top">
        <span class="tool-entry-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={tool.icon} /></svg></span>
        <span class:list={['badge badge-sm', tool.external ? 'badge-warning badge-soft' : 'badge-ghost']}>{tool.badge}</span>
      </div>
      <h2>{tool.title}</h2>
      <p>{tool.description}</p>
      {tool.external && <p class="tool-entry-risk">{t.tools.externalRisk}</p>}
      <div class="tool-entry-actions">
        <a href={tool.external ? tool.href : linkTo(tool.href)} target={tool.external ? '_blank' : undefined} rel={tool.external ? 'noopener noreferrer' : undefined} data-umami-event={tool.external ? 'external-link-click' : 'internal-link-click'} data-umami-event-link-type="tool-entry" data-umami-event-name={tool.title} data-umami-event-target-page={tool.external ? undefined : linkTo(tool.href)} data-umami-event-url={tool.external ? tool.href : linkTo(tool.href)} class:list={['btn btn-sm', !tool.external && 'btn-primary']}>
          {tool.external ? t.actions.openExternalTool : t.actions.openTool}<span aria-hidden="true">{tool.external ? '↗' : '→'}</span>
        </a>
        {tool.external && <span class="tool-entry-host">{new URL(tool.href).hostname}</span>}
      </div>
    </article>)}
  </section>
</PublicPage>
