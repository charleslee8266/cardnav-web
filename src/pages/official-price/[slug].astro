---
/*
文件说明: 渲染单个官方订阅套餐的独立 SSR 比价 URL。
*/
import OfficialPriceContent from '../../components/OfficialPriceContent.astro';
import { localizeOfficialPriceGroups } from '../../localized-display.js';
import PublicPage from '../../layouts/PublicPage.astro';
import { buildOfficialPriceGroupsForActiveSlug, resolveOfficialPriceSlug } from '../../official-price.js';
import { canonicalOfficialPriceSlug, grokWebSubscription, quickPlanDisplayName, quickPlanSearchTermForOfficialPriceSlug } from '../../models/product-catalog.js';
import { buildSeoContext } from '../../seo.js';
import { publicSiteUrl } from '../../site.js';
import { loadOfficialPriceCatalog, loadOfficialPricesByUrlSlug } from '../../store.js';

const requestedSlug = Astro.params.slug || '';
const canonicalSlug = canonicalOfficialPriceSlug(requestedSlug);
if (canonicalSlug !== requestedSlug) return Astro.redirect(Astro.locals.localizePath(`/official-price/${canonicalSlug}`) + Astro.url.search, 301);
const catalog = await loadOfficialPriceCatalog();
const activePrices = await loadOfficialPricesByUrlSlug(requestedSlug);
const groups = localizeOfficialPriceGroups(
  buildOfficialPriceGroupsForActiveSlug(catalog, activePrices, requestedSlug),
  Astro.locals.locale,
);
const currentGroup = resolveOfficialPriceSlug(requestedSlug, groups);

if (!currentGroup) return Astro.redirect(Astro.locals.localizePath('/official-price'), 302);
if (Astro.params.slug !== currentGroup.urlSlug) return Astro.redirect(Astro.locals.localizePath(currentGroup.pathname) + Astro.url.search, 301);

const latestFetchedAt = activePrices.reduce<string | null>((latest, price) => {
  if (!price.fetchedAt) return latest;
  if (!latest) return price.fetchedAt;
  return new Date(price.fetchedAt).getTime() > new Date(latest).getTime() ? price.fetchedAt : latest;
}, null);

const isWebPlan = grokWebSubscription.plans.some(plan => plan.slug === currentGroup.urlSlug);
const seoDisplayName = quickPlanDisplayName(quickPlanSearchTermForOfficialPriceSlug(currentGroup.urlSlug), currentGroup.displayName);
const seo = buildSeoContext({
  baseUrl: publicSiteUrl,
  pathname: currentGroup.pathname,
  title: `${seoDisplayName} ${Astro.locals.messages.officialPrice.titleSuffix}`,
  description: (isWebPlan ? Astro.locals.messages.officialPrice.webPlanDescription : Astro.locals.messages.officialPrice.dynamicDescription).replace('{displayName}', seoDisplayName),
  imagePath: '/og-cardnav.webp',
  type: 'webpage',
  breadcrumbs: [
    { name: Astro.locals.messages.nav.officialPrice, pathname: '/official-price' },
    { name: currentGroup.displayName, pathname: currentGroup.pathname },
  ],
  locale: Astro.locals.locale,
});
---

<PublicPage activeNav="official-price" pageType="official-price-detail" {...seo}>
  <OfficialPriceContent pageType="official-price-detail" groups={groups} currentGroup={currentGroup} updatedAt={latestFetchedAt} />
  <script>
    import '../../scripts/data-table.js';
  </script>
</PublicPage>
