---
/*
文件说明: 渲染 AI 大模型 API 中转站入口页，通过中转站和模型两个标签页展示排行并支持本地加载更多。
*/
import PageHero from '../components/PageHero.astro';
import PublicPage from '../layouts/PublicPage.astro';
import GatewaySiteTableRow from '../components/GatewaySiteTableRow.astro';
import DataTable from '../components/DataTable.astro';
import DataTableCell from '../components/DataTableCell.astro';
import DataTableHeader from '../components/DataTableHeader.astro';
import {
  collectFilterOptions,
  paymentIcon,
  paymentLabel,
  uniqueLabels,
} from '../gateway-display.js';
import { buildSeoContext } from '../seo.js';
import { publicSiteUrl, telegramGroupUrl } from '../site.js';
import { loadGatewayModels, loadGatewaySites } from '../store.js';
import dataTableScriptUrl from '../scripts/data-table.js?url';
import sponsorBadgeScriptUrl from '../scripts/sponsor-badge.js?url';

const t = Astro.locals.messages;
const linkTo = Astro.locals.localizePath;
const GATEWAY_SITE_PAGE_SIZE = 20;
const GATEWAY_MODEL_PAGE_SIZE = 100;
const gatewayData = await loadGatewaySites({ limit: GATEWAY_SITE_PAGE_SIZE });
const gatewayModelData = await loadGatewayModels({ limit: GATEWAY_MODEL_PAGE_SIZE });
const topSites = gatewayData.sites;
const topModels = gatewayModelData.models;
const seo = buildSeoContext({
  baseUrl: publicSiteUrl,
  pathname: '/llm-gateway',
  title: t.llmGateway.seoTitle,
  description: t.llmGateway.seoDescription,
  imagePath: '/og-cardnav.png',
  type: 'website',
  locale: Astro.locals.locale,
});

const paymentMethodLabels = t.llmGateway.paymentMethodLabels;
const paymentLabelFor = (key: string) => paymentLabel(key, paymentMethodLabels);

function modelHref(modelId: string) {
  return linkTo(`/llm-gateway/models/${encodeURIComponent(modelId)}`);
}

function gatewaySiteClickAttrs(site: { name: string; slug: string; outboundUrl: string }) {
  const targetPage = linkTo(`/llm-gateway/${site.slug}`);
  return {
    'data-umami-event': 'gateway-site-click',
    'data-umami-event-name': site.name,
    'data-umami-event-target-page': targetPage,
    'data-umami-event-url': targetPage,
  };
}

function gatewaySiteOpenAttrs(site: { name: string; outboundUrl: string }) {
  return {
    'data-umami-event': 'gateway-site-open-click',
    'data-umami-event-name': site.name,
    'data-umami-event-url': site.outboundUrl,
  };
}

function gatewayModelClickAttrs(model: { modelId: string; modelFamily: string }) {
  const targetPage = modelHref(model.modelId);
  return {
    'data-umami-event': 'gateway-model-click',
    'data-umami-event-name': model.modelId,
    'data-umami-event-family': model.modelFamily,
    'data-umami-event-target-page': targetPage,
    'data-umami-event-url': targetPage,
  };
}

function isStickyGatewaySite(site: { sponsor?: boolean }) {
  return Boolean(site.sponsor);
}

const modelFilterOptions = collectFilterOptions(gatewayData.sites.map(site => site.displayModelFamilies));
const paymentFilterOptions = collectFilterOptions(gatewayData.sites.map(site => site.paymentMethods));
const hasMoreSites = gatewayData.totalSiteCount > topSites.length;
const hasMoreModels = gatewayModelData.totalModelCount > topModels.length;
const gatewayHomeConfig = {
  gatewayLinkPrefix: linkTo('/llm-gateway'),
  modelLinkPrefix: linkTo('/llm-gateway/models'),
  sitePageSize: GATEWAY_SITE_PAGE_SIZE,
  modelPageSize: GATEWAY_MODEL_PAGE_SIZE,
  siteTotalCount: gatewayData.totalSiteCount,
  modelTotalCount: gatewayModelData.totalModelCount,
  displaySummary: t.labels.displaySummary,
  sitesApi: `/api/llm-gateway/sites.json?offset=${GATEWAY_SITE_PAGE_SIZE}&locale=${encodeURIComponent(Astro.locals.locale)}`,
  modelsApi: `/api/llm-gateway/models.json?offset=${GATEWAY_MODEL_PAGE_SIZE}&locale=${encodeURIComponent(Astro.locals.locale)}`,
  detailLabel: t.llmGateway.viewDetail,
  openLabel: t.actions.open,
  sequenceLabel: t.labels.sequence,
  basicInfoLabel: t.llmGateway.basicInfo,
  sponsorLabel: t.sponsors.sponsorLabel,
  sponsorDescription: t.sponsors.sponsorDescription,
  partnershipUrl: linkTo('/partnership'),
  partnershipLinkLabel: t.sponsors.partnershipLinkLabel,
  scoreLabel: t.labels.score,
  supportedModelsLabel: t.llmGateway.supportedModels,
  modelCountLabel: t.llmGateway.modelCount,
  paymentMethodsLabel: t.llmGateway.paymentMethods,
  paymentMethodLabels: t.llmGateway.paymentMethodLabels,
  modelLabel: t.labels.model,
  modelFamilyLabel: t.llmGateway.modelFamily,
  supportedGatewayCountLabel: t.llmGateway.supportedGatewayCount,
};
---

<PublicPage activeNav="llm-gateway" {...seo}>
  <PageHero title={t.llmGateway.title} description={t.llmGateway.description}>
    <p slot="note" class="page-hero-note">
      {t.llmGateway.notePrefix}
      <a href={telegramGroupUrl} target="_blank" rel="noopener noreferrer" class="link link-primary font-medium" data-umami-event="gateway-report-click" data-umami-event-url={telegramGroupUrl} data-umami-event-name={t.llmGateway.reportIssue}>{t.llmGateway.reportIssue}</a>
      {t.llmGateway.noteSuffix}
    </p>
    <div slot="aside" class="stats stats-vertical sm:stats-horizontal border border-base-300 bg-base-100 shadow-none">
      <div class="stat px-4 py-3">
        <div class="stat-title text-xs">{t.llmGateway.listedSites}</div>
        <div class="stat-value text-2xl text-primary">{gatewayData.totalSiteCount}</div>
      </div>
      <div class="stat px-4 py-3">
        <div class="stat-title text-xs">{t.llmGateway.sitesWithPrices}</div>
        <div class="stat-value text-2xl text-secondary">{gatewayData.sitesWithPricesCount}</div>
      </div>
      <div class="stat px-4 py-3">
        <div class="stat-title text-xs">{t.llmGateway.modelRecords}</div>
        <div class="stat-value text-2xl">{gatewayModelData.totalModelCount}</div>
      </div>
    </div>
  </PageHero>

  {gatewayData.sites.length === 0 ? (
    <section class="alert alert-warning shadow-sm max-w-md mx-auto my-6 justify-center">
      <span>{t.llmGateway.empty}</span>
    </section>
  ) : (
    <section class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden" data-gateway-home>
      <div class="border-b border-base-300 bg-base-100 px-4 py-3">
        <div class="tool-tablist-wrap">
          <div class="tabs tabs-box gateway-home-tablist" role="tablist" aria-label={t.llmGateway.title}>
            <button type="button" class="tab tab-active" role="tab" aria-selected="true" aria-controls="gatewaySitesPanel" id="gatewaySitesTab" data-gateway-tab="sites">
              {t.llmGateway.gatewayListTitle}
              <span class="tool-tab-badge">{gatewayData.totalSiteCount}</span>
            </button>
            <button type="button" class="tab" role="tab" aria-selected="false" aria-controls="gatewayModelsPanel" id="gatewayModelsTab" data-gateway-tab="models">
              {t.llmGateway.modelListTitle}
              <span class="tool-tab-badge">{gatewayModelData.totalModelCount}</span>
            </button>
          </div>
        </div>
      </div>

      <div id="gatewaySitesPanel" class="flex w-full min-w-0 flex-col gap-0" role="tabpanel" aria-labelledby="gatewaySitesTab" data-gateway-panel="sites">
          <div class="gateway-filter-grid grid gap-3 border-b border-base-300 p-4 md:grid-cols-[minmax(0,1fr)_180px_180px]">
            <label class="input input-bordered flex h-11 items-center gap-2">
              <input data-home-site-search type="search" class="grow text-sm" placeholder={t.llmGateway.searchPlaceholder} />
            </label>
            <select data-home-site-family class="select select-bordered h-11 min-h-11 text-sm" aria-label={t.llmGateway.familyFilter}>
              <option value="">{t.llmGateway.allFamilies}</option>
              {modelFilterOptions.map(model => <option value={model.toLowerCase()}>{model}</option>)}
            </select>
            <select data-home-site-payment class="select select-bordered h-11 min-h-11 text-sm" aria-label={t.llmGateway.paymentFilter}>
              <option value="">{t.llmGateway.allPaymentMethods}</option>
              {paymentFilterOptions.map(method => <option value={method}>{paymentLabelFor(method)}</option>)}
            </select>
          </div>
          <DataTable
            variant="gatewaySites"
            tbodyDataAttrs={{ 'data-gateway-home-sites-list': '' }}
            emptyText={t.llmGateway.filterEmpty}
            emptyDataAttrs={{ 'data-home-site-empty': '' }}
            loadingText={t.labels.loading}
            loadingDataAttrs={{ 'data-gateway-loading': 'sites' }}
            summaryText={t.labels.displaySummary}
            summaryRenderedCount={topSites.length}
            summaryDataAttrs={{ 'data-gateway-load-summary': 'sites' }}
            totalCount={gatewayData.totalSiteCount}
            loadMoreText={hasMoreSites ? t.labels.loadMore : ''}
            loadMoreHidden={!hasMoreSites}
            loadMoreDataAttrs={{ 'data-gateway-load-more': 'sites' }}
            stickySortKey="sticky"
          >
            <Fragment slot="head">
              <DataTableHeader label={t.labels.sequence} sortKey="sequence" sortType="number" align="center" />
              <DataTableHeader label={t.llmGateway.basicInfo} sortKey="name" />
              <DataTableHeader label={t.labels.score} sortKey="score" sortType="number" align="right" helpTip={t.llmGateway.gatewayScoreTip} helpLabel={t.llmGateway.gatewayScoreHelpLabel} />
              <DataTableHeader label={t.llmGateway.supportedModels} sortKey="families" />
              <DataTableHeader label={t.llmGateway.modelCount} sortKey="modelCount" sortType="number" align="right" />
              <DataTableHeader label={t.llmGateway.paymentMethods} sortKey="payments" />
            </Fragment>
            {topSites.map((site, index) => {
              const families = uniqueLabels(site.displayModelFamilies, 8);
              const paymentMethods = uniqueLabels(site.paymentMethods, 6);
              const rank = index + 1;
              return (
                <GatewaySiteTableRow
                  site={site}
                  sequence={rank}
                  sequenceLabel={t.labels.sequence}
                  basicInfoLabel={t.llmGateway.basicInfo}
                  sponsorLabel={t.sponsors.sponsorLabel}
                  sponsorDescription={t.sponsors.sponsorDescription}
                  sponsorHref={linkTo('/partnership')}
                  sponsorLinkLabel={t.sponsors.partnershipLinkLabel}
                  detailLabel={t.llmGateway.viewDetail}
                  openLabel={t.actions.open}
                  detailHref={linkTo(`/llm-gateway/${site.slug}`)}
                  clickAttrs={gatewaySiteClickAttrs(site)}
                  openAttrs={gatewaySiteOpenAttrs(site)}
                  sticky={isStickyGatewaySite(site)}
                  scoreLabel={t.labels.score}
                  rowAttrs={{
                    'data-home-site-card': '',
                    'data-search': `${site.name} ${site.url} ${site.host} ${site.displayModelFamilies.join(' ')} ${site.paymentMethods.map(paymentLabelFor).join(' ')}`.toLowerCase(),
                    'data-families': families.map(item => item.toLowerCase()).join(','),
                    'data-payments': paymentMethods.join(','),
                    'data-original-order': String(index),
                    'data-sort-sequence': String(rank),
                    'data-sort-name': site.name,
                    'data-sort-score': String(site.siteScore || 0),
                    'data-sort-families': families.join(' '),
                    'data-sort-model-count': String(site.modelCount || 0),
                    'data-sort-payments': paymentMethods.map(paymentLabelFor).join(' '),
                  }}
                >
                  <DataTableCell label={t.llmGateway.supportedModels}>
                    {families.length > 0 ? (
                      <div class="flex flex-wrap gap-1.5">
                        {families.map(family => <span class="badge badge-primary badge-outline badge-sm">{family}</span>)}
                      </div>
                    ) : (
                      <span class="text-base-content/35">-</span>
                    )}
                  </DataTableCell>
                  <DataTableCell label={t.llmGateway.modelCount} align="right" class="font-mono">{site.modelCount > 0 ? site.modelCount : '-'}</DataTableCell>
                  <DataTableCell label={t.llmGateway.paymentMethods}>{paymentMethods.length > 0 ? (
                    <div class="flex flex-wrap gap-1.5">
                      {paymentMethods.map(method => {
                        const icon = paymentIcon(method);
                        const label = paymentLabelFor(method);
                        return <span class="payment-icon" title={label} aria-label={label}>{icon.src ? <img src={icon.src} alt="" loading="lazy" /> : icon.fallback}</span>;
                      })}
                    </div>
                  ) : <span class="text-base-content/35">-</span>}</DataTableCell>
                </GatewaySiteTableRow>
              );
            })}
          </DataTable>
      </div>

      <div id="gatewayModelsPanel" class="flex w-full min-w-0 flex-col gap-0" role="tabpanel" aria-labelledby="gatewayModelsTab" data-gateway-panel="models" hidden>
          <div class="gateway-filter-grid grid gap-3 border-b border-base-300 p-4">
            <label class="input input-bordered flex h-11 items-center gap-2">
              <input data-home-model-search type="search" class="grow text-sm" placeholder={t.llmGateway.modelSearchPlaceholder} />
            </label>
          </div>
          <DataTable
            variant="gatewayModels"
            tbodyDataAttrs={{ 'data-gateway-home-models-list': '' }}
            emptyText={t.llmGateway.filterEmpty}
            emptyDataAttrs={{ 'data-home-model-empty': '' }}
            loadingText={t.labels.loading}
            loadingDataAttrs={{ 'data-gateway-loading': 'models' }}
            summaryText={t.labels.displaySummary}
            summaryRenderedCount={topModels.length}
            summaryDataAttrs={{ 'data-gateway-load-summary': 'models' }}
            totalCount={gatewayModelData.totalModelCount}
            loadMoreText={hasMoreModels ? t.labels.loadMore : ''}
            loadMoreHidden={!hasMoreModels}
            loadMoreDataAttrs={{ 'data-gateway-load-more': 'models' }}
          >
            <Fragment slot="head">
              <DataTableHeader label={t.labels.sequence} sortKey="sequence" sortType="number" align="center" />
              <DataTableHeader label={t.labels.model} sortKey="model" />
              <DataTableHeader label={t.llmGateway.modelFamily} sortKey="family" />
              <DataTableHeader label={t.llmGateway.supportedGatewayCount} sortKey="supportCount" sortType="number" align="right" />
            </Fragment>
            {topModels.map((model, index) => (
              <tr data-home-model-card data-search={`${model.modelId} ${model.modelFamily}`.toLowerCase()} data-original-order={String(index)} data-sort-sequence={String(index + 1)} data-sort-model={model.modelId} data-sort-family={model.modelFamily} data-sort-support-count={String(model.supportSiteCount || 0)}>
                <DataTableCell label={t.labels.sequence} align="center" sequence>{index + 1}</DataTableCell>
                <DataTableCell label={t.labels.model}>
                  <a href={modelHref(model.modelId)} class="link link-hover break-words font-mono text-sm font-semibold text-primary" {...gatewayModelClickAttrs(model)}>{model.modelId}</a>
                </DataTableCell>
                <DataTableCell label={t.llmGateway.modelFamily}>{model.modelFamily}</DataTableCell>
                <DataTableCell label={t.llmGateway.supportedGatewayCount} align="right" class="font-mono">{model.supportSiteCount}</DataTableCell>
              </tr>
            ))}
          </DataTable>
      </div>
    </section>
  )}
  <script is:inline slot="scripts" type="application/json" id="gateway-home-config" set:html={JSON.stringify(gatewayHomeConfig)}></script>
  <script is:inline slot="scripts" src={sponsorBadgeScriptUrl}></script>
  <script is:inline slot="scripts" defer src={dataTableScriptUrl}></script>
  <script>
    import '../scripts/llm-gateway-home.js';
  </script>
</PublicPage>
