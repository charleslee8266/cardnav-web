---
import DataWorkspaceToolbar from '../components/DataWorkspaceToolbar.astro';
import FilterSummary from '../components/FilterSummary.astro';
import { gatewayModelPath } from '../models/routes.js';
import { loadGatewayFamilyFilterOptions, loadModelFamilyCatalog, loadGatewayPaymentFilterOptions, loadGatewayProviderFilterOptions } from '../models/family-catalog-store.js';
import MultiSelectFilter from '../components/MultiSelectFilter.astro';
import { familyRelatedPaths } from '../models/family-navigation.js';
import ProviderLabel from '../components/ProviderLabel.astro';
import ModelFamilyLabel from '../components/ModelFamilyLabel.astro';
import ModelFamilyList from '../components/ModelFamilyList.astro';
import { gatewayProviderSlug } from '../models/routes.js';
/*
文件说明: 渲染 AI 大模型 API 中转站入口页，通过中转站和模型两个标签页展示排行并支持本地加载更多。
*/
import { telemetryBlocks } from '../telemetry-blocks.js';
import { pinSiteRows } from '../site-list-pinning.js';
import FilterPopover from '../components/FilterPopover.astro';
import PageHero from '../components/PageHero.astro';
import RefreshTime from '../components/RefreshTime.astro';
import HeroMetric from '../components/HeroMetric.astro';
import PublicPage from '../layouts/PublicPage.astro';
import GatewaySiteTableRow from '../components/GatewaySiteTableRow.astro';
import DataTable from '../components/DataTable.astro';
import DataTableCell from '../components/DataTableCell.astro';
import DataTableHeader from '../components/DataTableHeader.astro';
import {
  paymentIcon,
  paymentLabel,
  uniqueLabels,
} from '../gateway-display.js';
import { buildSeoContext } from '../seo.js';
import { publicSiteUrl } from '../site.js';
import { loadGatewayModels, loadGatewaySites } from '../store.js';
import Sponsors from '../components/Sponsors.astro';

const t = Astro.locals.messages;
const linkTo = Astro.locals.localizePath;
const GATEWAY_SITE_PAGE_SIZE = 50;
const GATEWAY_MODEL_PAGE_SIZE = 100;
const gatewayData = await loadGatewaySites({ limit: GATEWAY_SITE_PAGE_SIZE });
const gatewayModelData = await loadGatewayModels({ limit: GATEWAY_MODEL_PAGE_SIZE });
const topSites = gatewayData.sites;
const initialPins = new Map<string, string>();
pinSiteRows(topSites.map(site => ({ site, sponsor: Boolean(site.sponsor), supportPoints: site.supportPoints || 0, supportTotalCents: 0, favorite: false })), (row, kind) => initialPins.set(row.site.slug, kind));
const topModels = gatewayModelData.models;
const seo = buildSeoContext({
  baseUrl: publicSiteUrl,
  pathname: '/llm-gateway',
  title: t.llmGateway.seoTitle,
  description: t.llmGateway.seoDescription,
  imagePath: '/og-cardnav.webp',
  type: 'website',
  locale: Astro.locals.locale,
});

const paymentMethodLabels = t.llmGateway.paymentMethodLabels;
const paymentLabelFor = (key: string) => paymentLabel(key, paymentMethodLabels);

function modelHref(modelId: string) {
  return linkTo(gatewayModelPath(modelId));
}

function gatewaySiteClickAttrs(site: { name: string; slug: string; outboundUrl: string }) {
  const targetPage = linkTo(`/llm-gateway/${site.slug}`);
  return {
    'data-umami-event': 'internal-link-click',
    'data-umami-event-link-type': 'gateway-site',
    'data-umami-event-name': site.name,
    'data-umami-event-target-page': targetPage,
    'data-umami-event-url': targetPage,
  };
}

function gatewaySiteOpenAttrs(site: { name: string; outboundUrl: string }) {
  return {
    'data-umami-event': 'external-link-click',
    'data-umami-event-link-type': 'gateway-site-open',
    'data-umami-event-name': site.name,
    'data-umami-event-url': site.outboundUrl,
  };
}

function gatewayModelClickAttrs(model: { modelId: string; modelProvider: string; modelFamily: string | null }) {
  const targetPage = modelHref(model.modelId);
  return {
    'data-umami-event': 'internal-link-click',
    'data-umami-event-link-type': 'gateway-model',
    'data-umami-event-name': model.modelId,
    'data-umami-event-family': model.modelFamily || undefined,
    'data-umami-event-target-page': targetPage,
    'data-umami-event-url': targetPage,
  };
}

function isStickyGatewaySite(site: { sponsor?: boolean }) {
  return Boolean(site.sponsor);
}

const modelFilterOptions = await loadGatewayFamilyFilterOptions();
const familyCatalog = await loadModelFamilyCatalog();
const modelProviderOptions = await loadGatewayProviderFilterOptions();
const paymentFilterOptions = await loadGatewayPaymentFilterOptions();
const hasMoreSites = gatewayData.totalSiteCount > topSites.length;
const hasMoreModels = gatewayModelData.totalModelCount > topModels.length;
const gatewayHomeConfig = {
  familyOrder: familyCatalog.map(({ name }) => gatewayProviderSlug(name)),
  familyLinks: familyCatalog.map(({ name }) => {
    const paths = familyRelatedPaths(name);
    return { family: gatewayProviderSlug(name), name: paths.name,
      shop: paths.shopPath ? linkTo(paths.shopPath) : '', official: paths.officialPath ? linkTo(paths.officialPath) : '',
      leaderboard: paths.leaderboardPath ? linkTo(paths.leaderboardPath) : '' };
  }),
  relatedLabels: [t.officialPrice.shopProductsTip, t.shops.officialPriceTip, t.shops.leaderboardTip],
  locale: Astro.locals.locale,
  gatewayLinkPrefix: linkTo('/llm-gateway'),
  modelLinkPrefix: linkTo('/llm-gateway/models'),
  sitePageSize: GATEWAY_SITE_PAGE_SIZE,
  modelPageSize: GATEWAY_MODEL_PAGE_SIZE,
  siteTotalCount: gatewayData.totalSiteCount,
  modelTotalCount: gatewayModelData.totalModelCount,
  displaySummary: t.labels.displaySummary,
  clearFilters: t.shops.clearFilters,
  dataStatusLabels: t.llmGateway.dataStatusLabels,
  sitesApi: `/api/llm-gateway/sites.json?offset=${GATEWAY_SITE_PAGE_SIZE}&locale=${encodeURIComponent(Astro.locals.locale)}`,
  modelsApi: `/api/llm-gateway/models.json?offset=${GATEWAY_MODEL_PAGE_SIZE}&locale=${encodeURIComponent(Astro.locals.locale)}`,
  detailLabel: t.llmGateway.viewDetail,
  openLabel: t.actions.open,
  sequenceLabel: t.labels.sequence,
  basicInfoLabel: t.llmGateway.basicInfo,
  favoriteLabel: t.shops.merchantFavorite,
  unfavoriteLabel: t.shops.cancelMerchantFavorite,
  supportTotalLabel: t.support.amountColumn,
  supportLabel: t.support.badgeLabel,
  supportDescription: t.support.badgeDescription,
  supportersUrl: linkTo('/supporters?dialog=support'),
  supportLinkLabel: t.support.amountLinkLabel,
  sponsorLabel: t.sponsors.sponsorLabel,
  sponsorDescription: t.sponsors.sponsorDescription,
  partnershipUrl: linkTo('/partnership'),
  partnershipLinkLabel: t.sponsors.partnershipLinkLabel,
  scoreLabel: t.labels.score,
  supportedModelsLabel: t.llmGateway.supportedModels,
  modelCountLabel: t.llmGateway.modelCount,
  paymentMethodsLabel: t.llmGateway.paymentMethods,
  paymentMethodLabels: t.llmGateway.paymentMethodLabels,
  modelLabel: t.labels.model,
  modelFamilyLabel: t.llmGateway.modelFamily,
  modelProviderLabel: t.llmGateway.modelProvider,
  releaseDateLabel: t.llmGateway.releaseDate,
  supportedGatewayCountLabel: t.llmGateway.supportedGatewayCount,
};
---

<PublicPage activeNav="llm-gateway" pageType="gateway" {...seo}>
  <PageHero title={t.llmGateway.title} description={t.llmGateway.heroDescription}>
    <div slot="meta" class="hero-metrics">
      <HeroMetric label={t.llmGateway.listedSites} value={gatewayData.totalSiteCount.toLocaleString(Astro.locals.locale)} />
      <HeroMetric label={t.llmGateway.modelRecords} value={gatewayModelData.totalModelCount.toLocaleString(Astro.locals.locale)} />
      <HeroMetric label={t.labels.latestRefresh}><RefreshTime timestamp={gatewayData.latestRefreshedAt} fallback={t.labels.notRecorded} /></HeroMetric>
    </div>
    <div slot="aside" class="data-page-actions">
      <button data-open-dialog="gateway-submit" type="button" class="btn submit-button btn-sm" data-umami-event="button-click" data-umami-event-action="open-submit" data-umami-event-scope="gateway" data-umami-event-name={t.llmGateway.submitGateway}>
        {t.llmGateway.submitGateway}
      </button>
      <a href="?dialog=support" data-open-support data-telemetry-block={telemetryBlocks.support.entry} class="btn support-button btn-sm"><span aria-hidden="true">♥</span> {t.support.button}</a>
    </div>
  </PageHero>

  <Sponsors placement="after-hero" pageType="gateway" />

  {gatewayData.sites.length === 0 ? (
    <section class="alert alert-warning shadow-sm max-w-md mx-auto my-6 justify-center">
      <span>{t.llmGateway.empty}</span>
    </section>
  ) : (
    <section class="card bg-base-100 border border-base-300 shadow-sm data-workspace" data-gateway-home>
<div class="data-workspace-controls">          <DataWorkspaceToolbar>
          <div class="data-segmented" role="tablist" aria-label={t.llmGateway.title}>
            <button type="button" class="tab tab-active" role="tab" aria-selected="true" aria-controls="gatewaySitesPanel" id="gatewaySitesTab" data-gateway-tab="sites">
              {t.llmGateway.gatewayListTitle}
              <span class="tool-tab-badge">{gatewayData.totalSiteCount}</span>
            </button>
            <button type="button" class="tab" role="tab" aria-selected="false" aria-controls="gatewayModelsPanel" id="gatewayModelsTab" data-gateway-tab="models">
              {t.llmGateway.modelListTitle}
              <span class="tool-tab-badge">{gatewayModelData.totalModelCount}</span>
            </button>
          </div>
            <label data-gateway-control="sites" class="data-workspace-search">
              <input data-home-site-search type="search" class="input input-bordered w-full" placeholder={t.llmGateway.searchPlaceholder} aria-label={t.llmGateway.searchPlaceholder} />
            </label>
            <label data-gateway-control="models" class="data-workspace-search" hidden><input data-home-model-search type="search" class="input input-bordered w-full" placeholder={t.llmGateway.modelSearchPlaceholder} aria-label={t.llmGateway.modelSearchPlaceholder} /></label>
            <div data-gateway-control="sites"><FilterPopover id="gatewaySiteFilters" label={t.shops.filterOptions} doneLabel={t.shops.done} clearLabel={t.shops.clearFilters}>
            <MultiSelectFilter name="family" label={t.llmGateway.familyFilter} allLabel={t.llmGateway.allFamilies} options={modelFilterOptions.map(name => ({ value: gatewayProviderSlug(name), label: name }))}>
              {modelFilterOptions.map(name => <ModelFamilyLabel slot={gatewayProviderSlug(name)} name={name} />)}
            </MultiSelectFilter>
            <MultiSelectFilter name="payment" label={t.llmGateway.paymentFilter} allLabel={t.llmGateway.allPaymentMethods} options={paymentFilterOptions.map(value => ({ value, label: paymentLabelFor(value) }))}>
              {paymentFilterOptions.map(value => <span slot={value} class="data-provider">{paymentIcon(value).src && <img src={paymentIcon(value).src} alt="" width="16" height="16" />}{paymentLabelFor(value)}</span>)}
            </MultiSelectFilter>
            <MultiSelectFilter name="status" label={t.llmGateway.statusFilter} allLabel={t.llmGateway.allStatuses} options={['hasPrice', 'noPrice', 'noData'].map(value => ({ value, label: t.llmGateway.dataStatusLabels[value] }))} />
            <label class="label flex gap-2 text-sm"><input data-home-site-favorites type="checkbox" class="checkbox checkbox-primary checkbox-xs" /><span>{t.shops.onlyFavorites}</span></label>
            </FilterPopover></div>
            <div data-gateway-control="models" hidden><FilterPopover id="gatewayModelFilters" label={t.shops.filterOptions} doneLabel={t.shops.done} clearLabel={t.shops.clearFilters}>
              <MultiSelectFilter name="model-family" label={t.llmGateway.familyFilter} allLabel={t.llmGateway.allFamilies} options={modelFilterOptions.map(name => ({ value: gatewayProviderSlug(name), label: name }))}>
                {modelFilterOptions.map(name => <ModelFamilyLabel slot={gatewayProviderSlug(name)} name={name} />)}
              </MultiSelectFilter>
              <MultiSelectFilter name="model-provider" label={t.llmGateway.providerFilter} allLabel={t.llmGateway.allProviders} options={modelProviderOptions.map(name => ({ value: gatewayProviderSlug(name), label: name }))}>
                {modelProviderOptions.map(name => <ProviderLabel slot={gatewayProviderSlug(name)} name={name} />)}
              </MultiSelectFilter>
            </FilterPopover></div>
          </DataWorkspaceToolbar>
            <FilterSummary data-gateway-control="sites" data-home-site-active-filters class="w-full" clearLabel={t.shops.clearFilters} />
            <FilterSummary data-gateway-control="models" data-home-model-active-filters class="w-full" clearLabel={t.shops.clearFilters} />
            <div data-home-family-links class="data-workspace-related" hidden></div>
</div>
      <div id="gatewaySitesPanel" class="flex w-full min-w-0 flex-col gap-0" role="tabpanel" aria-labelledby="gatewaySitesTab" data-gateway-panel="sites" data-telemetry-block={telemetryBlocks.gateways.sites}>
          <DataTable
            variant="gatewaySites"
            tbodyDataAttrs={{ 'data-gateway-home-sites-list': '' }}
            emptyText={t.llmGateway.filterEmpty}
            emptyDataAttrs={{ 'data-home-site-empty': '' }}
            summaryText={t.labels.displaySummary}
            summaryRenderedCount={topSites.length}
            summaryDataAttrs={{ 'data-gateway-load-summary': 'sites' }}
            totalCount={gatewayData.totalSiteCount}
            loadMoreText={hasMoreSites ? t.labels.loadMore : ''}
            loadMoreHidden={!hasMoreSites}
            loadMoreDataAttrs={{ 'data-gateway-load-more': 'sites' }}
            stickySortKey="sticky"
          >
            <Fragment slot="head">
              <DataTableHeader label={t.labels.sequence} sortKey="sequence" sortType="number" align="center" />
              <DataTableHeader label={t.llmGateway.basicInfo} sortKey="name" />
              <DataTableHeader label={t.labels.score} sortKey="score" sortType="number" align="right" helpTip={t.llmGateway.gatewayScoreTip} helpLabel={t.llmGateway.gatewayScoreHelpLabel} />
              <DataTableHeader label={t.llmGateway.supportedModels} sortKey="families" />
              <DataTableHeader label={t.llmGateway.modelCount} helpTip={t.llmGateway.publicModelSourceHint} sortKey="modelCount" sortType="number" align="right" />
              <DataTableHeader label={t.llmGateway.paymentMethods} sortKey="payments" />
            </Fragment>
            {topSites.map((site, index) => {
              const families = site.displayModelFamilies;
              const paymentMethods = uniqueLabels(site.paymentMethods, 6);
              const rank = index + 1;
              return (
                <GatewaySiteTableRow
                  site={site}
                  sequence={rank}
                  sequenceLabel={t.labels.sequence}
                  basicInfoLabel={t.llmGateway.basicInfo}
                  sponsorLabel={t.sponsors.sponsorLabel}
                  sponsorDescription={t.sponsors.sponsorDescription}
                  sponsorHref={linkTo('/partnership')}
                  sponsorLinkLabel={t.sponsors.partnershipLinkLabel}
                  detailLabel={t.llmGateway.viewDetail}
                  openLabel={t.actions.open}
                  detailHref={linkTo(`/llm-gateway/${site.slug}`)}
                  clickAttrs={gatewaySiteClickAttrs(site)}
                  openAttrs={gatewaySiteOpenAttrs(site)}
                  sticky={isStickyGatewaySite(site)}
                  scoreLabel={t.labels.score}
                  rowAttrs={{
                    'data-home-site-card': '',
                    'data-pin-kind': initialPins.get(site.slug),
                    'data-search': `${site.name} ${site.url} ${site.host} ${site.displayModelProviders.join(' ')} ${site.displayModelFamilies.join(' ')} ${site.paymentMethods.map(paymentLabelFor).join(' ')}`.toLowerCase(),
                    'data-families': site.displayModelFamilies.map(gatewayProviderSlug).join(','),
                    'data-providers': site.displayModelProviders.map(gatewayProviderSlug).join(','),
                    'data-payments': site.paymentMethods.join(','),
                    'data-price-count': String(site.priceCount),
                    'data-original-order': String(index),
                    'data-sort-sequence': String(rank),
                    'data-sort-name': site.name,
                    'data-sort-score': String(site.siteScore || 0),
                    'data-sort-families': families.join(' '),
                    'data-sort-model-count': String(site.modelCount || 0),
                    'data-sort-payments': paymentMethods.map(paymentLabelFor).join(' '),
                  }}
                >
                  <DataTableCell label={t.llmGateway.supportedModels}>
                    <ModelFamilyList selectScope="gateway-sites" families={families} label={t.llmGateway.supportedModels} />
                  </DataTableCell>
                  <DataTableCell label={t.llmGateway.modelCount} align="right" class="font-mono">{site.modelCount > 0 ? site.modelCount : '-'}</DataTableCell>
                  <DataTableCell label={t.llmGateway.paymentMethods}>{paymentMethods.length > 0 ? (
                    <div class="flex flex-wrap gap-1">
                      {paymentMethods.map(method => {
                        const icon = paymentIcon(method);
                        const label = paymentLabelFor(method);
                        return <span class="payment-icon" title={label} aria-label={label}>{icon.src ? <img src={icon.src} alt="" loading="lazy" /> : icon.fallback}</span>;
                      })}
                    </div>
                  ) : <span class="text-base-content/35">-</span>}</DataTableCell>
                </GatewaySiteTableRow>
              );
            })}
          </DataTable>
      </div>

      <div id="gatewayModelsPanel" class="flex w-full min-w-0 flex-col gap-0" role="tabpanel" aria-labelledby="gatewayModelsTab" data-gateway-panel="models" data-telemetry-block={telemetryBlocks.gateways.models} hidden>
          <DataTable
            variant="gatewayModels"
            tbodyDataAttrs={{ 'data-gateway-home-models-list': '' }}
            emptyText={t.llmGateway.filterEmpty}
            emptyDataAttrs={{ 'data-home-model-empty': '' }}
            summaryText={t.labels.displaySummary}
            summaryRenderedCount={topModels.length}
            summaryDataAttrs={{ 'data-gateway-load-summary': 'models' }}
            totalCount={gatewayModelData.totalModelCount}
            loadMoreText={hasMoreModels ? t.labels.loadMore : ''}
            loadMoreHidden={!hasMoreModels}
            loadMoreDataAttrs={{ 'data-gateway-load-more': 'models' }}
          >
            <Fragment slot="head">
              <DataTableHeader label={t.labels.sequence} sortKey="sequence" sortType="number" align="center" />
              <DataTableHeader label={t.labels.model} sortKey="model" />
              <DataTableHeader label={t.llmGateway.modelFamily} sortKey="family" />
              <DataTableHeader label={t.llmGateway.modelProvider} sortKey="provider" />
              <DataTableHeader label={t.llmGateway.releaseDate} sortKey="releaseDate" />
              <DataTableHeader label={t.llmGateway.supportedGatewayCount} sortKey="supportCount" sortType="number" align="right" />
            </Fragment>
            {topModels.map((model, index) => (
              <tr data-home-model-card data-search={`${model.modelId} ${model.modelProvider} ${model.modelFamily || ''}`.toLowerCase()} data-original-order={String(index)} data-sort-sequence={String(index + 1)} data-sort-model={model.modelId} data-sort-family={model.modelFamily || ''} data-sort-provider={model.modelProvider} data-sort-release-date={model.releaseDate || ''} data-sort-support-count={String(model.supportSiteCount || 0)}>
                <DataTableCell label={t.labels.sequence} align="center" sequence>{index + 1}</DataTableCell>
                <DataTableCell label={t.labels.model}>
                  <a data-row-primary href={modelHref(model.modelId)} class="data-row-model-name break-words font-mono text-sm font-semibold" {...gatewayModelClickAttrs(model)}>{model.modelId}</a>
                </DataTableCell>
                <DataTableCell label={t.llmGateway.modelFamily}>{model.modelFamily ? <ModelFamilyLabel selectScope="gateway-models" name={model.modelFamily} /> : "—"}</DataTableCell>
                <DataTableCell label={t.llmGateway.modelProvider}><ProviderLabel selectScope="gateway-models" name={model.modelProvider} /></DataTableCell>
                <DataTableCell label={t.llmGateway.releaseDate} class="whitespace-nowrap font-mono">{model.releaseDate ? <time datetime={model.releaseDate}>{model.releaseDate}</time> : "—"}</DataTableCell>
                <DataTableCell label={t.llmGateway.supportedGatewayCount} align="right" class="font-mono">{model.supportSiteCount}</DataTableCell>
              </tr>
            ))}
          </DataTable>
      </div>
    </section>
  )}
  <script is:inline slot="scripts" type="application/json" id="gateway-home-config" set:html={JSON.stringify(gatewayHomeConfig)}></script>
  <script>
    import '../scripts/data-table.js';
    import '../scripts/llm-gateway-home.js';
  </script>
</PublicPage>
