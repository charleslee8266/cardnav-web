---
/*
文件说明: 渲染官方订阅比价概览，按套餐展示价格最低的三个地区。
*/
import OfficialPriceOverview from '../components/OfficialPriceOverview.astro';
import { localizeOfficialPriceGroups } from '../localized-display.js';
import PublicPage from '../layouts/PublicPage.astro';
import { buildOfficialPriceGroups } from '../official-price.js';
import { buildSeoContext } from '../seo.js';
import { publicSiteUrl } from '../site.js';
import { loadOfficialPriceHighlights, loadOfficialPriceStats } from '../store.js';

const [activePrices, stats] = await Promise.all([loadOfficialPriceHighlights(), loadOfficialPriceStats()]);
const groups = localizeOfficialPriceGroups(buildOfficialPriceGroups(activePrices), Astro.locals.locale);
const latestFetchedAt = activePrices.reduce<string | null>((latest, price) => {
  if (!price.fetchedAt) return latest;
  if (!latest) return price.fetchedAt;
  return new Date(price.fetchedAt).getTime() > new Date(latest).getTime() ? price.fetchedAt : latest;
}, null);

const seo = buildSeoContext({
  baseUrl: publicSiteUrl,
  pathname: '/official-price',
  title: Astro.locals.messages.officialPrice.seoTitle,
  description: Astro.locals.messages.officialPrice.seoDescription,
  imagePath: '/og-cardnav.webp',
  type: 'webpage',
  locale: Astro.locals.locale,
});
---

<PublicPage activeNav="official-price" pageType="official-price" {...seo}>
  <OfficialPriceOverview stats={stats} groups={groups} updatedAt={latestFetchedAt} />
  <script>
    import '../scripts/data-table.js';
  </script>
</PublicPage>
