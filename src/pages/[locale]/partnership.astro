---
/*
文件说明: 渲染带语言前缀的商务合作说明页。
对应文档: docs/promo/cardnav-partner-offer.md
*/
import PublicPage from '../../layouts/PublicPage.astro';
import PartnershipPage from '../../components/PartnershipPage.astro';
import { buildSeoContext } from '../../seo.js';
import { publicSiteUrl } from '../../site.js';
import { defaultLocale, supportedLocales } from '../../i18n/config.js';
import { applyStaticLocaleLocals } from '../../static-locale.js';
import EnglishPartnershipContent, { frontmatter as englishFrontmatter } from '../../../content/pages/en/partnership.mdx';
import RussianPartnershipContent, { frontmatter as russianFrontmatter } from '../../../content/pages/ru/partnership.mdx';

export const prerender = true;

export function getStaticPaths() {
  return supportedLocales
    .filter(locale => locale !== defaultLocale)
    .map(locale => ({
      params: { locale },
      props: { locale },
    }));
}

const locale = Astro.props.locale;
applyStaticLocaleLocals(Astro, locale, `/${locale}/partnership`);

const partnershipContent = locale === 'en' ? EnglishPartnershipContent : RussianPartnershipContent;
const partnershipFrontmatter = locale === 'en' ? englishFrontmatter : russianFrontmatter;
const seo = buildSeoContext({
  baseUrl: publicSiteUrl,
  pathname: `/${locale}/partnership`,
  title: partnershipFrontmatter.title,
  description: partnershipFrontmatter.description,
  imagePath: '/og-cardnav.webp',
  type: 'webpage',
  locale,
});
---

<PublicPage activeNav="partnership" {...seo}>
  <PartnershipPage content={partnershipContent} />
</PublicPage>
