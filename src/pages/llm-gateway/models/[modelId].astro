---
/*
文件说明: 渲染单个 AI 模型的中转站支持详情页，按中转站排序分数展示可用站点。
*/
import PageHero from '../../../components/PageHero.astro';
import GatewaySiteTableRow from '../../../components/GatewaySiteTableRow.astro';
import DataTable from '../../../components/DataTable.astro';
import DataTableCell from '../../../components/DataTableCell.astro';
import { displayPriceUnit, formatPrice } from '../../../gateway-display.js';
import PublicPage from '../../../layouts/PublicPage.astro';
import DataTableHeader from '../../../components/DataTableHeader.astro';
import { buildSeoContext } from '../../../seo.js';
import { isIndexableGatewayModel } from '../../../seo-routes.js';
import { publicSiteUrl } from '../../../site.js';
import { loadGatewayModelDetail } from '../../../store.js';
import deferredTableCoreScriptUrl from '../../../scripts/deferred-table-core.js?url';
import gatewayDetailTablesScriptUrl from '../../../scripts/gateway-detail-tables.js?url';
import dataTableScriptUrl from '../../../scripts/data-table.js?url';
import sponsorBadgeScriptUrl from '../../../scripts/sponsor-badge.js?url';

const t = Astro.locals.messages;
const linkTo = Astro.locals.localizePath;
const rawModelIdParam = Astro.params.modelId || '';
const MODEL_SITE_PAGE_SIZE = 100;
const detail = await loadGatewayModelDetail(rawModelIdParam, { siteLimit: MODEL_SITE_PAGE_SIZE });

if (!detail) return Astro.redirect(Astro.locals.localizePath('/llm-gateway'), 302);

const { model, sites } = detail;
const canonicalModelPath = encodeURIComponent(model.modelId);
if (rawModelIdParam !== model.modelId) return Astro.redirect(Astro.locals.localizePath(`/llm-gateway/models/${canonicalModelPath}`), 301);
const modelSiteTableConfig = {
  type: 'modelSites',
  pageSize: MODEL_SITE_PAGE_SIZE,
  totalCount: model.supportSiteCount,
  apiUrl: `/api/llm-gateway/model-sites/${encodeURIComponent(model.modelId)}.json?offset=${sites.length}&locale=${encodeURIComponent(Astro.locals.locale)}`,
  displaySummary: t.labels.displaySummary,
  gatewayLinkPrefix: linkTo('/llm-gateway'),
  detailLabel: t.llmGateway.viewDetail,
  openLabel: t.actions.open,
  sponsorLabel: t.sponsors.sponsorLabel,
  sponsorDescription: t.sponsors.sponsorDescription,
  partnershipUrl: linkTo('/partnership'),
  partnershipLinkLabel: t.sponsors.partnershipLinkLabel,
  labels: {
    sequence: t.labels.sequence,
    basicInfo: t.llmGateway.basicInfo,
    unit: t.llmGateway.unit,
    inputPrice: t.llmGateway.inputPrice,
    outputPrice: t.llmGateway.outputPrice,
    cacheInputPrice: t.llmGateway.cacheInputPrice,
    cacheOutputPrice: t.llmGateway.cacheOutputPrice,
  },
};

const seo = buildSeoContext({
  baseUrl: publicSiteUrl,
  pathname: `/llm-gateway/models/${canonicalModelPath}`,
  title: t.llmGateway.modelDetailSeoTitle.replace('{model}', model.modelId),
  description: t.llmGateway.modelDetailSeoDescription.replace('{model}', model.modelId),
  imagePath: '/og-cardnav.webp',
  type: 'webpage',
  locale: Astro.locals.locale,
  noindex: !isIndexableGatewayModel(model),
  breadcrumbs: [
    { name: t.nav.llmGateway, pathname: '/llm-gateway' },
    { name: model.modelId, pathname: `/llm-gateway/models/${canonicalModelPath}` },
  ],
});

function firstFinite(values: Array<number | null>) {
  const value = values.find(item => typeof item === 'number' && Number.isFinite(item));
  return typeof value === 'number' ? value : '';
}

function gatewaySiteClickAttrs(site: { name: string; slug: string }) {
  const targetPage = linkTo(`/llm-gateway/${site.slug}`);
  return {
    'data-umami-event': 'gateway-site-click',
    'data-umami-event-name': site.name,
    'data-umami-event-source-model': model.modelId,
    'data-umami-event-target-page': targetPage,
    'data-umami-event-url': targetPage,
  };
}

function gatewaySiteOpenAttrs(site: { name: string; outboundUrl: string }) {
  return {
    'data-umami-event': 'gateway-site-open-click',
    'data-umami-event-name': site.name,
    'data-umami-event-source-model': model.modelId,
    'data-umami-event-url': site.outboundUrl,
  };
}

function isStickyGatewaySite(site: { sponsor?: boolean }) {
  return Boolean(site.sponsor);
}
---

<PublicPage activeNav="llm-gateway" {...seo}>
  <PageHero
    title={t.llmGateway.modelDetailTitle.replace('{model}', model.modelId)}
    description={t.llmGateway.modelDetailDescription}
    backHref="/llm-gateway"
    backLabel={t.llmGateway.backToList}
    titleClass="break-words font-mono"
    copyClass="max-w-4xl"
  >
    <div slot="aside" class="grid grid-cols-1 gap-2 lg:min-w-[180px]">
      <div class="rounded border border-base-300 px-3 py-2">
        <div class="text-[11px] font-semibold uppercase text-base-content/45">{t.llmGateway.supportedGatewayCount}</div>
        <div class="font-mono text-xl font-bold text-primary">{model.supportSiteCount}</div>
      </div>
    </div>
    <div slot="footer" class="mt-4 flex flex-wrap gap-2">
      <span class="badge badge-primary badge-outline">{model.modelFamily}</span>
      {model.latestGatewayRefreshTime ? <span class="badge badge-ghost">{t.labels.latestRefresh}: {model.latestGatewayRefreshTime}</span> : null}
    </div>
  </PageHero>

  <section class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden" data-gateway-deferred-table="modelSites">
    <DataTable
      variant="gatewayModelSites"
      emptyHidden={sites.length > 0}
      emptyText={t.llmGateway.noPriceData}
      totalCount={model.supportSiteCount}
      summaryRenderedCount={sites.length}
      summaryText={t.labels.displaySummary}
      loadMoreText={model.supportSiteCount > sites.length ? t.labels.loadMore : ''}
      loadMoreHidden={model.supportSiteCount <= sites.length}
      loadMoreDataAttrs={{ 'data-gateway-detail-load-more': 'modelSites' }}
      stickySortKey="sticky"
    >
      <Fragment slot="head">
        <DataTableHeader label={t.labels.sequence} sortKey="sequence" sortType="number" align="center" />
        <DataTableHeader label={t.llmGateway.basicInfo} sortKey="name" />
        <DataTableHeader label={t.llmGateway.unit} sortKey="unit" />
        <DataTableHeader label={t.llmGateway.inputPrice} sortKey="inputPrice" sortType="number" align="right" />
        <DataTableHeader label={t.llmGateway.outputPrice} sortKey="outputPrice" sortType="number" align="right" />
        <DataTableHeader label={t.llmGateway.cacheInputPrice} sortKey="cacheInputPrice" sortType="number" align="right" />
        <DataTableHeader label={t.llmGateway.cacheOutputPrice} sortKey="cacheOutputPrice" sortType="number" align="right" />
      </Fragment>
      {sites.map((site, index) => {
        const unitSortValue = site.pricesForModel.map(price => displayPriceUnit(price.unit)).join(' ');
        const inputSortValue = firstFinite(site.pricesForModel.map(price => price.inputPrice));
        const outputSortValue = firstFinite(site.pricesForModel.map(price => price.outputPrice));
        const cacheInputSortValue = firstFinite(site.pricesForModel.map(price => price.cacheInputPrice));
        const cacheOutputSortValue = firstFinite(site.pricesForModel.map(price => price.cacheOutputPrice));
        const rank = index + 1;
        return (
          <GatewaySiteTableRow
            site={site}
            sequence={rank}
            sequenceLabel={t.labels.sequence}
            basicInfoLabel={t.llmGateway.basicInfo}
            sponsorLabel={t.sponsors.sponsorLabel}
            sponsorDescription={t.sponsors.sponsorDescription}
            sponsorHref={linkTo('/partnership')}
            sponsorLinkLabel={t.sponsors.partnershipLinkLabel}
            detailLabel={t.llmGateway.viewDetail}
            openLabel={t.actions.open}
            detailHref={linkTo(`/llm-gateway/${site.slug}`)}
            clickAttrs={gatewaySiteClickAttrs(site)}
            openAttrs={gatewaySiteOpenAttrs(site)}
            sticky={isStickyGatewaySite(site)}
            showScore={false}
            rowAttrs={{
              'data-sort-name': site.name,
              'data-sort-unit': unitSortValue,
              'data-sort-input-price': String(inputSortValue),
              'data-sort-output-price': String(outputSortValue),
              'data-sort-cache-input-price': String(cacheInputSortValue),
              'data-sort-cache-output-price': String(cacheOutputSortValue),
            }}
          >
            <DataTableCell label={t.llmGateway.unit}>
              <div class="space-y-1">
                {site.pricesForModel.length > 0 ? site.pricesForModel.map(price => <div>{displayPriceUnit(price.unit)}</div>) : <span class="text-base-content/35">-</span>}
              </div>
            </DataTableCell>
            <DataTableCell label={t.llmGateway.inputPrice} align="right" class="font-mono">
              <div class="space-y-1">
                {site.pricesForModel.length > 0 ? site.pricesForModel.map(price => <div>{formatPrice(price.inputPrice)}</div>) : <span class="text-base-content/35">-</span>}
              </div>
            </DataTableCell>
            <DataTableCell label={t.llmGateway.outputPrice} align="right" class="font-mono">
              <div class="space-y-1">
                {site.pricesForModel.length > 0 ? site.pricesForModel.map(price => <div>{formatPrice(price.outputPrice)}</div>) : <span class="text-base-content/35">-</span>}
              </div>
            </DataTableCell>
            <DataTableCell label={t.llmGateway.cacheInputPrice} align="right" class="font-mono">
              <div class="space-y-1">
                {site.pricesForModel.length > 0 ? site.pricesForModel.map(price => <div>{formatPrice(price.cacheInputPrice)}</div>) : <span class="text-base-content/35">-</span>}
              </div>
            </DataTableCell>
            <DataTableCell label={t.llmGateway.cacheOutputPrice} align="right" class="font-mono">
              <div class="space-y-1">
                {site.pricesForModel.length > 0 ? site.pricesForModel.map(price => <div>{formatPrice(price.cacheOutputPrice)}</div>) : <span class="text-base-content/35">-</span>}
              </div>
            </DataTableCell>
          </GatewaySiteTableRow>
        );
      })}
    </DataTable>
  </section>
  <script is:inline type="application/json" id="gateway-deferred-table-config" set:html={JSON.stringify(modelSiteTableConfig)}></script>
  <script is:inline slot="scripts" defer src={dataTableScriptUrl}></script>
  <script is:inline slot="scripts" defer src={deferredTableCoreScriptUrl}></script>
  <script is:inline slot="scripts" src={sponsorBadgeScriptUrl}></script>
  <script is:inline slot="scripts" defer src={gatewayDetailTablesScriptUrl}></script>
</PublicPage>
