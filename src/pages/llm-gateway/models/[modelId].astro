---
import DataWorkspaceToolbar from '../../../components/DataWorkspaceToolbar.astro';
import FilterPopover from '../../../components/FilterPopover.astro';
import FilterSummary from '../../../components/FilterSummary.astro';
import '../../../components/data-workspace.css';
import { gatewayFamilyPath } from '../../../models/routes.js';
import { gatewayModelPath, gatewayModelIdFromPathname } from '../../../models/routes.js';
import RefreshTime from '../../../components/RefreshTime.astro';
import ProviderLabel from '../../../components/ProviderLabel.astro';
import ModelFamilyLabel from '../../../components/ModelFamilyLabel.astro';
/*
文件说明: 渲染单个 AI 模型的中转站支持详情页，按可比计价口径展示各站点分组报价。
*/
import { telemetryBlocks } from '../../../telemetry-blocks.js';
import PageHero from '../../../components/PageHero.astro';
import GatewaySiteTableRow from '../../../components/GatewaySiteTableRow.astro';
import DataTable from '../../../components/DataTable.astro';
import DataTableCell from '../../../components/DataTableCell.astro';
import { displayPriceUnit, formatPrice, priceComparisonOptions } from '../../../gateway-display.js';
import PublicPage from '../../../layouts/PublicPage.astro';
import DataTableHeader from '../../../components/DataTableHeader.astro';
import { buildSeoContext } from '../../../seo.js';
import { isIndexableGatewayModel } from '../../../seo-routes.js';
import { publicSiteUrl } from '../../../site.js';
import { loadGatewayModelDetail } from '../../../store.js';
import { MODEL_SITE_MIN_SCORE_OPTIONS, selectModelSiteQuotes } from '../../../model-site-quotes.js';
import Sponsors from '../../../components/Sponsors.astro';

const t = Astro.locals.messages;
const linkTo = Astro.locals.localizePath;
const rawModelIdParam = gatewayModelIdFromPathname(Astro.url.pathname) || '';
const MODEL_SITE_PAGE_SIZE = 50;
const detail = await loadGatewayModelDetail(rawModelIdParam);

if (!detail) return Astro.redirect(Astro.locals.localizePath('/llm-gateway'), 302);

const { model } = detail;
const unitOptions = priceComparisonOptions(detail.sites.flatMap(site => site.pricesForModel));
const requestedUnit = Astro.url.searchParams.get('unit');
const initialUnit = unitOptions.find(([key]) => key === requestedUnit)?.[0] || '';
const initialQuery = (Astro.url.searchParams.get('q') || '').trim();
const initialMinScore = MODEL_SITE_MIN_SCORE_OPTIONS.find(score => String(score) === Astro.url.searchParams.get('minScore'));
const quotes = selectModelSiteQuotes(detail.sites, { query: initialQuery, unit: initialUnit, minScore: initialMinScore }).map(({ site, price, pinKind }) => ({ ...site, pricesForModel: [price], pinKind }));
const sites = quotes.slice(0, MODEL_SITE_PAGE_SIZE);
const canonicalModelPath = gatewayModelPath(model.modelId);
if (rawModelIdParam !== model.modelId) return Astro.redirect(Astro.locals.localizePath(canonicalModelPath) + Astro.url.search, 301);
const modelSiteTableConfig = {
  type: 'modelSites',
  items: detail.sites,
  clearFilters: t.shops.clearFilters,
  groupLabels: t.llmGateway,
  noPriceData: t.llmGateway.noPriceData,
  filterEmpty: t.llmGateway.priceFilterEmpty,
  pageSize: MODEL_SITE_PAGE_SIZE,
  totalCount: model.supportSiteCount,
  displaySummary: t.labels.displaySummary,
  gatewayLinkPrefix: linkTo('/llm-gateway'),
  detailLabel: t.llmGateway.viewDetail,
  openLabel: t.actions.open,
  favoriteLabel: t.shops.merchantFavorite,
  unfavoriteLabel: t.shops.cancelMerchantFavorite,
  supportTotalLabel: t.support.amountColumn,
  supportLabel: t.support.badgeLabel,
  supportDescription: t.support.badgeDescription,
  supportersUrl: linkTo('/supporters?dialog=support'),
  supportLinkLabel: t.support.amountLinkLabel,
  sponsorLabel: t.sponsors.sponsorLabel,
  sponsorDescription: t.sponsors.sponsorDescription,
  partnershipUrl: linkTo('/partnership'),
  partnershipLinkLabel: t.sponsors.partnershipLinkLabel,
  labels: {
    sequence: t.labels.sequence,
    basicInfo: t.llmGateway.basicInfo,
    score: t.labels.score,
    unit: t.llmGateway.unit,
    inputPrice: t.llmGateway.inputPrice,
    outputPrice: t.llmGateway.outputPrice,
    cacheInputPrice: t.llmGateway.cacheInputPrice,
    cacheOutputPrice: t.llmGateway.cacheOutputPrice,
  },
};

const seo = buildSeoContext({
  baseUrl: publicSiteUrl,
  pathname: canonicalModelPath,
  title: t.llmGateway.modelDetailSeoTitle.replace('{model}', model.modelId),
  description: t.llmGateway.modelDetailSeoDescription.replace('{model}', model.modelId),
  imagePath: '/og-cardnav.webp',
  type: 'webpage',
  locale: Astro.locals.locale,
  noindex: !isIndexableGatewayModel(model),
  breadcrumbs: [
    { name: t.nav.llmGateway, pathname: '/llm-gateway' },
    { name: model.modelId, pathname: canonicalModelPath },
  ],
});

function firstFinite(values: Array<number | null>) {
  const value = values.find(item => typeof item === 'number' && Number.isFinite(item));
  return typeof value === 'number' ? value : '';
}

function gatewaySiteClickAttrs(site: { name: string; slug: string }) {
  const targetPage = linkTo(`/llm-gateway/${site.slug}`);
  return {
    'data-umami-event': 'internal-link-click',
    'data-umami-event-link-type': 'gateway-site',
    'data-umami-event-name': site.name,
    'data-umami-event-source-model': model.modelId,
    'data-umami-event-target-page': targetPage,
    'data-umami-event-url': targetPage,
  };
}

function gatewaySiteOpenAttrs(site: { name: string; outboundUrl: string }) {
  return {
    'data-umami-event': 'external-link-click',
    'data-umami-event-link-type': 'gateway-site-open',
    'data-umami-event-name': site.name,
    'data-umami-event-source-model': model.modelId,
    'data-umami-event-url': site.outboundUrl,
  };
}

---

<PublicPage activeNav="llm-gateway" pageType="gateway-model-detail" {...seo}>
  <PageHero
    title={t.llmGateway.modelDetailTitle.replace('{model}', model.modelId)}
    description={t.llmGateway.modelHeroDescription}
    backHref="/llm-gateway"
    backLabel={t.llmGateway.backToList}
    titleClass="break-words font-mono"
    copyClass="max-w-4xl"
  >
    <div slot="aside" class="grid grid-cols-1 gap-2 lg:min-w-[180px]">
      <div class="rounded border border-base-300 px-3 py-2">
        <div class="text-[11px] font-semibold uppercase text-base-content/45">{t.llmGateway.supportedGatewayCount}</div>
        <div class="font-mono text-xl font-bold text-primary">{model.supportSiteCount}</div>
      </div>
    </div>
    <div slot="footer" class="mt-4 flex flex-wrap gap-2">
      <ProviderLabel name={model.modelProvider} />
      {model.modelFamily && <ModelFamilyLabel name={model.modelFamily} href={Astro.locals.localizePath(gatewayFamilyPath(model.modelFamily))} />}
      {model.latestGatewayRefreshAt ? <span>{t.labels.latestRefresh}: <RefreshTime timestamp={model.latestGatewayRefreshAt} /></span> : null}
    </div>
  </PageHero>

  <Sponsors placement="after-hero" pageType="gateway-model-detail" />

  <section class="card bg-base-100 border border-base-300 shadow-sm data-workspace" data-gateway-deferred-table="modelSites" data-telemetry-block={telemetryBlocks.gateways.sites}>
    <div class="data-workspace-controls">
      <DataWorkspaceToolbar>
        <label class="data-workspace-search"><input type="search" data-gateway-detail-search value={initialQuery} class="input input-bordered w-full" placeholder={t.llmGateway.siteQuoteSearchPlaceholder} aria-label={t.llmGateway.siteQuoteSearchPlaceholder} /></label>
      <FilterPopover id="gatewayQuoteFilters" label={t.shops.filterOptions} doneLabel={t.shops.done} clearLabel={t.shops.clearFilters}>
        <label class="data-filter-group"><span class="data-filter-title">{t.llmGateway.unit}</span>
          <select class="select select-bordered" data-quote-unit aria-label={t.llmGateway.unit}>
            <option value="" selected={!initialUnit}>{t.llmGateway.allUnits}</option>
            {unitOptions.map(([key, price]) => <option value={key} selected={key === initialUnit}>{displayPriceUnit(price.unit, price.currency, t.llmGateway)}</option>)}
          </select>
        </label>
        <label class="data-filter-group"><span class="data-filter-title">{t.llmGateway.minimumScore}</span>
          <select class="select select-bordered" data-quote-min-score aria-label={t.llmGateway.minimumScore}>
            <option value="" selected={initialMinScore === undefined}>{t.llmGateway.allScores}</option>
            {MODEL_SITE_MIN_SCORE_OPTIONS.map(score => <option value={score} selected={score === initialMinScore}>{t.llmGateway.scoreAtLeast.replace('{score}', String(score))}</option>)}
          </select>
        </label>
      </FilterPopover>
      </DataWorkspaceToolbar>
      <FilterSummary data-quote-filter-summary class="w-full" clearLabel={t.shops.clearFilters} />
    </div>
    <div>
    <DataTable
      variant="gatewayModelSites"
      emptyHidden={sites.length > 0}
      emptyText={initialQuery || initialUnit || initialMinScore !== undefined ? t.llmGateway.priceFilterEmpty : t.llmGateway.noPriceData}
      totalCount={quotes.length}
      summaryRenderedCount={sites.length}
      summaryText={t.labels.displaySummary}
      loadMoreText={t.labels.loadMore}
      loadMoreHidden={false}
      loadMoreDataAttrs={{ 'data-gateway-detail-load-more': 'modelSites' }}
    >
      <Fragment slot="head">
        <DataTableHeader label={t.labels.sequence} sortKey="sequence" sortType="number" align="center" />
        <DataTableHeader label={t.llmGateway.basicInfo} sortKey="name" />
        <DataTableHeader label={t.labels.score} helpTip={t.llmGateway.gatewayScoreTip} helpLabel={t.llmGateway.gatewayScoreHelpLabel} sortKey="score" sortType="number" align="right" />
        <DataTableHeader label={t.llmGateway.group} sortKey="group" />
        <DataTableHeader label={t.llmGateway.unit} sortKey="unit" />
        <DataTableHeader label={t.llmGateway.inputPrice} helpTip={t.llmGateway.publicPriceSourceHint} sortKey="inputPrice" sortType="number" align="right" />
        <DataTableHeader label={t.llmGateway.outputPrice} helpTip={t.llmGateway.publicPriceSourceHint} sortKey="outputPrice" sortType="number" align="right" />
        <DataTableHeader label={t.llmGateway.cacheInputPrice} helpTip={t.llmGateway.publicPriceSourceHint} sortKey="cacheInputPrice" sortType="number" align="right" />
        <DataTableHeader label={t.llmGateway.cacheOutputPrice} helpTip={t.llmGateway.publicPriceSourceHint} sortKey="cacheOutputPrice" sortType="number" align="right" />
      </Fragment>
      {sites.map((site, index) => {
        const unitSortValue = site.pricesForModel.map(price => displayPriceUnit(price.unit, price.currency, t.llmGateway)).join(' ');
        const inputSortValue = firstFinite(site.pricesForModel.map(price => price.inputPrice));
        const outputSortValue = firstFinite(site.pricesForModel.map(price => price.outputPrice));
        const cacheInputSortValue = firstFinite(site.pricesForModel.map(price => price.cacheInputPrice));
        const cacheOutputSortValue = firstFinite(site.pricesForModel.map(price => price.cacheOutputPrice));
        const rank = index + 1;
        return (
          <GatewaySiteTableRow
            site={site}
            sequence={rank}
            sequenceLabel={t.labels.sequence}
            basicInfoLabel={t.llmGateway.basicInfo}
            sponsorLabel={t.sponsors.sponsorLabel}
            sponsorDescription={t.sponsors.sponsorDescription}
            sponsorHref={linkTo('/partnership')}
            sponsorLinkLabel={t.sponsors.partnershipLinkLabel}
            detailLabel={t.llmGateway.viewDetail}
            openLabel={t.actions.open}
            detailHref={linkTo(`/llm-gateway/${site.slug}`)}
            clickAttrs={gatewaySiteClickAttrs(site)}
            openAttrs={gatewaySiteOpenAttrs(site)}
            scoreLabel={t.labels.score}
            rowAttrs={{
              'data-pin-kind': site.pinKind,
              'data-sort-name': site.name,
              'data-sort-score': site.siteScore ?? '',
              'data-sort-group': site.pricesForModel[0]?.groupName || '',
              'data-sort-unit': unitSortValue,
              'data-sort-input-price': String(inputSortValue),
              'data-sort-output-price': String(outputSortValue),
              'data-sort-cache-input-price': String(cacheInputSortValue),
              'data-sort-cache-output-price': String(cacheOutputSortValue),
            }}
          >
            <DataTableCell label={t.llmGateway.group}>
              <span class="inline-flex items-center gap-1">{site.pricesForModel[0]?.groupName || '—'}
                {site.pricesForModel[0]?.groupDescription && <button type="button" class="inline-help-button" data-inline-help aria-label={t.llmGateway.groupDescription}><template data-tip-content><span class="whitespace-pre-wrap">{t.llmGateway.siteNotePrefix}{site.pricesForModel[0].groupDescription}</span></template>i</button>}
              </span>
            </DataTableCell>
            <DataTableCell label={t.llmGateway.unit}>
              <div class="space-y-1">
                {site.pricesForModel.length > 0 ? site.pricesForModel.map(price => <div>{displayPriceUnit(price.unit, price.currency, t.llmGateway)}</div>) : <span class="text-base-content/35">-</span>}
              </div>
            </DataTableCell>
            <DataTableCell label={t.llmGateway.inputPrice} align="right" class="font-mono">
              <div class="space-y-1">
                {site.pricesForModel.length > 0 ? site.pricesForModel.map(price => <div>{formatPrice(price.inputPrice)}</div>) : <span class="text-base-content/35">-</span>}
              </div>
            </DataTableCell>
            <DataTableCell label={t.llmGateway.outputPrice} align="right" class="font-mono">
              <div class="space-y-1">
                {site.pricesForModel.length > 0 ? site.pricesForModel.map(price => <div>{formatPrice(price.outputPrice)}</div>) : <span class="text-base-content/35">-</span>}
              </div>
            </DataTableCell>
            <DataTableCell label={t.llmGateway.cacheInputPrice} align="right" class="font-mono">
              <div class="space-y-1">
                {site.pricesForModel.length > 0 ? site.pricesForModel.map(price => <div>{formatPrice(price.cacheInputPrice)}</div>) : <span class="text-base-content/35">-</span>}
              </div>
            </DataTableCell>
            <DataTableCell label={t.llmGateway.cacheOutputPrice} align="right" class="font-mono">
              <div class="space-y-1">
                {site.pricesForModel.length > 0 ? site.pricesForModel.map(price => <div>{formatPrice(price.cacheOutputPrice)}</div>) : <span class="text-base-content/35">-</span>}
              </div>
            </DataTableCell>
          </GatewaySiteTableRow>
        );
      })}
    </DataTable>
    </div>
  </section>
  <script is:inline type="application/json" id="gateway-deferred-table-config" set:html={JSON.stringify(modelSiteTableConfig).replaceAll('<', '\\u003c')}></script>
  <script>
    import '../../../scripts/data-table.js';
    import '../../../scripts/gateway-detail-tables.js';
  </script>
</PublicPage>
