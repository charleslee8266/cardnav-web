---
/*
文件说明: 展示已到账的个人、卡网及中转站累计赞赏名单，并提供统一赞赏入口。
*/
import { loadSupportLeaderboard } from '../support/SupportStore.js';
import SupportDialog from '../components/SupportDialog.astro';
import PageHero from '../components/PageHero.astro';
import PublicPage from '../layouts/PublicPage.astro';
import DataTable from '../components/DataTable.astro';
import DataTableCell from '../components/DataTableCell.astro';
import DataTableHeader from '../components/DataTableHeader.astro';
import pageWidgetsScriptUrl from '../scripts/page-widgets.js?url';
import { buildSeoContext } from '../seo.js';
import { publicSiteUrl } from '../site.js';
import { telemetryBlocks } from '../telemetry-blocks.js';

const messages = Astro.locals.messages;
const t = messages.support;
const allSupporters = await loadSupportLeaderboard();
const identityQuery = new URL(Astro.request.url).searchParams.get('identity');
const activeIdentity = ['person', 'shop', 'gateway'].includes(identityQuery || '') ? identityQuery : 'all';
const supporters = activeIdentity === 'all' ? allSupporters : allSupporters.filter(supporter => supporter.kind === activeIdentity);
const identities = { person: t.person, gateway: t.gatewayIdentity, shop: t.shopIdentity };
const seo = buildSeoContext({
  baseUrl: publicSiteUrl,
  pathname: '/supporters',
  title: t.seoTitle,
  description: t.seoDescription,
  imagePath: '/og-cardnav.webp',
  type: 'webpage',
  locale: Astro.locals.locale,
  noindex: new URL(Astro.request.url).search.length > 0,
});
---
<PublicPage activeNav="supporters" pageType="supporters" {...seo}>
  <PageHero title={t.listTitle} description={t.listHeroDescription}>
    <a slot="aside" href="?support-dialog" data-open-support data-telemetry-block={telemetryBlocks.support.entry} class="btn support-button"><span aria-hidden="true">♥</span> {t.button}</a>
  </PageHero>
  <section class="supporters-table-card card overflow-hidden border border-base-300 bg-base-100">
  <nav class="supporter-filters" aria-label={t.identity}>
    {(['all', 'person', 'shop', 'gateway'] as const).map(kind => <a href={Astro.locals.localizePath(`/supporters${kind === 'all' ? '' : `?identity=${kind}`}`)} class:list={['btn btn-sm', activeIdentity === kind ? 'support-button' : 'btn-ghost']} aria-current={activeIdentity === kind ? 'page' : undefined} data-umami-event="internal-link-click" data-umami-event-link-type="supporter-filter" data-umami-event-url={Astro.locals.localizePath(`/supporters${kind === 'all' ? '' : `?identity=${kind}`}`)}>
      {kind === 'all' ? t.all : identities[kind]}<span class="supporter-filter-count">{kind === 'all' ? allSupporters.length : allSupporters.filter(supporter => supporter.kind === kind).length}</span>
    </a>)}
    <a class="supporter-rules" href={Astro.locals.localizePath('/partnership')}>{t.viewRules} ↗</a>
  </nav>
  {supporters.length > 0 ? (
      <DataTable variant="gatewaySites">
        <Fragment slot="head">
          <DataTableHeader label={messages.labels.sequence} sortKey="sequence" sortType="number" align="center" />
          <DataTableHeader label={t.userColumn} sortKey="user" />
          <DataTableHeader label={t.identityColumn} sortKey="identity" />
          <DataTableHeader label={t.messageColumn} sortKey="message" />
          <DataTableHeader label={t.total} sortKey="total" sortType="number" align="right" />
          <DataTableHeader
            label={t.amountColumn}
            sortKey="support"
            sortType="number"
            align="right"
            helpTip={t.pointsRuleTip}
            helpLabel={t.amountHelpLabel}
            helpHref={Astro.locals.localizePath('/partnership')}
            helpLinkLabel={t.pointsRuleLinkLabel}
          />
        </Fragment>
        {supporters.map((supporter, index) => {
          const sequence = index + 1;
          const name = supporter.name || t.anonymous;
          const identity = identities[supporter.kind];
          const message = supporter.message || '';
          const total = supporter.amountCents / 100;
          const supportPoints = supporter.kind === 'person' ? 0 : supporter.supportPoints;
          return (
            <tr
              data-sort-sequence={String(sequence)}
              data-sort-user={name}
              data-sort-identity={identity}
              data-sort-message={message}
              data-sort-total={String(total)}
              data-sort-support={String(supportPoints)}
            >
              <DataTableCell label={messages.labels.sequence} align="center" sequence>{sequence}</DataTableCell>
              <DataTableCell label={t.userColumn}>
                {supporter.url ? <a href={supporter.url} target="_blank" rel="sponsored noopener noreferrer" class="link link-hover break-words font-semibold text-primary">{name}</a> : <span class="font-semibold">{name}</span>}
              </DataTableCell>
              <DataTableCell label={t.identityColumn}><span class="badge badge-ghost badge-sm">{identity}</span></DataTableCell>
              <DataTableCell label={t.messageColumn}>{message || <span class="text-base-content/35">-</span>}</DataTableCell>
              <DataTableCell label={t.total} align="right" class="font-bold font-mono text-primary">¥{total.toLocaleString(Astro.locals.locale)}</DataTableCell>
              <DataTableCell label={t.amountColumn} align="right" class="font-mono">{supporter.kind === 'person' ? '-' : supporter.supportPoints.toLocaleString(Astro.locals.locale, { maximumFractionDigits: 2 })}</DataTableCell>
            </tr>
          );
        })}
      </DataTable>
  ) : <p class="support-list-empty">{t.listEmpty}</p>}
  </section>
  <SupportDialog returnPage="supporters" />
  <script>
    import '../scripts/data-table.js';
  </script>
  <script is:inline slot="scripts" defer src={pageWidgetsScriptUrl}></script>
</PublicPage>

<style>
  .supporter-filters { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; padding: 12px 16px; border-bottom: 1px solid var(--color-base-300); background: var(--color-base-100); }
  .supporter-filter-count { font-size: 11px; font-variant-numeric: tabular-nums; opacity: .8; }
  .supporter-rules { margin-left: auto; padding: 6px 8px; color: var(--merchant-partner-text); font-size: 12px; }
  .supporters-table-card { border-radius: 14px; box-shadow: var(--shadow-1); }
  .supporters-table-card .support-list-empty { border: 0; }
</style>
