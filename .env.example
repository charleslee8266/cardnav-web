# 文件说明: CardNav 公开站环境变量模板。复制为 .env.development、.env.staging 或 .env.production 后填写真实值。

# ===== Database =====
DATABASE_URL=postgres://postgres:cardnav@localhost:5432/cardnav

# ===== Public Web =====
PORT=3101
PUBLIC_SITE_URL=https://cardnav.xyz
HEADER_AD_TAG_ENABLED=

# ===== Reputation Data =====
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=

# ===== Support Payments =====
# 易支付商户 PID、商户密钥和 HTTPS API 基础地址；留空时无法发起支付。
EASYPAY_PID=
EASYPAY_PKEY=
EASYPAY_API_URL=
# 异步通知使用 GET：PUBLIC_SITE_URL + /api/support/notify
# PUBLIC_SITE_URL 必须为 HTTPS 站点根地址，不能含用户名、密码、路径或查询参数。

# ===== Support Cache Publication =====
# 到账后清理该域名的页面缓存；API Token 只需对应 Zone 的 Cache Purge 权限。
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
